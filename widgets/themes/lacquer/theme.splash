mod.theme = mod.themes.dark

// Candy-red lacquer, deep and glossy, with chrome knobs and strong
// reflections.
// A starter: a sober palette on the dark base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #2a0e10
mod.theme.color_fg_app = #2a0e10
mod.theme.color_bg_container = #2a0e10
mod.theme.color_surface_container_lowest = #1c0809

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #3b1518
mod.theme.color_outset_1 = #3b1518
mod.theme.color_outset_2 = #3b1518
mod.theme.color_outset_hover = #461b1f
mod.theme.color_outset_1_hover = #461b1f
mod.theme.color_outset_2_hover = #461b1f
mod.theme.color_outset_down = #321215
mod.theme.color_outset_1_down = #321215
mod.theme.color_outset_2_down = #321215
mod.theme.color_outset_disabled = #2a0e10
mod.theme.color_outset_1_disabled = #2a0e10
mod.theme.color_outset_2_disabled = #2a0e10

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #1c0809
mod.theme.color_inset_1 = #1c0809
mod.theme.color_inset_2 = #1c0809
mod.theme.color_inset_hover = #160607
mod.theme.color_inset_1_hover = #160607
mod.theme.color_inset_2_hover = #160607
mod.theme.color_inset_focus = #160607
mod.theme.color_inset_1_focus = #160607
mod.theme.color_inset_2_focus = #160607
mod.theme.color_inset_active = #160607
mod.theme.color_inset_1_active = #160607
mod.theme.color_inset_2_active = #160607
mod.theme.color_inset_down = #160607
mod.theme.color_inset_1_down = #160607
mod.theme.color_inset_2_down = #160607
mod.theme.color_inset_drag = #1c0809
mod.theme.color_inset_1_drag = #1c0809
mod.theme.color_inset_2_drag = #1c0809
mod.theme.color_inset_empty = #1c0809
mod.theme.color_inset_1_empty = #1c0809
mod.theme.color_inset_2_empty = #1c0809
mod.theme.color_inset_disabled = #2a0e10
mod.theme.color_inset_1_disabled = #2a0e10
mod.theme.color_inset_2_disabled = #2a0e10

// One hairline edge on every face and well.
mod.theme.color_bevel = #6e2c30
mod.theme.color_bevel_inset_1 = #6e2c30
mod.theme.color_bevel_inset_2 = #6e2c30
mod.theme.color_bevel_outset_1 = #6e2c30
mod.theme.color_bevel_outset_2 = #6e2c30
mod.theme.beveling = 0.5

mod.theme.color_text = #f7e6e4
mod.theme.color_label = #f7e6e4
mod.theme.color_label_inner = #f7e6e4
mod.theme.color_label_outer = #f7e6e4
mod.theme.color_icon = #f7e6e4
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #ff7a68
mod.theme.color_focus = #ff7a68
mod.theme.color_ctrl_active = #ff7a68
mod.theme.color_val = #ff7a68

mod.theme.color_terminal_bg = #1c0809
mod.theme.color_terminal_text = #f7e6e4

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 3.0
mod.theme.container_corner_radius = 6.0
true

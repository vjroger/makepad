mod.theme = mod.themes.light

// A segment display on a pale glass.
// A starter: a sober palette on the light base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #c9d3b8
mod.theme.color_fg_app = #c9d3b8
mod.theme.color_bg_container = #c9d3b8
mod.theme.color_surface_container_lowest = #bcc7a9

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #d3dcc3
mod.theme.color_outset_1 = #d3dcc3
mod.theme.color_outset_2 = #d3dcc3
mod.theme.color_outset_hover = #dae2cb
mod.theme.color_outset_1_hover = #dae2cb
mod.theme.color_outset_2_hover = #dae2cb
mod.theme.color_outset_down = #c1cbae
mod.theme.color_outset_1_down = #c1cbae
mod.theme.color_outset_2_down = #c1cbae
mod.theme.color_outset_disabled = #c9d3b8
mod.theme.color_outset_1_disabled = #c9d3b8
mod.theme.color_outset_2_disabled = #c9d3b8

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #bcc7a9
mod.theme.color_inset_1 = #bcc7a9
mod.theme.color_inset_2 = #bcc7a9
mod.theme.color_inset_hover = #b6c1a2
mod.theme.color_inset_1_hover = #b6c1a2
mod.theme.color_inset_2_hover = #b6c1a2
mod.theme.color_inset_focus = #b6c1a2
mod.theme.color_inset_1_focus = #b6c1a2
mod.theme.color_inset_2_focus = #b6c1a2
mod.theme.color_inset_active = #b6c1a2
mod.theme.color_inset_1_active = #b6c1a2
mod.theme.color_inset_2_active = #b6c1a2
mod.theme.color_inset_down = #b6c1a2
mod.theme.color_inset_1_down = #b6c1a2
mod.theme.color_inset_2_down = #b6c1a2
mod.theme.color_inset_drag = #bcc7a9
mod.theme.color_inset_1_drag = #bcc7a9
mod.theme.color_inset_2_drag = #bcc7a9
mod.theme.color_inset_empty = #bcc7a9
mod.theme.color_inset_1_empty = #bcc7a9
mod.theme.color_inset_2_empty = #bcc7a9
mod.theme.color_inset_disabled = #c9d3b8
mod.theme.color_inset_1_disabled = #c9d3b8
mod.theme.color_inset_2_disabled = #c9d3b8

// One hairline edge on every face and well.
mod.theme.color_bevel = #8a957a
mod.theme.color_bevel_inset_1 = #8a957a
mod.theme.color_bevel_inset_2 = #8a957a
mod.theme.color_bevel_outset_1 = #8a957a
mod.theme.color_bevel_outset_2 = #8a957a
mod.theme.beveling = 0.5

mod.theme.color_text = #1e2618
mod.theme.color_label = #1e2618
mod.theme.color_label_inner = #1e2618
mod.theme.color_label_outer = #1e2618
mod.theme.color_icon = #1e2618
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #245a8d
mod.theme.color_focus = #245a8d
mod.theme.color_ctrl_active = #245a8d
mod.theme.color_val = #245a8d

mod.theme.color_terminal_bg = #1e2618
mod.theme.color_terminal_text = #c9d3b8

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 0.0
mod.theme.container_corner_radius = 0.0
true

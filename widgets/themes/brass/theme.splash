mod.theme = mod.themes.dark

// Steampunk brass: polished fittings, gears and pipes over dark wood,
// parchment for the text.
// A starter: a sober palette on the dark base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #2a2116
mod.theme.color_fg_app = #2a2116
mod.theme.color_bg_container = #2a2116
mod.theme.color_surface_container_lowest = #1d170f

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #3a2e1f
mod.theme.color_outset_1 = #3a2e1f
mod.theme.color_outset_2 = #3a2e1f
mod.theme.color_outset_hover = #443626
mod.theme.color_outset_1_hover = #443626
mod.theme.color_outset_2_hover = #443626
mod.theme.color_outset_down = #32281a
mod.theme.color_outset_1_down = #32281a
mod.theme.color_outset_2_down = #32281a
mod.theme.color_outset_disabled = #2a2116
mod.theme.color_outset_1_disabled = #2a2116
mod.theme.color_outset_2_disabled = #2a2116

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #1d170f
mod.theme.color_inset_1 = #1d170f
mod.theme.color_inset_2 = #1d170f
mod.theme.color_inset_hover = #18130c
mod.theme.color_inset_1_hover = #18130c
mod.theme.color_inset_2_hover = #18130c
mod.theme.color_inset_focus = #18130c
mod.theme.color_inset_1_focus = #18130c
mod.theme.color_inset_2_focus = #18130c
mod.theme.color_inset_active = #18130c
mod.theme.color_inset_1_active = #18130c
mod.theme.color_inset_2_active = #18130c
mod.theme.color_inset_down = #18130c
mod.theme.color_inset_1_down = #18130c
mod.theme.color_inset_2_down = #18130c
mod.theme.color_inset_drag = #1d170f
mod.theme.color_inset_1_drag = #1d170f
mod.theme.color_inset_2_drag = #1d170f
mod.theme.color_inset_empty = #1d170f
mod.theme.color_inset_1_empty = #1d170f
mod.theme.color_inset_2_empty = #1d170f
mod.theme.color_inset_disabled = #2a2116
mod.theme.color_inset_1_disabled = #2a2116
mod.theme.color_inset_2_disabled = #2a2116

// One hairline edge on every face and well.
mod.theme.color_bevel = #7a5f36
mod.theme.color_bevel_inset_1 = #7a5f36
mod.theme.color_bevel_inset_2 = #7a5f36
mod.theme.color_bevel_outset_1 = #7a5f36
mod.theme.color_bevel_outset_2 = #7a5f36
mod.theme.beveling = 0.5

mod.theme.color_text = #f3e6c8
mod.theme.color_label = #f3e6c8
mod.theme.color_label_inner = #f3e6c8
mod.theme.color_label_outer = #f3e6c8
mod.theme.color_icon = #f3e6c8
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #dcaa48
mod.theme.color_focus = #dcaa48
mod.theme.color_ctrl_active = #dcaa48
mod.theme.color_val = #dcaa48

mod.theme.color_terminal_bg = #1d170f
mod.theme.color_terminal_text = #f3e6c8

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 3.0
mod.theme.container_corner_radius = 6.0
true

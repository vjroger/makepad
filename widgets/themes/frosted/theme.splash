mod.theme = mod.themes.dark

// Frosted glass cards over a dark ground.
// A starter: a sober palette on the dark base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #1d2430
mod.theme.color_fg_app = #1d2430
mod.theme.color_bg_container = #1d2430
mod.theme.color_surface_container_lowest = #171d27

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #28303d
mod.theme.color_outset_1 = #28303d
mod.theme.color_outset_2 = #28303d
mod.theme.color_outset_hover = #2e3746
mod.theme.color_outset_1_hover = #2e3746
mod.theme.color_outset_2_hover = #2e3746
mod.theme.color_outset_down = #232a36
mod.theme.color_outset_1_down = #232a36
mod.theme.color_outset_2_down = #232a36
mod.theme.color_outset_disabled = #1d2430
mod.theme.color_outset_1_disabled = #1d2430
mod.theme.color_outset_2_disabled = #1d2430

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #171d27
mod.theme.color_inset_1 = #171d27
mod.theme.color_inset_2 = #171d27
mod.theme.color_inset_hover = #141a23
mod.theme.color_inset_1_hover = #141a23
mod.theme.color_inset_2_hover = #141a23
mod.theme.color_inset_focus = #141a23
mod.theme.color_inset_1_focus = #141a23
mod.theme.color_inset_2_focus = #141a23
mod.theme.color_inset_active = #141a23
mod.theme.color_inset_1_active = #141a23
mod.theme.color_inset_2_active = #141a23
mod.theme.color_inset_down = #141a23
mod.theme.color_inset_1_down = #141a23
mod.theme.color_inset_2_down = #141a23
mod.theme.color_inset_drag = #171d27
mod.theme.color_inset_1_drag = #171d27
mod.theme.color_inset_2_drag = #171d27
mod.theme.color_inset_empty = #171d27
mod.theme.color_inset_1_empty = #171d27
mod.theme.color_inset_2_empty = #171d27
mod.theme.color_inset_disabled = #1d2430
mod.theme.color_inset_1_disabled = #1d2430
mod.theme.color_inset_2_disabled = #1d2430

// One hairline edge on every face and well.
mod.theme.color_bevel = #3d4757
mod.theme.color_bevel_inset_1 = #3d4757
mod.theme.color_bevel_inset_2 = #3d4757
mod.theme.color_bevel_outset_1 = #3d4757
mod.theme.color_bevel_outset_2 = #3d4757
mod.theme.beveling = 0.5

mod.theme.color_text = #e3e8f0
mod.theme.color_label = #e3e8f0
mod.theme.color_label_inner = #e3e8f0
mod.theme.color_label_outer = #e3e8f0
mod.theme.color_icon = #e3e8f0
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #7fb4ff
mod.theme.color_focus = #7fb4ff
mod.theme.color_ctrl_active = #7fb4ff
mod.theme.color_val = #7fb4ff

mod.theme.color_terminal_bg = #171d27
mod.theme.color_terminal_text = #e3e8f0

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 3.0
mod.theme.container_corner_radius = 6.0
true

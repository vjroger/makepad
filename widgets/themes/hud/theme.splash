mod.theme = mod.themes.dark

// Line frames of a head-up display over a dark ground.
// A starter: a sober palette on the dark base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #071114
mod.theme.color_fg_app = #071114
mod.theme.color_bg_container = #071114
mod.theme.color_surface_container_lowest = #040b0d

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #0c1b20
mod.theme.color_outset_1 = #0c1b20
mod.theme.color_outset_2 = #0c1b20
mod.theme.color_outset_hover = #102328
mod.theme.color_outset_1_hover = #102328
mod.theme.color_outset_2_hover = #102328
mod.theme.color_outset_down = #09161a
mod.theme.color_outset_1_down = #09161a
mod.theme.color_outset_2_down = #09161a
mod.theme.color_outset_disabled = #071114
mod.theme.color_outset_1_disabled = #071114
mod.theme.color_outset_2_disabled = #071114

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #040b0d
mod.theme.color_inset_1 = #040b0d
mod.theme.color_inset_2 = #040b0d
mod.theme.color_inset_hover = #03090a
mod.theme.color_inset_1_hover = #03090a
mod.theme.color_inset_2_hover = #03090a
mod.theme.color_inset_focus = #03090a
mod.theme.color_inset_1_focus = #03090a
mod.theme.color_inset_2_focus = #03090a
mod.theme.color_inset_active = #03090a
mod.theme.color_inset_1_active = #03090a
mod.theme.color_inset_2_active = #03090a
mod.theme.color_inset_down = #03090a
mod.theme.color_inset_1_down = #03090a
mod.theme.color_inset_2_down = #03090a
mod.theme.color_inset_drag = #040b0d
mod.theme.color_inset_1_drag = #040b0d
mod.theme.color_inset_2_drag = #040b0d
mod.theme.color_inset_empty = #040b0d
mod.theme.color_inset_1_empty = #040b0d
mod.theme.color_inset_2_empty = #040b0d
mod.theme.color_inset_disabled = #071114
mod.theme.color_inset_1_disabled = #071114
mod.theme.color_inset_2_disabled = #071114

// One hairline edge on every face and well.
mod.theme.color_bevel = #1d3d44
mod.theme.color_bevel_inset_1 = #1d3d44
mod.theme.color_bevel_inset_2 = #1d3d44
mod.theme.color_bevel_outset_1 = #1d3d44
mod.theme.color_bevel_outset_2 = #1d3d44
mod.theme.beveling = 0.5

mod.theme.color_text = #bfeff5
mod.theme.color_label = #bfeff5
mod.theme.color_label_inner = #bfeff5
mod.theme.color_label_outer = #bfeff5
mod.theme.color_icon = #bfeff5
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #3fd8ea
mod.theme.color_focus = #3fd8ea
mod.theme.color_ctrl_active = #3fd8ea
mod.theme.color_val = #3fd8ea

mod.theme.color_terminal_bg = #040b0d
mod.theme.color_terminal_text = #bfeff5

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 0.0
mod.theme.container_corner_radius = 0.0
true

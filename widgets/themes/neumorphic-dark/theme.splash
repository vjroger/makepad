mod.theme = mod.themes.dark

// Neumorphic, dark appearance: soft moulded surfaces on one charcoal ground.
// A starter: a sober palette on the dark base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #2a2d33
mod.theme.color_fg_app = #2a2d33
mod.theme.color_bg_container = #2a2d33
mod.theme.color_surface_container_lowest = #23262b

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #2f3239
mod.theme.color_outset_1 = #2f3239
mod.theme.color_outset_2 = #2f3239
mod.theme.color_outset_hover = #34373e
mod.theme.color_outset_1_hover = #34373e
mod.theme.color_outset_2_hover = #34373e
mod.theme.color_outset_down = #26292e
mod.theme.color_outset_1_down = #26292e
mod.theme.color_outset_2_down = #26292e
mod.theme.color_outset_disabled = #2a2d33
mod.theme.color_outset_1_disabled = #2a2d33
mod.theme.color_outset_2_disabled = #2a2d33

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #23262b
mod.theme.color_inset_1 = #23262b
mod.theme.color_inset_2 = #23262b
mod.theme.color_inset_hover = #1f2226
mod.theme.color_inset_1_hover = #1f2226
mod.theme.color_inset_2_hover = #1f2226
mod.theme.color_inset_focus = #1f2226
mod.theme.color_inset_1_focus = #1f2226
mod.theme.color_inset_2_focus = #1f2226
mod.theme.color_inset_active = #1f2226
mod.theme.color_inset_1_active = #1f2226
mod.theme.color_inset_2_active = #1f2226
mod.theme.color_inset_down = #1f2226
mod.theme.color_inset_1_down = #1f2226
mod.theme.color_inset_2_down = #1f2226
mod.theme.color_inset_drag = #23262b
mod.theme.color_inset_1_drag = #23262b
mod.theme.color_inset_2_drag = #23262b
mod.theme.color_inset_empty = #23262b
mod.theme.color_inset_1_empty = #23262b
mod.theme.color_inset_2_empty = #23262b
mod.theme.color_inset_disabled = #2a2d33
mod.theme.color_inset_1_disabled = #2a2d33
mod.theme.color_inset_2_disabled = #2a2d33

// One hairline edge on every face and well.
mod.theme.color_bevel = #3c4048
mod.theme.color_bevel_inset_1 = #3c4048
mod.theme.color_bevel_inset_2 = #3c4048
mod.theme.color_bevel_outset_1 = #3c4048
mod.theme.color_bevel_outset_2 = #3c4048
mod.theme.beveling = 0.5

mod.theme.color_text = #c9ced8
mod.theme.color_label = #c9ced8
mod.theme.color_label_inner = #c9ced8
mod.theme.color_label_outer = #c9ced8
mod.theme.color_icon = #c9ced8
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #8fa8ff
mod.theme.color_focus = #8fa8ff
mod.theme.color_ctrl_active = #8fa8ff
mod.theme.color_val = #8fa8ff

mod.theme.color_terminal_bg = #1f2226
mod.theme.color_terminal_text = #c9ced8

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 3.0
mod.theme.container_corner_radius = 6.0
true

mod.theme = mod.themes.dark

// An olive-drab field radio: stencilled type, amber and red lamps.
// A starter: a sober palette on the dark base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #2b2f22
mod.theme.color_fg_app = #2b2f22
mod.theme.color_bg_container = #2b2f22
mod.theme.color_surface_container_lowest = #1f2218

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #373c2c
mod.theme.color_outset_1 = #373c2c
mod.theme.color_outset_2 = #373c2c
mod.theme.color_outset_hover = #404634
mod.theme.color_outset_1_hover = #404634
mod.theme.color_outset_2_hover = #404634
mod.theme.color_outset_down = #30352a
mod.theme.color_outset_1_down = #30352a
mod.theme.color_outset_2_down = #30352a
mod.theme.color_outset_disabled = #2b2f22
mod.theme.color_outset_1_disabled = #2b2f22
mod.theme.color_outset_2_disabled = #2b2f22

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #1f2218
mod.theme.color_inset_1 = #1f2218
mod.theme.color_inset_2 = #1f2218
mod.theme.color_inset_hover = #1a1d14
mod.theme.color_inset_1_hover = #1a1d14
mod.theme.color_inset_2_hover = #1a1d14
mod.theme.color_inset_focus = #1a1d14
mod.theme.color_inset_1_focus = #1a1d14
mod.theme.color_inset_2_focus = #1a1d14
mod.theme.color_inset_active = #1a1d14
mod.theme.color_inset_1_active = #1a1d14
mod.theme.color_inset_2_active = #1a1d14
mod.theme.color_inset_down = #1a1d14
mod.theme.color_inset_1_down = #1a1d14
mod.theme.color_inset_2_down = #1a1d14
mod.theme.color_inset_drag = #1f2218
mod.theme.color_inset_1_drag = #1f2218
mod.theme.color_inset_2_drag = #1f2218
mod.theme.color_inset_empty = #1f2218
mod.theme.color_inset_1_empty = #1f2218
mod.theme.color_inset_2_empty = #1f2218
mod.theme.color_inset_disabled = #2b2f22
mod.theme.color_inset_1_disabled = #2b2f22
mod.theme.color_inset_2_disabled = #2b2f22

// One hairline edge on every face and well.
mod.theme.color_bevel = #57614a
mod.theme.color_bevel_inset_1 = #57614a
mod.theme.color_bevel_inset_2 = #57614a
mod.theme.color_bevel_outset_1 = #57614a
mod.theme.color_bevel_outset_2 = #57614a
mod.theme.beveling = 0.5

mod.theme.color_text = #e7e4d0
mod.theme.color_label = #e7e4d0
mod.theme.color_label_inner = #e7e4d0
mod.theme.color_label_outer = #e7e4d0
mod.theme.color_icon = #e7e4d0
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #f0a830
mod.theme.color_focus = #f0a830
mod.theme.color_ctrl_active = #f0a830
mod.theme.color_val = #f0a830

mod.theme.color_terminal_bg = #1f2218
mod.theme.color_terminal_text = #e7e4d0

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 2.0
mod.theme.container_corner_radius = 4.0
true

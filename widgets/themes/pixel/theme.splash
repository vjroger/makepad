mod.theme = mod.themes.light

// Pixel art: a pale green dot-matrix glass, every control framed in
// square pixels.
// A starter: a sober palette on the light base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #b9cd70
mod.theme.color_fg_app = #b9cd70
mod.theme.color_bg_container = #b9cd70
mod.theme.color_surface_container_lowest = #a9bd5e

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #c4d67e
mod.theme.color_outset_1 = #c4d67e
mod.theme.color_outset_2 = #c4d67e
mod.theme.color_outset_hover = #cbdc8a
mod.theme.color_outset_1_hover = #cbdc8a
mod.theme.color_outset_2_hover = #cbdc8a
mod.theme.color_outset_down = #aec262
mod.theme.color_outset_1_down = #aec262
mod.theme.color_outset_2_down = #aec262
mod.theme.color_outset_disabled = #b9cd70
mod.theme.color_outset_1_disabled = #b9cd70
mod.theme.color_outset_2_disabled = #b9cd70

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #a9bd5e
mod.theme.color_inset_1 = #a9bd5e
mod.theme.color_inset_2 = #a9bd5e
mod.theme.color_inset_hover = #a3b757
mod.theme.color_inset_1_hover = #a3b757
mod.theme.color_inset_2_hover = #a3b757
mod.theme.color_inset_focus = #a3b757
mod.theme.color_inset_1_focus = #a3b757
mod.theme.color_inset_2_focus = #a3b757
mod.theme.color_inset_active = #a3b757
mod.theme.color_inset_1_active = #a3b757
mod.theme.color_inset_2_active = #a3b757
mod.theme.color_inset_down = #a3b757
mod.theme.color_inset_1_down = #a3b757
mod.theme.color_inset_2_down = #a3b757
mod.theme.color_inset_drag = #a9bd5e
mod.theme.color_inset_1_drag = #a9bd5e
mod.theme.color_inset_2_drag = #a9bd5e
mod.theme.color_inset_empty = #a9bd5e
mod.theme.color_inset_1_empty = #a9bd5e
mod.theme.color_inset_2_empty = #a9bd5e
mod.theme.color_inset_disabled = #b9cd70
mod.theme.color_inset_1_disabled = #b9cd70
mod.theme.color_inset_2_disabled = #b9cd70

// One hairline edge on every face and well.
mod.theme.color_bevel = #3d5a22
mod.theme.color_bevel_inset_1 = #3d5a22
mod.theme.color_bevel_inset_2 = #3d5a22
mod.theme.color_bevel_outset_1 = #3d5a22
mod.theme.color_bevel_outset_2 = #3d5a22
mod.theme.beveling = 0.5

mod.theme.color_text = #0f2a0f
mod.theme.color_label = #0f2a0f
mod.theme.color_label_inner = #0f2a0f
mod.theme.color_label_outer = #0f2a0f
mod.theme.color_icon = #0f2a0f
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`: the purple of a handheld's buttons.
mod.theme.color_ctrl_selected = #6a2c70
mod.theme.color_focus = #6a2c70
mod.theme.color_ctrl_active = #6a2c70
mod.theme.color_val = #6a2c70

mod.theme.color_terminal_bg = #0f2a0f
mod.theme.color_terminal_text = #b9cd70

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 0.0
mod.theme.container_corner_radius = 0.0
true

mod.theme = mod.themes.dark

// Futuristic moulded plastic: smooth dark shells with light traced
// through them.
// A starter: a sober palette on the dark base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #1c2129
mod.theme.color_fg_app = #1c2129
mod.theme.color_bg_container = #1c2129
mod.theme.color_surface_container_lowest = #14181e

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #2a313c
mod.theme.color_outset_1 = #2a313c
mod.theme.color_outset_2 = #2a313c
mod.theme.color_outset_hover = #333b47
mod.theme.color_outset_1_hover = #333b47
mod.theme.color_outset_2_hover = #333b47
mod.theme.color_outset_down = #252b35
mod.theme.color_outset_1_down = #252b35
mod.theme.color_outset_2_down = #252b35
mod.theme.color_outset_disabled = #1c2129
mod.theme.color_outset_1_disabled = #1c2129
mod.theme.color_outset_2_disabled = #1c2129

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #14181e
mod.theme.color_inset_1 = #14181e
mod.theme.color_inset_2 = #14181e
mod.theme.color_inset_hover = #111419
mod.theme.color_inset_1_hover = #111419
mod.theme.color_inset_2_hover = #111419
mod.theme.color_inset_focus = #111419
mod.theme.color_inset_1_focus = #111419
mod.theme.color_inset_2_focus = #111419
mod.theme.color_inset_active = #111419
mod.theme.color_inset_1_active = #111419
mod.theme.color_inset_2_active = #111419
mod.theme.color_inset_down = #111419
mod.theme.color_inset_1_down = #111419
mod.theme.color_inset_2_down = #111419
mod.theme.color_inset_drag = #14181e
mod.theme.color_inset_1_drag = #14181e
mod.theme.color_inset_2_drag = #14181e
mod.theme.color_inset_empty = #14181e
mod.theme.color_inset_1_empty = #14181e
mod.theme.color_inset_2_empty = #14181e
mod.theme.color_inset_disabled = #1c2129
mod.theme.color_inset_1_disabled = #1c2129
mod.theme.color_inset_2_disabled = #1c2129

// One hairline edge on every face and well.
mod.theme.color_bevel = #3e4857
mod.theme.color_bevel_inset_1 = #3e4857
mod.theme.color_bevel_inset_2 = #3e4857
mod.theme.color_bevel_outset_1 = #3e4857
mod.theme.color_bevel_outset_2 = #3e4857
mod.theme.beveling = 0.5

mod.theme.color_text = #e8eef5
mod.theme.color_label = #e8eef5
mod.theme.color_label_inner = #e8eef5
mod.theme.color_label_outer = #e8eef5
mod.theme.color_icon = #e8eef5
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #38d3e2
mod.theme.color_focus = #38d3e2
mod.theme.color_ctrl_active = #38d3e2
mod.theme.color_val = #38d3e2

mod.theme.color_terminal_bg = #14181e
mod.theme.color_terminal_text = #e8eef5

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 6.0
mod.theme.container_corner_radius = 10.0
true

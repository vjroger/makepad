use mod.prelude.widgets_internal.*

// Futuristic plastic: slabs of translucent blue-grey plastic standing on a
// dark slate ground traced with faint circuits.
// A slab has thickness: a lit shoulder along its head, a frost sheen over
// its top third, one device pixel of pale rim, and along its foot the light
// that lives inside the plastic: a pale cyan edge that glows up into the
// face and leaks a little onto the ground under it. A dark drop and that
// cyan underglow fall outside the layout box and are gone within half the
// gap to the next control. Pushed in, the slab settles, its head goes dark
// and its light dims. What is on is lit from within.
mod.widgets.Button.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.Button.draw_bg.border_radius = 3.5
mod.widgets.Button.draw_bg.border_size = 0.5
// A ROW OF FIELDS IS ONE HEIGHT: the box metrics are stated once here and
// handed to each field below, and the buttons take the same row.
let field_height = 26.0
let field_pad_v = 4.0
let field_radius = 3.5
let field_border = 0.5

// The room a Fit field takes: where a field is Fit, the padding IS its
// height.
let field_room = fn(w) {
    w.min_height = field_height
    w.padding.top = field_pad_v
    w.padding.bottom = field_pad_v
}
// The box a field draws. Given the draw object and not the widget, because
// not every field draws its own box.
let field_face = fn(d) {
    d.border_radius = field_radius
    d.border_size = field_border
}
// A field that states a frame and lays its own parts out inside it takes
// the height alone: a padding would displace its line.
let field_frame = fn(w) {
    w.min_height = field_height
}

field_room(mod.widgets.TextInput)
field_face(mod.widgets.TextInput.draw_bg)
field_room(mod.widgets.TextInputFlat)
field_face(mod.widgets.TextInputFlat.draw_bg)
field_room(mod.widgets.ComboBox)
field_face(mod.widgets.ComboBox.draw_bg)
field_room(mod.widgets.DropDown)
field_face(mod.widgets.DropDown.draw_bg)
field_room(mod.widgets.DropDown2)
field_face(mod.widgets.DropDown2.draw_bg)
field_room(mod.widgets.FieldWell)
field_face(mod.widgets.FieldWell.draw_bg)
field_room(mod.widgets.TagField)
field_face(mod.widgets.TagField.draw_bg)
field_frame(mod.widgets.NumberField)
mod.widgets.NumberField.draw_bg.border_radius = field_radius
field_frame(mod.widgets.ValueInput)
field_frame(mod.widgets.DateField)
field_frame(mod.widgets.TimeField)
field_frame(mod.widgets.DatePicker)
field_frame(mod.widgets.DateRangePicker)
// The chrome-less input a well holds must impose no height of its own.
mod.widgets.WellInput.min_height = 0.0
mod.widgets.Window.pass.clear_color = #121a22

// Shadows and light leave the layout box: plain views stop clipping so a
// shadow can fall into the gap under a control. Scroll views still clip.
mod.widgets.View.clip_x = false
mod.widgets.View.clip_y = false

// ---------------------------------------------------------------------------
// THE INKS.
// Shadow ink #03070c; cool white; the accent cyan #56d4f2; the light's pale
// core #c8f4ff; the lit edge #9ff0ff; the halo blue-cyan #3fb6e0.
let fp_ink = fn() -> vec3 { return vec3(0.012, 0.027, 0.047) }
let fp_white = fn() -> vec3 { return vec3(0.94, 0.97, 0.99) }
let fp_acc = fn() -> vec3 { return vec3(0.337, 0.831, 0.949) }
let fp_acc_rim = fn() -> vec3 { return vec3(0.784, 0.957, 1.0) }
let fp_acc_line = fn() -> vec3 { return vec3(0.624, 0.941, 1.0) }
let fp_acc_glow = fn() -> vec3 { return vec3(0.247, 0.714, 0.878) }
// Rose, for error and danger only.
let fp_rose = fn() -> vec3 { return vec3(0.941, 0.416, 0.541) }

// Grain that does not repeat: the library's hash nearly repeats every 97
// cells along an axis, so it is fed a skewed lattice on which no short
// shift lines up again. Signed, triangular, one value per cell.
let fp_grain = fn(p: vec2, amount: float) -> float {
    let i = floor(p)
    let q = vec2(i.x + i.y * 0.4142, i.y - i.x * 0.2718)
    return (Finish.hash(q) - Finish.hash(q.yx * 1.3107 + vec2(17.13, 3.71))) * amount
}

// ---------------------------------------------------------------------------
// THE PLASTIC. Distances in points, negative inside; px is one device pixel.

// The box snapped to device pixels, as (lo, hi) relative to the quad's
// layout origin, so every rim lands on one pixel row.
let fp_snap = fn(o: vec2, s: vec2, px: float) -> vec4 {
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y, px)) - o
    let hi = vec2(Finish.snap(o.x + s.x, px), Finish.snap(o.y + s.y, px)) - o
    return vec4(lo, hi)
}

// Rounded box with a corner per quadrant: (tl, tr, br, bl).
let fp_box = fn(p: vec2, c: vec2, h: vec2, rr: vec4) -> float {
    let q = p - c
    var r = rr.x
    if q.x > 0.0 {
        r = rr.y
        if q.y > 0.0 {
            r = rr.z
        }
    } else {
        if q.y > 0.0 {
            r = rr.w
        }
    }
    return Material.sd_box(p, c, h, min(r, min(h.x, h.y)))
}

// The plastic's body down a slab: #708b9e at the head, #587285 in the
// middle, #50697a at the foot.
let fp_body = fn(yn: float) -> vec3 {
    let a = mix(vec3(0.439, 0.545, 0.620), vec3(0.345, 0.447, 0.522), smoothstep(0.0, 0.5, yn))
    return mix(a, vec3(0.314, 0.412, 0.478), smoothstep(0.5, 1.0, yn))
}
// The frost white alpha a panel's head carries, for the chips and keys.
let fp_lift = fn(yn: float) -> float {
    return mix(mix(0.20, 0.13, clamp(yn * 2.0, 0.0, 1.0)), 0.09, clamp(yn * 2.0 - 1.0, 0.0, 1.0))
}
// The rim's alpha round the edge, as a share of `top`.
let fp_rim = fn(yn: float, xn: float, top: float) -> float {
    let k = top / 0.60
    let v = mix(0.60, 0.30, smoothstep(0.0, 1.0, yn))
    let side = (1.0 - abs(yn * 2.0 - 1.0)) * (0.0 - 0.03 - 0.06 * xn)
    return (v + side) * k
}
// The rim's pale tint, #e0f2fb.
let fp_rimc = fn() -> vec3 { return vec3(0.878, 0.949, 0.984) }

// A plastic slab on the snapped box b = (lo, hi), premultiplied.
//   face  the body's strength (1 a button, 0 an outline)
//   amb   the dark drop's strength
//   rim   the rim's strength
//   tone  a tint laid over the body, premultiplied (a = its share)
//   edge  the colour of the light inside, and cau its strength
//   hero  lit from within: a cyan body and a brighter edge
//   lit   on: the rim turns cyan all round with a bloom
let fp_plate = fn(p: vec2, b: vec4, rr: vec4, px: float, hover: float, down: float, focus: float, disabled: float, face: float, amb: float, rim: float, tone: vec4, rim_col: vec3, edge: vec3, cau: float, hero: float, lit: float) -> vec4 {
    let lo = b.xy
    let hi = b.zw
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = fp_box(p, c, h, rr)
    let r = min(max(max(rr.x, rr.y), max(rr.z, rr.w)), min(h.x, h.y))
    let hh = hi.y - lo.y
    let yn = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    let live = 1.0 - disabled
    let inside = Finish.cover(d, px)
    let outside = 1.0 - inside
    let hv = hover * (1.0 - down)
    let up = 1.0 - down
    // Outside: the dark drop, 1.4 points down (a press settles it to 0.3),
    // and a dark line hugging the edge.
    let fa = Finish.drop(p, c, h, r, vec2(0.0, mix(1.4, 0.3, down)), mix(1.4, 0.8, down)) * amb * 0.55 * live
    let ct = Finish.ring_out(d, 0.0, px, px) * 0.40 * min(rim, 1.0) * mix(1.0, 0.5, disabled)
    let sh = (1.0 - (1.0 - fa) * (1.0 - ct)) * outside
    var o = vec4(fp_ink() * sh, sh)
    // The light inside leaking onto the ground: under the foot at rest, all
    // round with a focus or when lit; gone within three points.
    let el = (0.55 + 0.55 * hv + 0.40 * hero + 0.25 * lit) * cau * live * (1.0 - 0.70 * down)
    let ug = Finish.drop(p, c + vec2(0.0, 2.0), h - vec2(3.0, 1.5), r, vec2(0.0, 0.0), 1.6) * el * 1.05 * outside
    let hk = max(focus * 0.65, lit * 0.30) * live
    let halo = Finish.drop(p, c, h, r, vec2(0.0, 0.3), 1.2) * hk * outside
    let gl = min(ug + halo, 0.7)
    o = Finish.over(o, vec4(mix(edge, vec3(0.85, 0.97, 1.0), 0.25) * gl, gl))
    // The body: the plastic with its tint, lifted by the hand, dimmed by a
    // press, and lit from within for the hero.
    let depth = 0.0 - d
    var col = fp_body(yn)
    col = mix(col, tone.rgb / max(tone.a, 0.001), tone.a)
    col = col * (1.0 + 0.12 * hv - 0.26 * down)
    col = mix(col, vec3(0.200, 0.447, 0.545), hero * (0.45 + 0.20 * yn))
    // The shoulder: a band of pale plastic 2.5 points wide round a raised
    // plateau, lit on the head, quieter up the sides; at the foot it is the
    // lip the light comes out of. Pushed in, the plateau sinks level with
    // it and a dark inner shadow falls from the head.
    let sw = min(2.5, h.y * 0.3)
    let sho = Finish.cover(depth - sw, px)
    let headw = 1.0 - smoothstep(0.25, 0.55, yn)
    let footw = smoothstep(0.55, 0.85, yn)
    let sidew = 1.0 - max(headw, footw)
    let pale = mix(vec3(0.60, 0.70, 0.77), vec3(0.52, 0.62, 0.70), yn) * (1.0 + 0.10 * hv)
    col = mix(col, pale, sho * face * mix(0.85, 0.12, down) * (1.0 - hero * 0.4))
    // The plateau's own edge: a pale line along its head, a dark one along
    // its foot, where it stands over the lip.
    let pd = depth - sw
    let pe = Finish.band(0.0 - pd, 0.0, px, px) * up
    col = mix(col, vec3(0.86, 0.94, 0.98), pe * headw * 0.45)
    col = mix(col, vec3(0.10, 0.16, 0.21), pe * (footw * 0.35 + sidew * 0.20))
    let ish = Finish.inset(p, c, h, r, vec2(0.0, 1.6), 1.8) * down
    col = mix(col, vec3(0.0, 0.0, 0.0), ish * 0.75)
    // The frost sheen over the top third of the plateau.
    let sheen = (1.0 - smoothstep(0.0, 0.40, yn)) * 0.10 * up * (1.0 - sho)
    col = mix(col, vec3(1.0, 1.0, 1.0), sheen)
    // The light inside: the lip lit pale cyan, glowing up into the plateau.
    let lip = sho * footw * el
    col = mix(col, mix(edge, vec3(1.0, 1.0, 1.0), 0.45), min(lip * 0.85, 0.9))
    let gin = exp(0.0 - max(pd, 0.0) / 4.0) * smoothstep(0.40, 0.95, yn) * el * (1.0 - sho)
    col = col + edge * gin * 0.34
    col = mix(col, vec3(0.16, 0.20, 0.24), disabled * 0.75)
    let fa2 = min(face, 1.0) * mix(0.93, 0.55, disabled)
    var f = vec4(col * fa2, fa2)
    // The rim: pale on the head, quieter up the sides; along the foot the
    // lit edge, a pale core of the edge colour.
    let rb = Finish.band(d, 0.0, px, px)
    let ra = min((0.80 * headw * mix(1.0, 0.35, down) + 0.45 * sidew) * (1.0 + 0.3 * hv), 1.0) * rim * mix(1.0, 0.45, disabled)
    f = Finish.over(f, vec4(rim_col * rb * ra, rb * ra))
    let core = mix(edge, vec3(1.0, 1.0, 1.0), 0.55)
    let ea = rb * footw * min(el * 1.4, 1.0)
    f = mix(f, vec4(core, 1.0), ea)
    // A focus or a lit state rings the whole edge in cyan light.
    let fr = rb * max(focus, lit * 0.95) * live
    f = mix(f, vec4(fp_acc_rim(), 1.0), fr)
    // Face grain, a third of a level, so the long fall does not band.
    let g = fp_grain(p / px, 0.9 / 255.0) * f.a
    f = vec4(f.rgb + vec3(g, g, g), f.a) * inside
    o = Finish.over(o, f)
    return o
}

// A recessed well of darker plastic on the shape d: black at `a` over what
// is under it, a dark pixel along its head, a light pixel along its foot
// and quieter light up its sides. Premultiplied.
let fp_well_h = fn(d: float, yn: float, px: float, a: float, foot: float, side: float, hd: float) -> vec4 {
    let inside = Finish.cover(d, px)
    let rb = Finish.band(d, 0.0, px, px)
    let head = rb * (1.0 - smoothstep(0.25, 0.5, yn))
    let low = rb * smoothstep(0.5, 0.75, yn)
    let mid = rb * (1.0 - max(1.0 - smoothstep(0.25, 0.5, yn), smoothstep(0.5, 0.75, yn)))
    var o = vec4(0.0, 0.0, 0.0, a)
    o = Finish.over(o, vec4(0.0, 0.0, 0.0, hd * head))
    let l = foot * low + side * mid
    o = Finish.over(o, vec4(vec3(0.75, 0.88, 0.95) * l, l))
    return o * inside
}
let fp_well = fn(d: float, yn: float, px: float, a: float, foot: float, side: float) -> vec4 {
    return fp_well_h(d, yn, px, a, foot, side, 0.4)
}

// Distance to a segment.
let fp_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0)
    return length(pa - ba * t)
}

// A lit line along the segment a..b, w points across: a pale core, the
// cyan body and a soft halo. Premultiplied, laid over `under`.
let fp_beam = fn(under: vec4, p: vec2, a: vec2, b: vec2, w: float, px: float, k: float, hue: vec3) -> vec4 {
    let d = fp_seg(p, a, b) - w * 0.5
    let dd = max(d, 0.0)
    let hg = exp(0.0 - dd * dd / 3.2) * 0.45 * k * (1.0 - Finish.cover(d, px))
    var o = Finish.over(under, vec4(hue * 0.8 * hg, hg))
    let body = Finish.cover(d, px) * k
    o = Finish.over(o, vec4(hue * body, body))
    let cd = fp_seg(p, a, b) - max(w * 0.5 - 1.0, px * 0.5)
    let cr = Finish.cover(cd, px) * k * 0.9
    return Finish.over(o, vec4(mix(hue, vec3(1.0, 1.0, 1.0), 0.7) * cr, cr))
}

// A glass bead: a handle, a thumb or a lamp. Its own drop, a pale sphere
// lit from the upper left with a specular spot, cyan light caught in its
// lower half and a thin pale rim. Lit, it glows: a white core, a cyan body
// and a halo round it. Premultiplied, laid over `under`.
let fp_bead = fn(under: vec4, p: vec2, c: vec2, r: float, px: float, hover: float, down: float, disabled: float, lit: float) -> vec4 {
    let d = length(p - c) - r
    let q = (p - c) / max(r, 0.5)
    let live = 1.0 - disabled
    let outside = 1.0 - Finish.cover(d, px)
    let amb = Finish.drop(p, c, vec2(r, r), r, vec2(0.0, 1.0), 1.2) * 0.45 * live * outside * (1.0 - 0.7 * lit)
    var o = Finish.over(under, vec4(fp_ink() * amb, amb))
    let dd = max(d, 0.0)
    let hg = exp(0.0 - dd * dd / (r * 0.9 + 1.2)) * 0.55 * lit * live * outside
    o = Finish.over(o, vec4(fp_acc_glow() * hg, hg))
    let hv = hover * (1.0 - down)
    let l = length(q)
    var col = mix(vec3(0.86, 0.92, 0.95), vec3(0.42, 0.53, 0.61), smoothstep(-0.9, 0.9, q.y))
    col = col * (1.0 - 0.28 * smoothstep(0.55, 1.0, l))
    col = col + fp_acc() * 0.30 * smoothstep(0.1, 0.9, q.y) * smoothstep(0.35, 0.95, l)
    col = col * (1.0 + 0.06 * hv - 0.10 * down)
    // Lit: the bead is a lamp, white at its core.
    let lamp = mix(fp_acc(), vec3(0.94, 0.99, 1.0), 1.0 - smoothstep(0.0, 0.85, l))
    col = mix(col, lamp, lit * live)
    let spec = exp(0.0 - dot(q - vec2(-0.30, -0.42), q - vec2(-0.30, -0.42)) / 0.05) * 0.85 * (1.0 - 0.5 * lit)
    col = mix(col, vec3(1.0, 1.0, 1.0), spec)
    let rb = Finish.band(d, 0.0, px, px)
    col = mix(col, mix(vec3(0.92, 0.97, 1.0), fp_acc_rim(), smoothstep(-0.2, 0.8, q.y)), rb * 0.6)
    col = mix(col, vec3(0.30, 0.35, 0.40), disabled * 0.6)
    let a = Finish.cover(d, px)
    return Finish.over(o, vec4(col * a, a))
}

// The wait spinner a replaced face draws itself: a pale cyan comet turning
// once a second on a ring where the label was.
let fp_wait = fn(under: vec4, p: vec2, size: vec2, px: float, loading: float, t: float) -> vec4 {
    let c = size * 0.5
    let r = max(min(size.x, size.y) * 0.5 - 6.0, 3.0)
    let q = p - c
    let ring = abs(length(q) - r)
    let a = fract(atan2(q.y, q.x) / 6.2831853 - t)
    let body = Finish.cover(ring - 0.75, px) * a * a * loading
    let track = Finish.cover(ring - 0.5, px) * 0.15 * loading
    let o = Finish.over(under, vec4(fp_white() * track, track))
    return mix(o, vec4(fp_acc_rim(), 1.0), body)
}

// A plastic button: the slab on the snapped box.
let fp_button = fn(p: vec2, o: vec2, s: vec2, px: float, rr: vec4, hover: float, down: float, focus: float, disabled: float, face: float, amb: float, rim: float, edge: vec3, hero: float) -> vec4 {
    let b = fp_snap(o, s, px)
    return fp_plate(p, b, rr, px, hover, down, focus, disabled, face, amb, rim, vec4(0.0, 0.0, 0.0, 0.0), fp_rimc(), edge, 1.0, hero, 0.0)
}

// ---------------------------------------------------------------------------
// BUTTONS. Slabs 26 points tall, corners of 3.5. The drop and the light
// fall outside the box: the quad grows by `glow_room` and the button stops
// clipping.
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.icon_walk = Walk{width: 14.0, height: Fit}
mod.widgets.ButtonFlat.min_height = 26.0
mod.widgets.ButtonXs.min_height = 0.0
mod.widgets.ButtonSm.min_height = 0.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 8.0 right: 8.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.draw_bg.border_radius = 3.5
mod.widgets.ButtonFlat.draw_bg.glow_room = uniform(6.0)
mod.widgets.ButtonFlat.draw_bg.corners = fn() -> vec4 {
    let r = self.border_radius
    return vec4(
        mix(r, self.border_radius_tl, step(0.0, self.border_radius_tl)),
        mix(r, self.border_radius_tr, step(0.0, self.border_radius_tr)),
        mix(r, self.border_radius_br, step(0.0, self.border_radius_br)),
        mix(r, self.border_radius_bl, step(0.0, self.border_radius_bl))
    )
}
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = self.glow_room
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
// The flat button lies on the ground: the slab without its drop. The size
// ladder wears it too.
mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 0.85, 0.3, 0.9, fp_acc_line(), 0.0)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// The standard button: the whole slab.
mod.widgets.Button.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 1.0, 1.0, 1.0, fp_acc_line(), 0.0)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// The one hero: the slab lit from within, cyan through its body.
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 1.0, 1.0, 1.1, fp_acc_line(), 1.0)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// The second voice: the standard slab.
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 1.0, 1.0, 1.0, fp_acc_line(), 0.0)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// Tonal: thinner plastic, a lighter drop.
mod.widgets.ButtonTertiary.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 0.8, 0.6, 0.85, fp_acc_line(), 0.0)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// Danger: the standard slab with rose light inside it.
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, 1.0, 1.0, 1.0, fp_rose(), 0.0)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// Outline: the rim and the lit edge alone over a faint film; the hand
// fills it in.
mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let face = 0.18 + 0.5 * max(self.hover, self.down)
    let f = fp_button(p, self.rect_pos, self.rect_size, px, self.corners(), self.hover, self.down, self.focus, self.disabled, face, 0.0, 1.2, fp_acc_line(), 0.0)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}
// Flatter: nothing at rest; the slab comes with the pointer.
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    let m = self.glow_room
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let k = max(max(self.hover, self.down), self.focus)
    let b = fp_snap(self.rect_pos, self.rect_size, px)
    let f = fp_plate(p, b, self.corners(), px, self.hover, self.down, self.focus, self.disabled, 0.7 * max(self.hover, self.down), 0.0, 0.8 * k, vec4(0.0, 0.0, 0.0, 0.0), fp_rimc(), fp_acc_line(), k, 0.0, 0.0)
    return fp_wait(f, p, self.rect_size, px, self.loading, self.anim_time)
}


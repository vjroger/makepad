    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    return fp_check(p, self.rect_pos, self.rect_size, px, self.size, self.border_radius, self.mark_at_end, self.hover, self.down, self.focus, self.active, self.mixed, self.error, self.disabled)
}
mod.widgets.CheckBoxCircle.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    return fp_check(p, self.rect_pos, self.rect_size, px, self.size, self.size * 0.5, self.mark_at_end, self.hover, self.down, self.focus, self.active, self.mixed, self.error, self.disabled)
}

// RADIOS. The plastic as a disc; on, a lamp bead 8 points across glows in
// its middle and the rim takes the cyan light.
mod.widgets.RadioButtonFlat.clip_x = false
mod.widgets.RadioButtonFlat.clip_y = false
mod.widgets.RadioButtonFlat.label_walk.margin.left = 14.0
mod.widgets.RadioButtonFlat.draw_bg.size = 15.0
mod.widgets.RadioButtonFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.RadioButtonFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let o = self.rect_pos
    let sz = self.size
    let lo = vec2(Finish.snap(o.x, px), Finish.snap(o.y + self.rect_size.y * 0.5 - sz * 0.5, px)) - o
    let hi = lo + vec2(Finish.snap(sz, px), Finish.snap(sz, px))
    let on = self.active
    let r = sz * 0.5
    let f = fp_plate(p, vec4(lo, hi), vec4(r, r, r, r), px, self.hover, self.down, self.focus, self.disabled, 1.0, 0.8, 1.0, vec4(0.0, 0.0, 0.0, 0.0), fp_rimc(), fp_acc_line(), mix(0.55, 0.9, on), 0.0, on * 0.6)
    let c = (lo + hi) * 0.5
    // A socket ring round the lamp bead, which is dark glass off and lit on.
    let sd = abs(length(p - c) - 4.6) - 0.6
    let sa = Finish.cover(sd, px) * 0.30
    let g = Finish.over(f, vec4(0.0, 0.0, 0.0, sa))
    return fp_bead(g, p, c, 4.0, px, self.hover, self.down, self.disabled, on)
}

// TOGGLES. A plastic slab 28 by 16 with corners of 4 and a dark slot sunk
// in it; the thumb is a glass bead that rides the slot and, on, glows as a
// lamp, lighting the slot cyan round it.
mod.widgets.ToggleFlat.label_walk.margin.left = 28.0
mod.widgets.ToggleFlat.draw_bg.size = 16.0
mod.widgets.ToggleFlat.draw_bg.pill_aspect = 1.75
mod.widgets.ToggleFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.ToggleFlat.clip_x = false
mod.widgets.ToggleFlat.clip_y = false
mod.widgets.ToggleFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let o = self.rect_pos
    let sz = vec2(self.size * self.pill_aspect, self.size)
    let x0 = (self.rect_size.x - sz.x) * self.mark_at_end
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + self.rect_size.y * 0.5 - sz.y * 0.5, px)) - o
    let hi = lo + vec2(Finish.snap(sz.x, px), Finish.snap(sz.y, px))
    let c = (lo + hi) * 0.5
    let live = 1.0 - self.disabled
    let on = self.active
    var f = fp_plate(p, vec4(lo, hi), vec4(4.0, 4.0, 4.0, 4.0), px, self.hover, self.down, self.focus, self.disabled, 1.0, 0.8, 1.0, vec4(0.0, 0.0, 0.0, 0.0), fp_rimc(), fp_acc_line(), mix(0.5, 0.8, on), 0.0, 0.0)
    // The slot: 3 points in, dark plastic, lit cyan along the way the bead
    // has come when on.
    let sh = vec2(sz.x * 0.5 - 2.5, sz.y * 0.5 - 2.5)
    let sd = Material.sd_box(p, c, sh, 2.5)
    let yn = clamp((p.y - c.y + sh.y) / max(2.0 * sh.y, 1.0), 0.0, 1.0)
    f = Finish.over(f, fp_well_h(sd, yn, px, 0.55 - 0.05 * self.hover, 0.20, 0.10, 0.55))
    let t = mix(on, self.drag_pos, self.drag)
    let kr = sz.y * 0.5 - 3.0
    let kc = vec2(mix(lo.x + sz.y * 0.5, hi.x - sz.y * 0.5, t), c.y)
    let pool = exp(0.0 - length(p - kc) / 5.0) * 0.55 * on * live * Finish.cover(sd, px)
    f = Finish.over(f, vec4(fp_acc() * pool, pool))
    f = fp_bead(f, p, kc, kr * (1.0 - 0.06 * self.down), px, self.hover, self.down, self.disabled, on)
    return f * mix(1.0, 0.5, self.disabled)
}

// ---------------------------------------------------------------------------
// SLIDERS. A 4 point groove of dark plastic with a dark head pixel and a
// light foot pixel; the value a lit line, a pale core in a cyan body with
// a soft halo; a glass bead handle 13 across. Dragging lights the bead's
// rim; a focus rings it.
let fp_slider = fn(p: vec2, o: vec2, rs: vec2, px: float, cy: float, x0p: float, x1p: float, pos: float, from: float, hover: float, focus: float, drag: float, disabled: float, handle: float) -> vec4 {
    let live = 1.0 - disabled
    let y = Finish.snap(o.y + cy, px) - o.y
    let x0 = Finish.snap(o.x + x0p, px) - o.x
    let x1 = Finish.snap(o.x + x1p, px) - o.x
    let gc = vec2((x0 + x1) * 0.5, y)
    let gh = vec2((x1 - x0) * 0.5 + 2.0, 2.0)
    let gd = Finish.sd_pill(p, gc, gh)
    let yn = clamp((p.y - y + 2.0) / 4.0, 0.0, 1.0)
    var f = fp_well_h(gd, yn, px, 0.50, 0.22, 0.12, 0.50)
    let xv = mix(x0, x1, pos)
    let xf = mix(x0, x1, from)
    let k = step(0.01, abs(xv - xf)) * mix(1.0, 0.35, disabled) * (0.92 + 0.08 * max(hover, drag))
    f = fp_beam(f, p, vec2(min(xf, xv), y), vec2(max(xf, xv), y), 2.6, px, k, mix(fp_acc(), vec3(1.0, 1.0, 1.0), 0.25))
    let hc = vec2(xv, y)
    let hd = length(p - hc) - 7.0
    let hk = max(0.25 * drag, 0.35 * focus) * live * handle
    let hg = exp(0.0 - max(hd, 0.0) * max(hd, 0.0) / 3.0) * hk * (1.0 - Finish.cover(hd, px))
    f = Finish.over(f, vec4(fp_acc_glow() * hg, hg))
    let kb = fp_bead(f, p, hc, (7.0 + 0.5 * max(hover, drag)) * handle, px, hover, drag, disabled, 0.0)
    let fr = Finish.cover(abs(hd - 0.2) - px * 0.5, px) * max(max(focus, drag * 0.8), hover * 0.5) * handle * live * 0.9
    return mix(kb, vec4(fp_acc_line(), 1.0), fr)
}

mod.widgets.SliderMinimal.clip_x = false
mod.widgets.SliderMinimal.clip_y = false
mod.widgets.SliderMinimal.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
// The minimal slider: a hairline rail and the lit value; its bead only
// with the pointer.
mod.widgets.SliderMinimal.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let o = self.rect_pos
    let y = Finish.snap(o.y + self.offset_y + (self.rect_size.y - self.offset_y) * 0.5, px) - o.y
    let inx = step(0.0, p.x) * step(p.x, self.rect_size.x)
    let rail = Finish.cover(abs(p.y - y - px * 0.5) - px * 0.5, px) * inx * 0.25
    var f = vec4(vec3(0.75, 0.88, 0.95) * rail, rail)
    let lo = min(self.origin_pos, self.slide_pos)
    let hi = max(self.origin_pos, self.slide_pos)
    let a = mix(0.0, lo, self.arc_origin) * self.rect_size.x
    let b = mix(self.slide_pos, hi, self.arc_origin) * self.rect_size.x
    f = fp_beam(f, vec2(p.x, p.y), vec2(a, y + px * 0.5), vec2(b, y + px * 0.5), 2.0, px, step(0.5, b - a) * mix(1.0, 0.35, self.disabled), fp_acc())
    let hc = vec2(self.slide_pos * self.rect_size.x, y + px * 0.5)
    let touch = max(max(self.hover, self.drag), self.focus)
    return fp_bead(f, p, hc, 5.0 * touch, px, self.hover, self.drag, self.disabled, 0.0)
}
// The bar slider: label and value above, the groove below.
mod.widgets.SliderFlat.height = 36.0
mod.widgets.SliderFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let lo = min(self.origin_pos, self.slide_pos)
    let from = mix(0.0, lo, self.arc_origin)
    let to = mix(self.slide_pos, max(self.origin_pos, self.slide_pos), self.arc_origin)
    let cy = 20.0 + (self.rect_size.y - 20.0) * 0.5
    return fp_slider(p, self.rect_pos, self.rect_size, px, cy, 7.0, self.rect_size.x - 7.0, to, from, self.hover, self.focus, self.drag, self.disabled, 1.0)
}
// The round slider: a capsule well of dark plastic beside its label, the
// value a lit capsule inside it ending in a small bead.
mod.widgets.SliderRoundFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let o = self.rect_pos
    let live = 1.0 - self.disabled
    let cy = Finish.snap(o.y + self.rect_size.y * 0.5, px) - o.y
    let x0 = Finish.snap(o.x + self.label_size, px) - o.x
    let x1 = Finish.snap(o.x + self.rect_size.x - 44.0, px) - o.x
    let c = vec2((x0 + x1) * 0.5, cy)
    let h = vec2((x1 - x0) * 0.5, 5.0)
    let d = Finish.sd_pill(p, c, h)
    let yn = clamp((p.y - cy + 5.0) / 10.0, 0.0, 1.0)
    let ct = Finish.ring_out(d, 0.0, px, px) * 0.35 * live
    var f = vec4(vec3(0.62, 0.74, 0.82) * ct, ct)
    f = Finish.over(f, fp_well_h(d, yn, px, 0.50, 0.22 + 0.06 * self.hover, 0.12, 0.55))
    let ins = 5.0
    let xv = mix(x0 + ins, x1 - ins, self.slide_pos)
    f = fp_beam(f, p, vec2(x0 + ins, cy), vec2(xv, cy), 4.0, px, mix(1.0, 0.35, self.disabled), fp_acc())
    let lw = step(cy, p.y) * self.focus * live
    f = mix(f, vec4(fp_acc_line(), 1.0), Finish.band(d, 0.0, px, px) * lw)
    return fp_bead(f, p, vec2(xv, cy), 5.5, px, self.hover, self.drag, self.disabled, 0.0)
}

// FADERS. The groove stood on end, fine ticks either side, the value a lit
// line, and a cap of pale plastic 14 by 22 with grip ridges and one lit
// line across its middle.
mod.widgets.SliderFader.cap_size = 14.0
mod.widgets.SliderFader.track_inset = 6.0
mod.widgets.SliderFader.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p0 = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let along = mix(self.rect_size.x, self.rect_size.y, self.is_vertical)
    let across = mix(self.rect_size.y, self.rect_size.x, self.is_vertical)
    let p = vec2(mix(p0.x, self.rect_size.y - p0.y, self.is_vertical), mix(p0.y, p0.x, self.is_vertical))
    let live = 1.0 - self.disabled
    let travel = max(along - self.inset_px * 2.0 - self.cap_px, 1.0)
    let foot = self.inset_px + self.cap_px * 0.5
    let mid = Finish.snap(across * 0.5, px)
    let gd = Finish.sd_pill(p, vec2(along * 0.5, mid), vec2(along * 0.5 - self.inset_px + 2.0, 2.0))
    let yn = clamp((p.y - mid + 2.0) / 4.0, 0.0, 1.0)
    var f = fp_well_h(gd, mix(yn, 0.5, self.is_vertical), px, 0.50, 0.18, 0.14, 0.5)
    let tq = (p.x - foot) / travel * 10.0
    let ti = floor(tq + 0.5)
    let tx = abs(tq - ti) * travel / 10.0
    let major = min(step(abs(ti - 5.0), 0.5) + step(ti, 0.5) + step(9.5, ti), 1.0)
    let tl = mix(3.0, 4.5, major)
    let tb = abs(abs(p.y - mid) - 5.0 - tl * 0.5) - tl * 0.5
    let inside = step(-0.5, ti) * step(ti, 10.5)
    let tk = Finish.cover(tb, px) * Finish.cover(tx - px * 0.5, px) * inside * mix(0.30, 0.50, major)
    f = Finish.over(f, vec4(vec3(0.75, 0.88, 0.95) * tk, tk))
    let a = foot + self.fill_lo * travel
    let b = foot + self.fill_hi * travel
    f = fp_beam(f, p, vec2(a, mid), vec2(b, mid), 2.6, px, step(0.01, b - a) * mix(1.0, 0.35, self.disabled), fp_acc())
    // The cap.
    let at = foot + self.slide_pos * travel
    let cc = vec2(at, mid)
    let hb = vec2(self.cap_px * 0.5, 11.0)
    let cd = Material.sd_box(p, cc, hb, 2.5)
    let outside = 1.0 - Finish.cover(cd, px)
    let sh = Finish.drop(p, cc, hb, 2.5, vec2(-1.0 * self.is_vertical, 1.0 - self.is_vertical), 1.6) * 0.50 * live * outside
    let ct = Finish.ring_out(cd, 0.0, px, px) * 0.40
    f = Finish.over(f, vec4(fp_ink() * max(sh, ct), max(sh, ct)))
    // The cap is lit from the top of the screen: in a vertical fader that
    // is the far end of the track.
    let cyn = mix(clamp((p.y - mid + 11.0) / 22.0, 0.0, 1.0), clamp((at + self.cap_px * 0.5 - p.x) / self.cap_px, 0.0, 1.0), self.is_vertical)
    let hv = max(self.hover, self.drag)
    var cap = mix(vec3(0.74, 0.83, 0.89), vec3(0.47, 0.58, 0.66), cyn) * (1.0 + 0.05 * hv)
    let ridge = Finish.cover(abs(fract((p.x - at) / 3.0 + 0.5) - 0.5) * 3.0 - 0.45, px) * step(abs(p.x - at), 5.0) * step(abs(p.y - mid), 8.0)
    cap = mix(cap, cap * 0.78, ridge * 0.6)
    let rb = Finish.band(cd, 0.0, px, px)
    cap = mix(cap, vec3(0.92, 0.97, 1.0), rb * mix(0.7, 0.2, cyn))
    var cf = vec4(cap, 1.0)
    let line = Finish.cover(abs(p.x - at) - 0.6, px) * step(abs(p.y - mid), 8.0)
    cf = mix(cf, vec4(mix(fp_acc(), vec3(1.0, 1.0, 1.0), 0.4), 1.0), line * mix(0.6, 1.0, hv))
    f = Finish.over(f, cf * Finish.cover(cd, px))
    return f * mix(1.0, 0.5, self.disabled)
}

// ROTARIES. A crystal knob: a skirt of clear plastic cut in twelve facets,
// its rim lit cyan, the value a lit arc running in a dark groove round the
// skirt's edge; in its middle a cap of turned metal with a dark pointer
// line and a lit tick on the skirt where it points.
let fp_arc = fn(q: vec2, r: float, a0: float, a1: float) -> float {
    var a = atan2(0.0 - q.x, q.y)
    if a < 0.0 {
        a = a + 6.2831853
    }
    let ring = abs(length(q) - r)
    let e0 = vec2(0.0 - sin(a0), cos(a0)) * r
    let e1 = vec2(0.0 - sin(a1), cos(a1)) * r
    let ends = min(length(q - e0), length(q - e1))
    return mix(ends, ring, step(a0, a) * step(a, a1))
}
let fp_knob = fn(p: vec2, c: vec2, rad: float, px: float, gap: float, pos: float, org: float, arc_org: float, hover: float, focus: float, drag: float, disabled: float) -> vec4 {
    let live = 1.0 - disabled
    let dia = rad * 2.0
    let q = p - c
    let l = length(q)
    let d = l - rad
    let inside = Finish.cover(d, px)
    let outside = 1.0 - inside
    let hv = max(hover, drag)
    // Outside: the drop and the light in the skirt leaking round it.
    let sh = Finish.drop(p, c, vec2(rad, rad), rad, vec2(0.0, 1.6), 2.0) * 0.55 * live * outside
    var f = vec4(fp_ink() * sh, sh)
    let dd = max(d, 0.0)
    let hg = exp(0.0 - dd * dd / 5.0) * (0.34 + 0.14 * hv + 0.20 * focus) * live * outside
    f = Finish.over(f, vec4(fp_acc_glow() * hg, hg))
    // The skirt: clear blue-grey plastic, paler on top, twelve facets that
    // catch the light in turn, a cyan light caught in its lower rim.
    let yn = clamp((p.y - c.y + rad) / dia, 0.0, 1.0)
    let ang = atan2(q.y, q.x)
    let facet = 0.5 + 0.5 * cos(ang * 12.0)
    var col = mix(vec3(0.60, 0.70, 0.77), vec3(0.30, 0.39, 0.46), yn)
    let lightside = clamp(0.5 - 0.5 * dot(q / max(l, 0.001), vec2(0.35, 0.94)), 0.0, 1.0)
    col = col + vec3(0.16, 0.19, 0.21) * (facet - 0.35) * (0.5 + 0.5 * lightside) * smoothstep(rad * 0.62, rad * 0.75, l)
    col = col + fp_acc() * 0.22 * smoothstep(0.55, 1.0, yn) * smoothstep(rad * 0.7, rad, l)
    col = col * (1.0 + 0.05 * hv)
    var g = vec4(col * 0.95, 0.95)
    // The groove the value runs in, 0.1 of the diameter, just inside the rim.
    let wr = rad - 1.5 - dia * 0.05
    let wd = abs(l - wr) - dia * 0.05
    g = Finish.over(g, fp_well_h(wd, 1.0 - yn, px, 0.45, 0.12, 0.08, 0.3))
    // The rim: pale on top, cyan light below.
    let rb = Finish.band(d, 0.0, px, px)
    g = mix(g, vec4(mix(vec3(0.92, 0.97, 1.0), fp_acc_line(), smoothstep(0.3, 0.9, yn)), 1.0), rb * (0.75 + 0.25 * hv))
    let rin = exp(0.0 - max(0.0 - d, 0.0) / 1.6) * smoothstep(0.35, 1.0, yn) * 0.35 * live
    g = Finish.over(g, vec4(fp_acc() * rin, rin))
    f = Finish.over(f, g * inside)
    // The value arc, lit.
    let span = 6.2831853 - gap
    let a0 = gap * 0.5
    let av = a0 + span * pos
    let ao = a0 + span * org
    let s0 = mix(a0, min(ao, av), arc_org)
    let s1 = mix(av, max(ao, av), arc_org)
    let ad = fp_arc(q, wr, s0, s1) - dia * 0.032
    let ak = step(0.001, s1 - s0) * mix(1.0, 0.35, disabled)
    let add = max(ad, 0.0)
    let ahg = exp(0.0 - add * add / 2.2) * 0.45 * ak * (1.0 - Finish.cover(ad, px))
    f = Finish.over(f, vec4(fp_acc() * ahg, ahg))
    let aa = Finish.cover(ad, px) * ak
    let acore = Finish.cover(ad + dia * 0.016, px)
    f = Finish.over(f, vec4(mix(fp_acc(), vec3(0.92, 0.99, 1.0), acore * 0.7) * aa, aa))
    // The cap of turned metal, 0.6 of the disc, with its own drop.
    let cr = rad * 0.6
    let cd = l - cr
    let cout = 1.0 - Finish.cover(cd, px)
    let csh = Finish.drop(p, c, vec2(cr, cr), cr, vec2(0.0, 1.0), 1.4) * 0.45 * live * cout * inside
    f = Finish.over(f, vec4(fp_ink() * csh, csh))
    var cap = vec3(0.66, 0.72, 0.77) * Finish.spun(p, c, vec2(-0.3, -0.9))
    let cyn = clamp((p.y - c.y + cr) / (2.0 * cr), 0.0, 1.0)
    cap = cap * mix(1.05, 0.80, cyn) * (1.0 + 0.04 * hv)
    let crb = Finish.band(cd, 0.0, px, px)
    cap = mix(cap, mix(vec3(0.95, 0.98, 1.0), vec3(0.35, 0.42, 0.48), cyn), crb * 0.7)
    cap = mix(cap, vec3(0.30, 0.34, 0.38), disabled * 0.6)
    f = Finish.over(f, vec4(cap, 1.0) * Finish.cover(cd, px))
    // The pointer: a dark line on the cap, a lit tick on the skirt.
    let dir = vec2(0.0 - sin(av), cos(av))
    let pd = fp_seg(q, dir * (cr * 0.25), dir * (cr - 1.5)) - 0.8
    let pa = Finish.cover(pd, px) * 0.85
    f = Finish.over(f, vec4(vec3(0.06, 0.09, 0.12) * pa, pa))
    let td = fp_seg(q, dir * (cr + 1.5), dir * (wr - dia * 0.07)) - 0.8
    let ta = Finish.cover(td, px) * mix(1.0, 0.4, disabled)
    return Finish.over(f, vec4(fp_acc_rim() * ta, ta))
}
mod.widgets.RotaryFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let dia = min(self.rect_size.x, self.rect_size.y - 22.0) - 8.0
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px), Finish.snap(self.rect_pos.y + 22.0 + 4.0 + dia * 0.5, px)) - self.rect_pos
    return fp_knob(p, c, dia * 0.5, px, self.gap * 0.017453, self.slide_pos, self.origin_pos, self.arc_origin, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.RotaryKnob.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let dia = min(self.rect_size.x, self.rect_size.y) - 6.0
    let c = vec2(Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px), Finish.snap(self.rect_pos.y + self.rect_size.y - 3.0 - dia * 0.5, px)) - self.rect_pos
    return fp_knob(p, c, dia * 0.5, px, self.gap * 0.017453, self.slide_pos, self.origin_pos, self.arc_origin, self.hover, self.focus, self.drag, self.disabled)
}
mod.widgets.RotaryKnob.draw_text.color = #bfd0dc
mod.widgets.RotaryKnob.draw_text.color_hover = #eef6fb
mod.widgets.RotaryKnob.draw_text.color_focus = #eef6fb
mod.widgets.RotaryKnob.draw_text.color_drag = #ffffff
mod.widgets.RotaryKnob.draw_text.color_disabled = #5d6b78
mod.widgets.RotaryKnob.draw_text.text_style = mod.theme.font_regular{font_size: 7.5}

// ---------------------------------------------------------------------------
// TEXT FIELDS. A flat slab of the same plastic, lying on the ground: no
// drop, its shoulder and rim, and a quieter light inside its foot edge. A
// focus rings it in cyan light with a halo. A field whose frame is switched
// off (the value inside a slider) draws nothing.
let fp_field = fn(p: vec2, o: vec2, s: vec2, px: float, r: float, hover: float, focus: float, disabled: float) -> vec4 {
    let b = fp_snap(o, s, px)
    return fp_plate(p, b, vec4(r, r, r, r), px, hover * 0.7, 0.0, focus, disabled, 1.0, 0.25, 0.9, vec4(vec3(0.20, 0.27, 0.33) * 0.45, 0.45), fp_rimc(), fp_acc_line(), 0.45 + 0.35 * focus, 0.0, 0.0)
}
// A darker well of the plastic, for numbers: dark body, a pale foot line.
let fp_field_dark = fn(p: vec2, o: vec2, s: vec2, px: float, r: float, hover: float, focus: float, disabled: float) -> vec4 {
    let b = fp_snap(o, s, px)
    return fp_plate(p, b, vec4(r, r, r, r), px, hover * 0.7, 0.0, focus, disabled, 1.0, 0.0, 0.7, vec4(vec3(0.10, 0.15, 0.20) * 0.80, 0.80), fp_rimc(), fp_acc_line(), 0.35 + 0.35 * focus, 0.0, 0.0)
}
mod.widgets.TextInputFlat.clip_x = false
mod.widgets.TextInputFlat.clip_y = false
mod.widgets.TextInputFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.TextInputFlat.draw_bg.pixel = fn() {
    if self.border_size < 0.01 {
        return vec4(0.0, 0.0, 0.0, 0.0)
    }
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    return fp_field(p, self.rect_pos, self.rect_size, px, self.border_radius, self.hover, self.focus, self.disabled)
}
mod.widgets.TextInputFlat.draw_text.color = #eef6fb
mod.widgets.TextInputFlat.draw_text.color_empty = #a9bccb
mod.widgets.TextInputFlat.draw_text.color_disabled = #5d6b78
mod.widgets.NumberField.clip_x = false
mod.widgets.NumberField.clip_y = false
mod.widgets.NumberField.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.NumberField.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    return fp_field_dark(p, self.rect_pos, self.rect_size, px, self.border_radius, self.hover, self.focus, self.disabled)
}
// The stepper: two frost keys joined at the field's right end, a white
// hairline at 10 % between them; the key under the hand lifts, the held
// key settles.
mod.widgets.NumberSpin.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * self.rect_size
    let o = self.rect_pos
    let b = fp_snap(o + vec2(1.0, 2.0), self.rect_size - vec2(3.0, 4.0), px) + vec4(1.0, 2.0, 1.0, 2.0)
    let c = (b.xy + b.zw) * 0.5
    let h = (b.zw - b.xy) * 0.5
    let d = Material.sd_box(p, c, h, 3.0)
    let mid = Finish.snap(o.y + self.rect_size.y * 0.5, px) - o.y
    let upper = step(p.y, mid)
    let live = 1.0 - self.disabled
    let hot = mix(max(0.0, 0.0 - self.hot), max(0.0, self.hot), upper) * live
    let down = mix(max(0.0, 0.0 - self.down), max(0.0, self.down), upper) * live
    let yn = clamp((p.y - b.y) / max(b.w - b.y, 1.0), 0.0, 1.0)
    let wa = fp_lift(yn) * 0.8 + 0.06 * hot * (1.0 - down) - 0.05 * down
    var f = vec4(fp_white() * wa, wa)
    let rb = Finish.band(d, 0.0, px, px) * fp_rim(yn, 0.5, 0.55)
    f = Finish.over(f, vec4(fp_white() * rb, rb))
    let dv = Finish.cover(abs(p.y - mid) - px * 0.5, px) * step(b.x + 3.0, p.x) * step(p.x, b.z - 3.0) * 0.10
    f = Finish.over(f, vec4(fp_white() * dv, dv))
    // The marks: stroked chevrons 6 by 3.5 points in a 1.25 point stroke,
    // #e2edf4, each centred in its own key (the font's solid triangles are
    // switched off below).
    let cx = (b.x + b.z) * 0.5
    let cu = vec2(cx, (b.y + mid) * 0.5)
    let cl = vec2(cx, (mid + b.w) * 0.5)
    let up = min(fp_seg(p, cu + vec2(-3.0, 1.75), cu + vec2(0.0, -1.75)), fp_seg(p, cu + vec2(0.0, -1.75), cu + vec2(3.0, 1.75)))
    let dn = min(fp_seg(p, cl + vec2(-3.0, -1.75), cl + vec2(0.0, 1.75)), fp_seg(p, cl + vec2(0.0, 1.75), cl + vec2(3.0, -1.75)))
    let ca = Finish.cover(min(up, dn) - 0.625, px) * mix(1.0, 0.45, self.disabled)
    f = Finish.over(f, vec4(vec3(0.847, 0.878, 0.918) * ca, ca))
    return f * Finish.cover(d, px) * mix(1.0, 0.4, self.disabled)
}
mod.widgets.NumberSpin.width = 20.0
mod.widgets.NumberField.spin_width = 20.0
mod.widgets.NumberSpin.draw_text.color = #0000
mod.widgets.NumberSpin.draw_text.color_disabled = #0000

// The drag-number of a toolbar: the recessed frost, the dragged amount a
// wash of accent light across it, the digits near-white.
mod.widgets.ValueInput.clip_x = false
mod.widgets.ValueInput.clip_y = false
mod.widgets.ValueInput.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.ValueInput.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let f = fp_field(p, self.rect_pos, self.rect_size, px, 4.0, max(self.hover, self.drag), self.focus, 0.0)
    let d = Material.sd_box(p, self.rect_size * 0.5, self.rect_size * 0.5 - vec2(px, px), 4.0)
    let wash = step(0.0, self.fill) * step(p.x, (self.rect_size.x) * max(self.fill, 0.0)) * Finish.cover(d, px) * 0.20
    return Finish.over(f, vec4(fp_acc() * wash, wash))
}
mod.widgets.ValueInput.draw_text.color = #eef6fb
mod.widgets.ValueInput.arrow_color = #bfd0dc
mod.widgets.ValueInput.text_input.draw_bg.color = #00000000

// DROP-DOWNS. The button's frost at a 4 point corner, with a chevron 8 by
// 4.5 in a 1.25 point stroke, 10 points in from the right; open, the foot
// lights as a focus does.
let fp_chevron = fn(under: vec4, p: vec2, s: vec2, px: float, live: float) -> vec4 {
    let c = vec2(s.x - 14.0, s.y * 0.5)
    let ch = min(fp_seg(p, c + vec2(-4.0, -1.75), c + vec2(0.0, 1.75)), fp_seg(p, c + vec2(0.0, 1.75), c + vec2(4.0, -1.75)))
    let a = Finish.cover(ch - 0.625, px) * mix(0.4, 1.0, live)
    return Finish.over(under, vec4(vec3(0.847, 0.878, 0.918) * a, a))
}
mod.widgets.DropDownFlat.clip_x = false
mod.widgets.DropDownFlat.clip_y = false
mod.widgets.DropDownFlat.padding.left = 10.0
mod.widgets.DropDownFlat.padding.right = 26.0
mod.widgets.DropDownFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(8.0, 8.0), self.rect_size + vec2(16.0, 16.0))
}
mod.widgets.DropDownFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(16.0, 16.0)) - vec2(8.0, 8.0)
    let r = self.border_radius
    let f = fp_button(p, self.rect_pos, self.rect_size, px, vec4(r, r, r, r), self.hover, self.down * self.hover, max(self.focus, self.active), self.disabled, 1.0, 1.0, 1.0, fp_rimc(), 0.0)
    return fp_chevron(f, p, self.rect_size, px, 1.0 - self.disabled)
}
// The combo box is a field one types in, so the recessed frost, with the
// same chevron.
mod.widgets.ComboBoxFlat.clip_x = false
mod.widgets.ComboBoxFlat.clip_y = false
mod.widgets.ComboBoxFlat.padding.left = 8.0
mod.widgets.ComboBoxFlat.padding.right = 26.0
mod.widgets.ComboBoxFlat.draw_bg.vertex = fn() {
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(6.0, 6.0), self.rect_size + vec2(12.0, 12.0))
}
mod.widgets.ComboBoxFlat.draw_bg.pixel = fn() {
    let px = 1.0 / max(self.draw_pass.dpi_factor, 0.5)
    let p = self.pos * (self.rect_size + vec2(12.0, 12.0)) - vec2(6.0, 6.0)
    let f = fp_field(p, self.rect_pos, self.rect_size, px, self.border_radius, self.hover, self.focus, self.disabled)
    return fp_chevron(f, p, self.rect_size, px, 1.0 - self.disabled)
}

// ---------------------------------------------------------------------------
// CHECK BOXES AND RADIOS. A 15 point cube of the plastic, corners of 3, or
// a disc. On, the cube is lit from within: cyan through its body, its rim
// cyan all round, and a white tick with a little bloom. Mixed is a short lit
// bar; error turns the light inside rose.
let fp_check = fn(p: vec2, o: vec2, rs: vec2, px: float, sz: float, r: float, at_end: float, hover: float, down: float, focus: float, active: float, mixed: float, err: float, disabled: float) -> vec4 {
    let x0 = (rs.x - sz) * at_end
    let y0 = rs.y * 0.5 - sz * 0.5
    let lo = vec2(Finish.snap(o.x + x0, px), Finish.snap(o.y + y0, px)) - o
    let hi = lo + vec2(Finish.snap(sz, px), Finish.snap(sz, px))
    let on = max(active, mixed)
    let tk = max(active, mixed * 0.6) * (1.0 - err)
    let tone = vec4(vec3(0.20, 0.50, 0.62) * 0.75 * tk, 0.75 * tk)
    let edge = mix(fp_acc_line(), fp_rose(), err)
    let f = fp_plate(p, vec4(lo, hi), vec4(r, r, r, r), px, hover, down, focus, disabled, 1.0, 0.8, 1.0, tone, fp_rimc(), edge, mix(0.55, 1.0, max(on, err)), 0.0, on * (1.0 - err) * 0.8)
    let q = (p - lo) / sz
    let c = (lo + hi) * 0.5
    let live = mix(1.0, 0.45, disabled)
    // The tick: 1.6 points, round ends, white with a cyan bloom.
    let tick = min(fp_seg(q, vec2(0.27, 0.52), vec2(0.44, 0.69)), fp_seg(q, vec2(0.44, 0.69), vec2(0.75, 0.33))) * sz
    let tb = exp(0.0 - max(tick - 0.8, 0.0) * max(tick - 0.8, 0.0) / 1.2) * 0.45 * active * (1.0 - mixed) * live
    var g = Finish.over(f, vec4(fp_acc() * tb, tb))
    let ta = Finish.cover(tick - 0.8, px) * active * (1.0 - mixed) * live
    g = Finish.over(g, vec4(ta, ta, ta, ta))
    // Mixed: a lit bar 7 by 2.
    return fp_beam(g, p, c - vec2(3.0, 0.0), c + vec2(3.0, 0.0), 2.0, px, mixed * live, fp_acc())
}

mod.widgets.CheckBoxFlat.clip_x = false
mod.widgets.CheckBoxFlat.clip_y = false
mod.widgets.CheckBoxFlat.label_walk.margin.left = 14.0
mod.widgets.CheckBoxFlat.draw_bg.size = 15.0
mod.widgets.CheckBoxFlat.draw_bg.border_radius = 3.0

mod.theme = mod.themes.light

// Worn safety-yellow painted steel, black rubber and screws.
// A starter: a sober palette on the light base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #e6c440
mod.theme.color_fg_app = #e6c440
mod.theme.color_bg_container = #e6c440
mod.theme.color_surface_container_lowest = #d2b030

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #eed160
mod.theme.color_outset_1 = #eed160
mod.theme.color_outset_2 = #eed160
mod.theme.color_outset_hover = #f2d978
mod.theme.color_outset_1_hover = #f2d978
mod.theme.color_outset_2_hover = #f2d978
mod.theme.color_outset_down = #d8b634
mod.theme.color_outset_1_down = #d8b634
mod.theme.color_outset_2_down = #d8b634
mod.theme.color_outset_disabled = #e6c440
mod.theme.color_outset_1_disabled = #e6c440
mod.theme.color_outset_2_disabled = #e6c440

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #d2b030
mod.theme.color_inset_1 = #d2b030
mod.theme.color_inset_2 = #d2b030
mod.theme.color_inset_hover = #ccaa2a
mod.theme.color_inset_1_hover = #ccaa2a
mod.theme.color_inset_2_hover = #ccaa2a
mod.theme.color_inset_focus = #ccaa2a
mod.theme.color_inset_1_focus = #ccaa2a
mod.theme.color_inset_2_focus = #ccaa2a
mod.theme.color_inset_active = #ccaa2a
mod.theme.color_inset_1_active = #ccaa2a
mod.theme.color_inset_2_active = #ccaa2a
mod.theme.color_inset_down = #ccaa2a
mod.theme.color_inset_1_down = #ccaa2a
mod.theme.color_inset_2_down = #ccaa2a
mod.theme.color_inset_drag = #d2b030
mod.theme.color_inset_1_drag = #d2b030
mod.theme.color_inset_2_drag = #d2b030
mod.theme.color_inset_empty = #d2b030
mod.theme.color_inset_1_empty = #d2b030
mod.theme.color_inset_2_empty = #d2b030
mod.theme.color_inset_disabled = #e6c440
mod.theme.color_inset_1_disabled = #e6c440
mod.theme.color_inset_2_disabled = #e6c440

// One hairline edge on every face and well.
mod.theme.color_bevel = #6b5a18
mod.theme.color_bevel_inset_1 = #6b5a18
mod.theme.color_bevel_inset_2 = #6b5a18
mod.theme.color_bevel_outset_1 = #6b5a18
mod.theme.color_bevel_outset_2 = #6b5a18
mod.theme.beveling = 0.5

mod.theme.color_text = #1b1a14
mod.theme.color_label = #1b1a14
mod.theme.color_label_inner = #1b1a14
mod.theme.color_label_outer = #1b1a14
mod.theme.color_icon = #1b1a14
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #8a2a0a
mod.theme.color_focus = #8a2a0a
mod.theme.color_ctrl_active = #8a2a0a
mod.theme.color_val = #8a2a0a

mod.theme.color_terminal_bg = #1b1a14
mod.theme.color_terminal_text = #e6c440

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 2.0
mod.theme.container_corner_radius = 4.0
true

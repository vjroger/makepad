mod.theme = mod.themes.dark

// A text interface: one face, one ink, drawn in character cells.
// A starter: a sober palette on the dark base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #0c0f0c
mod.theme.color_fg_app = #0c0f0c
mod.theme.color_bg_container = #0c0f0c
mod.theme.color_surface_container_lowest = #080a08

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #141a14
mod.theme.color_outset_1 = #141a14
mod.theme.color_outset_2 = #141a14
mod.theme.color_outset_hover = #1a221a
mod.theme.color_outset_1_hover = #1a221a
mod.theme.color_outset_2_hover = #1a221a
mod.theme.color_outset_down = #0f130f
mod.theme.color_outset_1_down = #0f130f
mod.theme.color_outset_2_down = #0f130f
mod.theme.color_outset_disabled = #0c0f0c
mod.theme.color_outset_1_disabled = #0c0f0c
mod.theme.color_outset_2_disabled = #0c0f0c

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #080a08
mod.theme.color_inset_1 = #080a08
mod.theme.color_inset_2 = #080a08
mod.theme.color_inset_hover = #060806
mod.theme.color_inset_1_hover = #060806
mod.theme.color_inset_2_hover = #060806
mod.theme.color_inset_focus = #060806
mod.theme.color_inset_1_focus = #060806
mod.theme.color_inset_2_focus = #060806
mod.theme.color_inset_active = #060806
mod.theme.color_inset_1_active = #060806
mod.theme.color_inset_2_active = #060806
mod.theme.color_inset_down = #060806
mod.theme.color_inset_1_down = #060806
mod.theme.color_inset_2_down = #060806
mod.theme.color_inset_drag = #080a08
mod.theme.color_inset_1_drag = #080a08
mod.theme.color_inset_2_drag = #080a08
mod.theme.color_inset_empty = #080a08
mod.theme.color_inset_1_empty = #080a08
mod.theme.color_inset_2_empty = #080a08
mod.theme.color_inset_disabled = #0c0f0c
mod.theme.color_inset_1_disabled = #0c0f0c
mod.theme.color_inset_2_disabled = #0c0f0c

// One hairline edge on every face and well.
mod.theme.color_bevel = #2c3a2c
mod.theme.color_bevel_inset_1 = #2c3a2c
mod.theme.color_bevel_inset_2 = #2c3a2c
mod.theme.color_bevel_outset_1 = #2c3a2c
mod.theme.color_bevel_outset_2 = #2c3a2c
mod.theme.beveling = 0.5

mod.theme.color_text = #b8e6b8
mod.theme.color_label = #b8e6b8
mod.theme.color_label_inner = #b8e6b8
mod.theme.color_label_outer = #b8e6b8
mod.theme.color_icon = #b8e6b8
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #5fd75f
mod.theme.color_focus = #5fd75f
mod.theme.color_ctrl_active = #5fd75f
mod.theme.color_val = #5fd75f

mod.theme.color_terminal_bg = #0c0f0c
mod.theme.color_terminal_text = #b8e6b8

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 0.0
mod.theme.container_corner_radius = 0.0
true

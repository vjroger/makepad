mod.theme = mod.themes.dark

// Porcelain faces on a dark ground, lit from underneath.
// A starter: a sober palette on the dark base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #16181d
mod.theme.color_fg_app = #16181d
mod.theme.color_bg_container = #16181d
mod.theme.color_surface_container_lowest = #101216

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #23262d
mod.theme.color_outset_1 = #23262d
mod.theme.color_outset_2 = #23262d
mod.theme.color_outset_hover = #292d35
mod.theme.color_outset_1_hover = #292d35
mod.theme.color_outset_2_hover = #292d35
mod.theme.color_outset_down = #1d2026
mod.theme.color_outset_1_down = #1d2026
mod.theme.color_outset_2_down = #1d2026
mod.theme.color_outset_disabled = #16181d
mod.theme.color_outset_1_disabled = #16181d
mod.theme.color_outset_2_disabled = #16181d

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #101216
mod.theme.color_inset_1 = #101216
mod.theme.color_inset_2 = #101216
mod.theme.color_inset_hover = #0d0f12
mod.theme.color_inset_1_hover = #0d0f12
mod.theme.color_inset_2_hover = #0d0f12
mod.theme.color_inset_focus = #0d0f12
mod.theme.color_inset_1_focus = #0d0f12
mod.theme.color_inset_2_focus = #0d0f12
mod.theme.color_inset_active = #0d0f12
mod.theme.color_inset_1_active = #0d0f12
mod.theme.color_inset_2_active = #0d0f12
mod.theme.color_inset_down = #0d0f12
mod.theme.color_inset_1_down = #0d0f12
mod.theme.color_inset_2_down = #0d0f12
mod.theme.color_inset_drag = #101216
mod.theme.color_inset_1_drag = #101216
mod.theme.color_inset_2_drag = #101216
mod.theme.color_inset_empty = #101216
mod.theme.color_inset_1_empty = #101216
mod.theme.color_inset_2_empty = #101216
mod.theme.color_inset_disabled = #16181d
mod.theme.color_inset_1_disabled = #16181d
mod.theme.color_inset_2_disabled = #16181d

// One hairline edge on every face and well.
mod.theme.color_bevel = #363a43
mod.theme.color_bevel_inset_1 = #363a43
mod.theme.color_bevel_inset_2 = #363a43
mod.theme.color_bevel_outset_1 = #363a43
mod.theme.color_bevel_outset_2 = #363a43
mod.theme.beveling = 0.5

mod.theme.color_text = #e6e4df
mod.theme.color_label = #e6e4df
mod.theme.color_label_inner = #e6e4df
mod.theme.color_label_outer = #e6e4df
mod.theme.color_icon = #e6e4df
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #9fd3ff
mod.theme.color_focus = #9fd3ff
mod.theme.color_ctrl_active = #9fd3ff
mod.theme.color_val = #9fd3ff

mod.theme.color_terminal_bg = #101216
mod.theme.color_terminal_text = #e6e4df

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 3.0
mod.theme.container_corner_radius = 6.0
true

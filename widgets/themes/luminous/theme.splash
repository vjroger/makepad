mod.theme = mod.themes.dark

// Porcelain faces on a midnight-navy ground, lit from underneath.
// Pale glazed pills float over the ground; what is chosen or held is told
// by light that leaks out from under its lower edge, warm white at the
// core and amber round it, and by navy enamel inlaid in the porcelain.
// Every edge is one device pixel: a light line on top, a dark contact
// line under the bottom, then a navy shadow on the ground. The faces are
// drawn in widgets.splash; this file holds the tokens every face and every
// stock widget reads.
mod.theme.color_bg_app = #0d1630
mod.theme.color_fg_app = #121c38
mod.theme.color_bg_container = #121c38

// The surface ladder: navy slabs a step apart, each carrying the pale ink.
mod.theme.color_surface = #0d1630
mod.theme.color_surface_container = #121c38
mod.theme.color_surface_container_low = #0f1934
mod.theme.color_surface_container_high = #17223f
mod.theme.color_surface_container_highest = #1c2847
mod.theme.color_surface_container_lowest = #080e22
mod.theme.color_surface_dim = #0a1128
mod.theme.color_surface_bright = #223052
mod.theme.color_on_surface = #eef2fb
mod.theme.color_on_surface_variant = #a9b3cb
mod.theme.color_outline = #5d6a8a
mod.theme.color_outline_variant = #2a3656

// Raised faces: porcelain. The middle, top and foot of a glazed cap, for
// any stock face this sheet does not replace.
mod.theme.color_outset = #d6e1f2
mod.theme.color_outset_1 = #dfeafa
mod.theme.color_outset_2 = #cfdbee
mod.theme.color_outset_hover = #dde7f6
mod.theme.color_outset_1_hover = #e6effc
mod.theme.color_outset_2_hover = #d6e1f2
mod.theme.color_outset_focus = #d6e1f2
mod.theme.color_outset_1_focus = #dfeafa
mod.theme.color_outset_2_focus = #cfdbee
mod.theme.color_outset_active = #e4ebf8
mod.theme.color_outset_1_active = #e4ebf8
mod.theme.color_outset_2_active = #e4ebf8
mod.theme.color_outset_down = #ccd7e9
mod.theme.color_outset_1_down = #ccd7e9
mod.theme.color_outset_2_down = #ccd7e9
mod.theme.color_outset_drag = #ccd7e9
mod.theme.color_outset_1_drag = #ccd7e9
mod.theme.color_outset_2_drag = #ccd7e9
mod.theme.color_outset_disabled = #6e7a95
mod.theme.color_outset_1_disabled = #6e7a95
mod.theme.color_outset_2_disabled = #6e7a95

// Wells: navy enamel set into the ground, a clear step lighter than it
// (#122554), so an empty field is a field and not a line.
mod.theme.color_inset = #122554
mod.theme.color_inset_1 = #0f214e
mod.theme.color_inset_2 = #15295a
mod.theme.color_inset_hover = #162a5c
mod.theme.color_inset_1_hover = #162a5c
mod.theme.color_inset_2_hover = #1a2e62
mod.theme.color_inset_focus = #172b5e
mod.theme.color_inset_1_focus = #172b5e
mod.theme.color_inset_2_focus = #1a2e62
mod.theme.color_inset_active = #172b5e
mod.theme.color_inset_1_active = #172b5e
mod.theme.color_inset_2_active = #1a2e62
mod.theme.color_inset_down = #0c1d47
mod.theme.color_inset_1_down = #0c1d47
mod.theme.color_inset_2_down = #0c1d47
mod.theme.color_inset_drag = #122554
mod.theme.color_inset_1_drag = #122554
mod.theme.color_inset_2_drag = #15295a
mod.theme.color_inset_empty = #122554
mod.theme.color_inset_1_empty = #122554
mod.theme.color_inset_2_empty = #15295a
mod.theme.color_inset_disabled = #0e1733
mod.theme.color_inset_1_disabled = #0e1733
mod.theme.color_inset_2_disabled = #0e1733

// The one device pixel edges of a stock face: light on top of a cap, the
// dark contact line under it; dark on top of a well, a light lip under it.
mod.theme.beveling = 0.34
mod.theme.color_bevel = #7f8cab
mod.theme.color_bevel_hover = #7f8cab
mod.theme.color_bevel_focus = #fffcdc
mod.theme.color_bevel_active = #7f8cab
mod.theme.color_bevel_empty = #7f8cab
mod.theme.color_bevel_down = #7f8cab
mod.theme.color_bevel_drag = #7f8cab
mod.theme.color_bevel_disabled = #3a4666
mod.theme.color_bevel_inset_1 = #02061a
mod.theme.color_bevel_inset_2 = #44557c
mod.theme.color_bevel_outset_1 = #f4f9ff
mod.theme.color_bevel_outset_2 = #7f8cab
mod.theme.color_bevel_inset_1_hover = #02061a
mod.theme.color_bevel_inset_2_hover = #44557c
mod.theme.color_bevel_outset_1_hover = #f8fbff
mod.theme.color_bevel_outset_2_hover = #7f8cab
mod.theme.color_bevel_inset_1_focus = #fffcdc
mod.theme.color_bevel_inset_2_focus = #fffcdc
mod.theme.color_bevel_outset_1_focus = #fffcdc
mod.theme.color_bevel_outset_2_focus = #fffcdc
mod.theme.color_bevel_inset_1_down = #02061a
mod.theme.color_bevel_inset_2_down = #44557c
mod.theme.color_bevel_outset_1_down = #7f8cab
mod.theme.color_bevel_outset_2_down = #7f8cab
mod.theme.color_bevel_inset_1_disabled = #3a4666
mod.theme.color_bevel_inset_2_disabled = #3a4666
mod.theme.color_bevel_outset_1_disabled = #3a4666
mod.theme.color_bevel_outset_2_disabled = #3a4666

// Ink. On the ground and in the wells a cool white; on porcelain the navy
// of the enamel. Dim words and disabled ink stay navy-grey, never grey.
mod.theme.color_text = #e6ebf6
mod.theme.color_text_hover = #f2f5fb
mod.theme.color_text_focus = #f2f5fb
mod.theme.color_text_active = #f2f5fb
mod.theme.color_text_down = #e6ebf6
mod.theme.color_text_val = #aab4cc
mod.theme.color_text_disabled = #56617c
mod.theme.color_text_placeholder = #8b97b3
mod.theme.color_text_placeholder_hover = #97a3bd
mod.theme.color_text_meta = #8e98b0
mod.theme.color_text_cursor = #fffbe7
mod.theme.color_cursor = #fffbe7
mod.theme.color_cursor_focus = #fffbe7
mod.theme.color_label = #e6ebf6
mod.theme.color_label_hover = #f2f5fb
mod.theme.color_label_focus = #f2f5fb
mod.theme.color_label_active = #f2f5fb
mod.theme.color_label_down = #e6ebf6
mod.theme.color_label_disabled = #56617c
// Words on a porcelain face.
mod.theme.color_label_inner = #0b1530
mod.theme.color_label_inner_hover = #0b1530
mod.theme.color_label_inner_focus = #0b1530
mod.theme.color_label_inner_active = #0b1530
mod.theme.color_label_inner_down = #16213d
mod.theme.color_label_inner_drag = #16213d
mod.theme.color_label_inner_inactive = #4c5670
mod.theme.color_label_inner_disabled = #3c4760
// Words beside a control, on the ground.
mod.theme.color_label_outer = #dfe5f2
mod.theme.color_label_outer_off = #a3adc4
mod.theme.color_label_outer_hover = #eef2fb
mod.theme.color_label_outer_focus = #eef2fb
mod.theme.color_label_outer_active = #eef2fb
mod.theme.color_label_outer_active_focus = #eef2fb
mod.theme.color_label_outer_down = #dfe5f2
mod.theme.color_label_outer_drag = #dfe5f2
mod.theme.color_label_outer_disabled = #56617c
mod.theme.color_icon = #cfd7e8
mod.theme.color_icon_hover = #eef2fb
mod.theme.color_icon_focus = #cfd7e8
mod.theme.color_icon_active = #eef2fb
mod.theme.color_icon_down = #cfd7e8
mod.theme.color_icon_disabled = #56617c

// The light. Amber is the one hue at rest: a warm-white core #fdfbee, the
// amber #ffc271 round it. The value fills burn warm white in an amber rim.
mod.theme.color_focus = #ffc271
mod.theme.color_ctrl_active = #ffc271
mod.theme.color_val = #ffd78f
mod.theme.color_val_hover = #ffd78f
mod.theme.color_val_focus = #ffd78f
mod.theme.color_val_drag = #ffd78f
mod.theme.color_val_disabled = #3d4764
mod.theme.color_mark_active = #f5f8ff
mod.theme.color_mark_active_hover = #f5f8ff
mod.theme.color_mark_focus = #f5f8ff
mod.theme.color_mark_disabled = #56617c
// The accent seed: the primary, secondary and tertiary families are grown
// from it. It is the enamel's blue lifted off the ground, the quiet fill of
// a chosen row in a stock list; the light stays amber.
mod.theme.color_ctrl_selected = #34589a
mod.theme.color_bg_highlight = #1a2644
mod.theme.color_bg_highlight_inline = #3a3528
mod.theme.color_text_on_accent = #ffffff
// Selected text: amber at a third over the enamel while focused.
mod.theme.color_selection = #00000000
mod.theme.color_selection_hover = #00000000
mod.theme.color_selection_down = #54473f
mod.theme.color_selection_focus = #54473f

mod.theme.color_terminal_bg = #081230
mod.theme.color_terminal_text = #e6ebf6

// SPACING. Rows of 26 points, gaps of 8 between controls, 6 inside a
// group, panels padded 10. The base froze what it derived from the
// factor, so every rung this sheet depends on is stated again.
mod.theme.space_factor = 8.0
mod.theme.space_1 = 4.0
mod.theme.space_2 = 8.0
mod.theme.space_3 = 12.0
mod.theme.space_4 = 16.0
mod.theme.space_5 = 24.0
mod.theme.space_6 = 32.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 4.0 right: 4.0 bottom: 4.0 left: 4.0}
mod.theme.mspace_h_1 = mod.turtle.Inset{top: 0.0 right: 4.0 bottom: 0.0 left: 4.0}
mod.theme.mspace_v_1 = mod.turtle.Inset{top: 4.0 right: 0.0 bottom: 4.0 left: 0.0}
mod.theme.mspace_2 = mod.turtle.Inset{top: 8.0 right: 8.0 bottom: 8.0 left: 8.0}
mod.theme.mspace_h_2 = mod.turtle.Inset{top: 0.0 right: 8.0 bottom: 0.0 left: 8.0}
mod.theme.mspace_v_2 = mod.turtle.Inset{top: 8.0 right: 0.0 bottom: 8.0 left: 0.0}
mod.theme.mspace_3 = mod.turtle.Inset{top: 12.0 right: 12.0 bottom: 12.0 left: 12.0}
mod.theme.mspace_h_3 = mod.turtle.Inset{top: 0.0 right: 12.0 bottom: 0.0 left: 12.0}
mod.theme.mspace_v_3 = mod.turtle.Inset{top: 12.0 right: 0.0 bottom: 12.0 left: 0.0}
mod.theme.size_control_s = 22.0
mod.theme.size_control_m = 26.0
mod.theme.size_control_l = 30.0
mod.theme.tab_height = 26.0
mod.theme.tab_flat_height = 26.0
// Stock shaders draw a corner twice the number written: 3 is the 6 point
// corner of a square cap, 5 the 10 point corner of a panel.
mod.theme.corner_radius = 3.0
mod.theme.container_corner_radius = 5.0
mod.theme.textselection_corner_radius = 1.0
// The radius rungs in true points: caps 6, fields 6, panels and cards 10.
mod.theme.radius_s = 4.0
mod.theme.radius_m = 6.0
mod.theme.radius_l = 10.0

// TYPE. The library's own grotesque at 9 points (12 layout points), so a
// label's cap height is a third of the 26 point row.
mod.theme.font_size_p = 9.0
mod.theme.font_size_base = 9.0

// No surface material: the faces that matter are drawn by the sheet.
mod.theme.material_level = 0.0
mod.theme.material_margin = 0.0
mod.theme.material_glow = 0.0
mod.theme.material_ink_glow = 0.0
mod.theme.color_material_glow = #ffc271
true

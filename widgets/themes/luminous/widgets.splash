mod.widgets.ButtonOutline.draw_bg.pixel = fn() {
    return lu_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 6.0, self.border_dash)
}
mod.widgets.ButtonFlatter.draw_bg.pixel = fn() {
    return lu_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 7.0, 0.0)
}


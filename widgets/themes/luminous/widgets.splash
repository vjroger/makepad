// Tabs: quiet words on the ground, parted by a short device pixel line; the
// tab in use is a porcelain pill 2 points in, lit from under.
mod.widgets.Tabs.height = 26.0
mod.widgets.Tabs.clip_x = false
mod.widgets.Tabs.clip_y = false
let lu_tab = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, active: float) -> vec4 {
    let m = 18.0
    let px = lu_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(lu_snap(1.0, o.x, px), lu_snap(2.0, o.y, px))
    let hi = vec2(lu_snap(size.x - 1.0, o.x, px), lu_snap(size.y - 2.0, o.y, px))
    let r = (hi.y - lo.y) * 0.5
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if active > 0.5 {
        res = lu_cap(p, lo, hi, r, px, hover, 0.0, 0.0, 0.0, 0.8, 0.0, 1.0, 0.0)
    } else {
        // Under the hand, a quiet enamel pill.
        if hover > 0.001 {
            res = lu_inlay(p, lo, hi, r, px, 1.0, 0.0, 0.0, 0.0, 0.5, 0.3) * hover
        }
    }
    return res * lu_fade(pos, size, m)
}
mod.widgets.Tabs.draw_tab.vertex = fn() {
    let m = 18.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_tab_hover.vertex = fn() {
    let m = 18.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_tab_active.vertex = fn() {
    let m = 18.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Tabs.draw_bg.pixel = fn() {
    return vec4(0.0, 0.0, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab.pixel = fn() {
    return lu_tab(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 0.0, 0.0)
}
mod.widgets.Tabs.draw_tab_hover.pixel = fn() {
    return lu_tab(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 1.0, 0.0)
}
mod.widgets.Tabs.draw_tab_active.pixel = fn() {
    return lu_tab(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, 0.0, 1.0)
}
mod.widgets.Tabs.draw_sep.pixel = fn() {
    let px = lu_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    let l = step(x, p.x) * step(p.x, x + px) * step(self.rect_size.y * 0.3, p.y) * step(p.y, self.rect_size.y * 0.7)
    return vec4(0.165, 0.212, 0.337, 1.0) * l
}
mod.widgets.Tabs.draw_mark.color = #6f7c99
mod.widgets.Tabs.draw_text.color = #a3adc4
mod.widgets.Tabs.draw_text_active.color = #0b1530
mod.widgets.Tabs.draw_text.text_style.font_size = 9.0
mod.widgets.Tabs.draw_text_active.text_style.font_size = 9.0

// ---------------------------------------------------------------- feedback

// The progress bar: a 6 point navy well, the fill burning warm white in its
// amber rim with a soft bloom, the whole bar standing in an 8 point row.
mod.widgets.ProgressBarFlat.height = 8.0
mod.widgets.ProgressBarFlat.clip_x = false
mod.widgets.ProgressBarFlat.clip_y = false
mod.widgets.ProgressBarFlat.draw_bg.vertex = fn() {
    let m = 6.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ProgressBarFlat.draw_bg.pixel = fn() {
    let m = 6.0
    let px = lu_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let th = min(6.0, self.rect_size.y)
    let y0 = lu_snap((self.rect_size.y - th) * 0.5, o.y, px)
    let x0 = lu_snap(self.rect_size.x * self.start, o.x, px)
    let x1 = lu_snap(self.rect_size.x * self.end, o.x, px)
    let lo = vec2(x0, y0)
    let hi = vec2(x1, y0 + th)
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    if self.track > 0.5 {
        res = lu_well(p, lo, hi, th * 0.5, px, vec3(0.137, 0.157, 0.22), 0.0, 1.0, 1.0, 0.4)
    }
    let span = hi.x - lo.x - px * 2.0
    var f0 = lo.x + px
    var f1 = f0 + span * clamp((self.value - self.start) / max(self.end - self.start, 0.001), 0.0, 1.0)
    if self.value < 0.0 {
        // Still: the sweep would need the pass clock, which a window at
        // rest does not read, so the unknown is a lit stretch standing in
        // the middle with its ends fading.
        f0 = lo.x + span * 0.3
        f1 = lo.x + span * 0.7
    }
    var fill = lu_fill(vec4(0.0, 0.0, 0.0, 0.0), p, vec2(f0, lo.y + px), vec2(f1, hi.y - px), th * 0.5, px, 0.0, 1.0, 0.0)
    // An intent other than the plain one tints the light with its colour.
    let ic = self.fill_color()
    let tint = step(0.5, self.intent)
    fill = vec4(mix(fill.rgb, fill.rgb * ic.rgb * 1.1, tint * 0.8), fill.a)
    if self.value < 0.0 {
        fill = fill * smoothstep(f0 - 1.0, f0 + span * 0.1, p.x) * smoothstep(f1 + 1.0, f1 - span * 0.1, p.x)
    }
    res = Finish.over(res, fill)
    return res * self.opacity * lu_fade(self.pos, self.rect_size, m)
}

// The level meter: cells 3 points long with 1.5 point gaps in a navy well;
// warm white to 70 %, amber to 90 %, coral past it; unlit cells a ghost; a
// cell held at the peak; the clip lamp a small coral light.
mod.widgets.LevelMeter.draw_bg.pixel = fn() {
    let px = lu_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let sz = self.rect_size
    let p = self.pos * sz
    let v = self.vertical
    let along = mix(sz.x, sz.y, v)
    let across = mix(sz.y, sz.x, v)
    let a = mix(p.x, sz.y - p.y, v)
    let b = mix(p.y, p.x, v)
    let lamp_room = self.lamp * (across + 3.0)
    let bar = max(4.0, along - lamp_room)
    // The well is at most 8 points across, centred in the box.
    let wa = min(across, 8.0)
    let wb0 = (across - wa) * 0.5
    let wlo = mix(vec2(0.0, wb0), vec2(wb0, sz.y - bar), v)
    let whi = mix(vec2(bar, wb0 + wa), vec2(wb0 + wa, sz.y), v)
    let lo = vec2(lu_snap(wlo.x, o.x, px), lu_snap(wlo.y, o.y, px))
    let hi = vec2(lu_snap(whi.x, o.x, px), lu_snap(whi.y, o.y, px) - px)
    var res = lu_well(p, lo, hi, 2.0, px, vec3(0.137, 0.157, 0.22), 0.0, 1.0, 1.0, 0.4)
    let pad = 2.0
    let span = max(1.0, bar - pad * 2.0)
    let pitch = 4.5
    let ca = a - pad
    let cell = Finish.cover(abs(fract(ca / pitch) * pitch - 1.5) - 1.5, px)
    let share = clamp((floor(ca / pitch) * pitch + 1.5) / span, 0.0, 1.0)
    let inb = step(pad, a) * step(a, bar - pad) * step(wb0 + 1.5, b) * step(b, wb0 + wa - 1.5)
    var lit = vec3(0.937, 0.890, 0.776)
    lit = mix(lit, vec3(1.0, 0.761, 0.443), step(max(self.hot_at, 0.7), share))
    lit = mix(lit, vec3(0.988, 0.478, 0.298), step(max(self.hot_to, 0.9), share))
    // Each lit cell's ends a deeper tone of its own light.
    let edge = 1.0 - smoothstep(0.0, 1.2, min(fract(ca / pitch) * pitch, 3.0 - fract(ca / pitch) * pitch))
    lit = mix(lit, lit * vec3(0.8, 0.68, 0.6), edge * 0.5)
    let on = step(share, self.level) * step(0.001, self.level)
    let ghost = vec3(0.2, 0.215, 0.28)
    let col = mix(ghost, lit, on)
    res = Finish.over(res, vec4(col, 1.0) * cell * inb * self.opacity)
    let hold_at = floor((span * self.hold) / pitch) * pitch
    let hc = step(abs(floor(ca / pitch) * pitch - hold_at), 0.1) * step(0.002, self.hold)
    res = Finish.over(res, vec4(vec3(1.0, 0.761, 0.443), 1.0) * hc * cell * inb * 0.8)
    if self.lamp > 0.5 {
        let lc = mix(vec2(bar + 3.0 + across * 0.5, sz.y * 0.5), vec2(sz.x * 0.5, across * 0.5), v)
        let rl = max(across * 0.5 - 2.0, 1.0)
        let ld = Finish.sd_circle(p, lc, rl)
        let over = step(0.5, self.over)
        let halo = exp(-max(ld, 0.0) / 0.8) * (1.0 - Finish.cover(ld, px)) * 0.35 * over
        res = Finish.over(res, vec4(vec3(0.988, 0.478, 0.298) * halo, halo * 0.3))
        let la = Finish.cover(ld, px)
        let lcol = mix(vec3(0.07, 0.1, 0.2), mix(vec3(0.988, 0.478, 0.298), vec3(1.0, 0.94, 0.9), 1.0 - smoothstep(0.0, rl, length(p - lc))), over)
        res = Finish.over(res, vec4(lcol * la, la))
    }
    return res * self.opacity
}

// The spinner keeps the library's own turning face and takes the amber.
mod.widgets.SpinnerFlat.draw_bg.color = #ffc271
mod.widgets.SpinnerFlat.draw_bg.track_alpha = 0.2

// The rings, the arc and the stock bars keep their own faces; the plain
// intent reads amber, so the page has one accent and not a second blue.
mod.widgets.ProgressRingFlat.draw_bg.color_primary = #ffc271
mod.widgets.ProgressRing.draw_bg.color_primary = #ffc271
mod.widgets.ProgressArc.draw_bg.color_primary = #ffc271
mod.widgets.ActivityRings.draw_bg.color_primary = #ffc271
mod.widgets.ProgressBarFlat.draw_bg.color_primary = #ffc271
mod.widgets.ProgressBar.draw_bg.color_primary = #ffc271
mod.widgets.ProgressBarGradientX.draw_bg.color_primary = #ffc271
mod.widgets.ProgressBarGradientY.draw_bg.color_primary = #ffc271

// Words in the error intent beside a check box or a toggle stand on the
// navy ground: a light coral that reads (about 5.5:1), not the stock red.
mod.widgets.CheckBoxFlat.draw_text.color_error = #ff8a7a
mod.widgets.ToggleFlat.draw_text.color_error = #ff8a7a

// ---------------------------------------------------------------- surfaces

// The scroll bar: an 8 point gutter with no fill; the thumb a 5 point
// porcelain pill at a third, a half under the hand. It never glows.
mod.widgets.ScrollBar.bar_size = 8.0
mod.widgets.ScrollBar.bar_side_margin = 1.0
mod.widgets.ScrollBar.draw_bg.pixel = fn() {
    let px = lu_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let sz = self.rect_size
    let p = self.pos * sz
    let v = self.is_vertical
    let t0 = mix(sz.x * self.norm_scroll, sz.y * self.norm_scroll, v)
    let t1 = t0 + mix(sz.x * self.norm_handle, sz.y * self.norm_handle, v)
    let mid = mix(sz.y * 0.5, sz.x * 0.5, v)
    let tlo = mix(vec2(t0, mid - 2.5), vec2(mid - 2.5, t0), v)
    let thi = mix(vec2(t1, mid + 2.5), vec2(mid + 2.5, t1), v)
    let lo = vec2(lu_snap(tlo.x, o.x, px), lu_snap(tlo.y, o.y, px))
    let hi = vec2(lu_snap(thi.x, o.x, px), lu_snap(thi.y, o.y, px))
    let d = Material.sd_box(p, (lo + hi) * 0.5, (hi - lo) * 0.5, 2.5)
    let a = Finish.cover(d, px) * (0.35 + 0.25 * max(self.hover, self.drag))
    return vec4(vec3(0.839, 0.882, 0.949) * a, a) * self.opacity
}

// The grain every navy surface carries: monochrome, one value per two
// device pixels, sd 0.004, laid in the surface's own window space.
let lu_grain = fn(p: vec2, o: vec2, px: float) -> float {
    return Finish.grain((p + o) / (2.0 * px), 0.01)
}
// The sparkle in dark glass: about one device pixel in a hundred a spark of
// white, laid in the panel's own space so it moves with it.
let lu_frit = fn(p: vec2, px: float) -> float {
    let cell = floor(p / px)
    let h = Finish.hash(cell)
    let k = Finish.hash(cell + vec2(17.0, 31.0))
    return step(0.99, h) * (0.08 + 0.05 * k)
}

// A raised panel: a slab of dark navy glass. Its ambient shadow stays
// inside the gap to its neighbours; its face falls from the top with the
// grain and the sparkle; one light device pixel runs along its top.
// `leak` 1 lets the amber light show from behind its lower corners.
let lu_panel = fn(p: vec2, size: vec2, o: vec2, px: float, r: float, hover: float, leak: float) -> vec4 {
    let lo = vec2(lu_snap(0.0, o.x, px), lu_snap(0.0, o.y, px))
    let hi = vec2(lu_snap(size.x, o.x, px), lu_snap(size.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let n = lu_normal(p, c, h, r)
    let amb = Finish.drop(p, c, h - vec2(2.0, 1.0), r, vec2(0.0, 2.5), 2.6) * 0.6
    let con = Finish.drop(p, c, h, r, vec2(0.0, px), px) * 0.8
    // The shadow only falls outside the slab: the slab lets the ground
    // through, and a shadow under it would sink it.
    var res = vec4(0.004, 0.008, 0.035, 1.0) * (1.0 - (1.0 - amb) * (1.0 - con)) * (1.0 - a)
    if leak > 0.001 {
        // The light from behind the card: #f2ba9b at its lower corners and
        // along its foot, warming toward the edge, a reach of 16 points.
        let side = smoothstep(0.3, 1.0, abs(p.x - c.x) / max(h.x, 1.0))
        let low = smoothstep(0.1, 1.0, (p.y - c.y) / max(h.y, 1.0))
        let g = exp(-(max(d, 0.0) * max(d, 0.0)) / (2.0 * 5.3 * 5.3)) * (1.0 - a) * low * (0.4 + 0.6 * side) * 0.5 * leak
        let gc = mix(vec3(0.949, 0.729, 0.608), vec3(1.0, 0.847, 0.66), smoothstep(0.25, 0.5, g))
        res = Finish.over(res, vec4(gc * g, g * 0.5))
    }
    // The slab is dark glass over the ground: the ground shows through at
    // 0.85 and the glass adds its own light, so the panel stands about 0.05
    // over whatever part of the vignette it lies on.
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var col = mix(vec3(0.085, 0.1, 0.145), vec3(0.068, 0.08, 0.12), t) + vec3(0.015, 0.018, 0.03) * hover
    col = col + vec3(1.0, 1.0, 1.0) * (lu_grain(p, o, px) + lu_frit(p, px) * 0.6)
    var face = vec4(col * a, 0.15 * a)
    // The top line at +0.1, and the side edges fading down from it; a dark
    // line under the foot.
    let upper = smoothstep(0.0, 0.9, -n.y)
    let tl = Finish.band(d, 0.0, px, px) * upper
    face = face + vec4(vec3(0.1, 0.11, 0.14) * tl, 0.0)
    let fl = Finish.band(d, 0.0, px, px) * smoothstep(0.2, 0.9, n.y) * 0.8
    face = Finish.over(face, vec4(vec3(0.02, 0.035, 0.09) * fl, fl))
    return Finish.over(res, face)
}
// A tray: the same box sunk into the ground, the ground's rim shading its
// top, a light lip under its foot.
let lu_tray = fn(p: vec2, size: vec2, o: vec2, px: float, r: float) -> vec4 {
    let lo = vec2(lu_snap(0.0, o.x, px), lu_snap(0.0, o.y, px))
    let hi = vec2(lu_snap(size.x, o.x, px), lu_snap(size.y, o.y, px) - px)
    let c = (lo + hi) * 0.5
    let d = Material.sd_box(p, c, (hi - lo) * 0.5, r)
    let n = lu_normal(p, c, (hi - lo) * 0.5, r)
    let a = Finish.cover(d, px)
    var res = vec4(0.29, 0.353, 0.502, 1.0) * Finish.ring_out(d, 0.0, px, px) * smoothstep(0.2, 0.9, n.y) * 0.8
    var col = vec3(0.035, 0.055, 0.129) + vec3(1.0, 1.0, 1.0) * lu_grain(p, o, px) * 0.6
    col = mix(col, vec3(0.004, 0.012, 0.043), 0.6 * (1.0 - smoothstep(0.0, 5.0, p.y - lo.y - px)))
    col = mix(col, vec3(0.008, 0.024, 0.086), Finish.band(d, 0.0, px, px))
    return Finish.over(res, vec4(col * a, a))
}

mod.widgets.PanelView.clip_x = false
mod.widgets.PanelView.clip_y = false
mod.widgets.PanelView.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 10.0 bottom: 10.0}
mod.widgets.PanelView.draw_bg.vertex = fn() {
    let m = 9.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.PanelView.draw_bg.pixel = fn() {
    let m = 9.0
    let px = lu_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    if self.sunken > 0.5 {
        return lu_tray(p, self.rect_size, self.rect_pos, px, 10.0) * lu_fade(self.pos, self.rect_size, m)
    }
    return lu_panel(p, self.rect_size, self.rect_pos, px, 10.0, 0.0, 0.0) * lu_fade(self.pos, self.rect_size, m)
}

// The rounded view keeps the colour its caller gives it, with a true
// corner and, when it is opaque, a one device pixel edge.
mod.widgets.RoundedView.draw_bg.pixel = fn() {
    let px = lu_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let lo = vec2(self.border_inset.x, self.border_inset.y)
    let hi = self.rect_size - vec2(self.border_inset.z, self.border_inset.w)
    let c = (lo + hi) * 0.5
    let h = max((hi - lo) * 0.5, vec2(0.5, 0.5))
    let r = min(2.0 * max(1.0, self.border_radius), min(h.x, h.y))
    let d = Material.sd_box(p, c, h, r)
    var fill = self.color
    if self.color_2.x > -0.5 {
        fill = mix(self.color, self.color_2, mix(self.pos.y, self.pos.x, self.gradient_fill_horizontal))
    }
    var ink = self.border_color
    if self.border_size < 0.01 {
        ink = vec4(0.165, 0.212, 0.337, fill.a)
    }
    let a = Finish.cover(d, px)
    let bd = Finish.band(d, 0.0, max(self.border_size, px), px)
    var col = mix(fill.rgb, ink.rgb, bd * ink.a)
    return vec4(col * a * fill.a, a * fill.a) + vec4(ink.rgb * ink.a, ink.a) * bd * a * (1.0 - fill.a)
}

// The card: its three appearances told apart. Elevated, a glass slab
// standing off the ground; filled, a flat slab a rung lighter; outlined, the
// ground inside one device pixel of edge. Under the hand the light shows
// from behind a pressable card's lower corners.
mod.widgets.Card.clip_x = false
mod.widgets.Card.clip_y = false
mod.widgets.Card.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 10.0 bottom: 10.0}
mod.widgets.Card.draw_bg.vertex = fn() {
    let m = 22.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.Card.draw_bg.pixel = fn() {
    let m = 22.0
    let px = lu_px(self.draw_pass.dpi_factor)
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let fade = lu_fade(self.pos, self.rect_size, m)
    let leak = 1.0 + 0.5 * self.hover
    if self.border_size > 0.01 {
        let o = self.rect_pos
        let lo = vec2(lu_snap(0.0, o.x, px), lu_snap(0.0, o.y, px))
        let hi = vec2(lu_snap(self.rect_size.x, o.x, px), lu_snap(self.rect_size.y, o.y, px))
        let c = (lo + hi) * 0.5
        let h = (hi - lo) * 0.5
        let d = Material.sd_box(p, c, h, 10.0)
        let n = lu_normal(p, c, h, 10.0)
        let ring = Finish.band(d, 0.0, px, px)
        let col = mix(vec3(0.165, 0.212, 0.337), vec3(0.29, 0.353, 0.49), smoothstep(-0.3, 0.9, -n.y))
        let wash = 0.03 * self.hover * Finish.cover(d, px)
        return (vec4(vec3(0.84, 0.88, 0.95) * wash, wash) + vec4(col * ring, ring) * (1.0 - wash)) * fade
    }
    if self.shadow_radius < 0.01 {
        return lu_panel(p, self.rect_size, self.rect_pos, px, 10.0, self.hover + 0.6, 0.0) * fade
    }
    return lu_panel(p, self.rect_size, self.rect_pos, px, 10.0, self.hover, leak) * fade
}

// List rows: 10 points in, a device pixel divider under each; under the
// hand the row lifts a little; the chosen row rises as a slab with the
// light leaking from under its middle.
mod.widgets.ListItem.padding = mod.turtle.Inset{left: 10.0 right: 10.0 top: 0.0 bottom: 0.0}
mod.widgets.ListItem.draw_bg.pixel = fn() {
    let px = lu_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let live = 1.0 - self.disabled
    let yb = lu_snap(self.rect_size.y, o.y, px)
    let div = step(yb - px, p.y) * step(p.y, yb) * step(10.0, p.x) * step(p.x, self.rect_size.x - 10.0)
    var res = vec4(0.165, 0.212, 0.337, 1.0) * div * (1.0 - self.selected)
    let wash = (0.035 * self.hover + 0.02 * self.down) * live
    res = Finish.over(res, vec4(vec3(0.84, 0.88, 0.95) * wash, wash))
    if self.selected > 0.001 {
        let lo = vec2(lu_snap(2.0, o.x, px), lu_snap(2.0, o.y, px))
        let hi = vec2(lu_snap(self.rect_size.x - 2.0, o.x, px), yb - px * 3.0)
        let c = (lo + hi) * 0.5
        let h = (hi - lo) * 0.5
        let d = Material.sd_box(p, c, h, 6.0)
        let a = Finish.cover(d, px)
        let n = lu_normal(p, c, h, 6.0)
        var sl = vec4(0.004, 0.008, 0.035, 1.0) * Finish.drop(p, c, h, 6.0, vec2(0.0, px), px) * 0.8
        sl = Finish.over(sl, lu_spot(p, c.x, hi.y + 0.5, 18.0, 1.0, 0.0))
        var col = mix(vec3(0.122, 0.173, 0.302), vec3(0.098, 0.141, 0.259), clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0))
        col = mix(col, vec3(0.2, 0.259, 0.388), Finish.band(d, 0.0, px, px) * smoothstep(0.0, 0.9, -n.y))
        col = mix(col, vec3(0.447, 0.482, 0.596), Finish.band(d, 0.0, px, px) * smoothstep(0.2, 0.9, n.y))
        sl = Finish.over(sl, vec4(col * a, a))
        res = mix(res, sl, self.selected)
    }
    return res
}
mod.widgets.ListItem.draw_text.color = #e6ebf6
mod.widgets.ListItem.draw_text_2.color = #8e98b0

// A chip is a small seated porcelain pill; its role colour only warms or
// cools the glaze a touch. Its label is a cap label.
mod.widgets.ChipFlat.draw_text.text_style.font_size = 9.0
// A chip's ink comes from its role palette: navy on the glaze whatever the
// role, the meaning kept for the error chip.
mod.widgets.ChipFlat.palette.on_neutral = #0b1530
mod.widgets.ChipFlat.palette.on_neutral_container = #0b1530
mod.widgets.ChipFlat.palette.neutral = #0b1530
mod.widgets.ChipFlat.palette.on_primary = #0b1530
mod.widgets.ChipFlat.palette.on_primary_container = #0b1530
mod.widgets.ChipFlat.palette.primary = #0b1530
mod.widgets.ChipFlat.palette.on_secondary_container = #0b1530
mod.widgets.ChipFlat.palette.on_tertiary_container = #0b1530
mod.widgets.ChipFlat.draw_bg.vertex = fn() {
    let m = 16.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}
mod.widgets.ChipFlat.draw_bg.pixel = fn() {
    let m = 16.0
    let px = lu_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * (self.rect_size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(lu_snap(0.0, o.x, px), lu_snap(0.0, o.y, px))
    let hi = vec2(lu_snap(self.rect_size.x, o.x, px), lu_snap(self.rect_size.y, o.y, px))
    let spot = 0.4 * self.hover + 0.35 * self.down
    var res = lu_cap(p, lo, hi, (hi.y - lo.y) * 0.5, px, self.hover, self.down, 0.0, self.keyed, 0.0, 0.0, spot, 0.0)
    return res * lu_fade(self.pos, self.rect_size, m)
}

// A count is a small porcelain pill with navy figures.
mod.widgets.BadgePalette.neutral = #d6e1f2
mod.widgets.BadgePalette.on_neutral = #0b1530
mod.widgets.BadgeFlat.draw_bg.pixel = fn() {
    let px = lu_px(self.draw_pass.dpi_factor)
    let o = self.rect_pos
    let p = self.pos * self.rect_size
    let lo = vec2(lu_snap(0.0, o.x, px), lu_snap(0.0, o.y, px))
    let hi = vec2(lu_snap(self.rect_size.x - px * 0.49, o.x, px), lu_snap(self.rect_size.y - px * 0.49, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let r = min(h.x, h.y)
    let d = Material.sd_box(p, c, h, r)
    let n = lu_normal(p, c, h, r)
    let t = clamp((p.y - lo.y) / max(hi.y - lo.y, 1.0), 0.0, 1.0)
    var col = self.color.rgb + vec3(0.03, 0.03, 0.02) * (1.0 - t) - vec3(0.02, 0.02, 0.02) * t
    let ring = Finish.band(d, 0.0, px, px)
    col = mix(col, mix(vec3(0.498, 0.549, 0.671), vec3(0.961, 0.98, 1.0), smoothstep(-0.35, 0.35, -n.y)), ring)
    let a = Finish.cover(d, px) * max(self.color.a, ring)
    return vec4(col * a, a)
}

// Dividers never glow: one device pixel a step above the ground.
mod.widgets.Hr.draw_bg.pixel = fn() {
    let px = lu_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let y = Finish.snap(self.rect_pos.y + self.rect_size.y * 0.5, px) - self.rect_pos.y
    return vec4(0.165, 0.212, 0.337, 1.0) * step(y, p.y) * step(p.y, y + px)
}
mod.widgets.Vr.draw_bg.pixel = fn() {
    let px = lu_px(self.draw_pass.dpi_factor)
    let p = self.pos * self.rect_size
    let x = Finish.snap(self.rect_pos.x + self.rect_size.x * 0.5, px) - self.rect_pos.x
    return vec4(0.165, 0.212, 0.337, 1.0) * step(x, p.x) * step(p.x, x + px)
}


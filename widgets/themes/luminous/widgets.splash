    let hi = vec2(lu_snap(self.rect_size.x, o.x, px), lu_snap(self.rect_size.y, o.y, px))
    return lu_cap(p, lo, hi, (hi.y - lo.y) * 0.5, px, 0.0, 0.0, 0.0, 0.0, 0.5, 0.0, 1.0, 0.0) * lu_fade(self.pos, self.rect_size, m)
}

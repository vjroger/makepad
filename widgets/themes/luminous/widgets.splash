use mod.prelude.widgets_internal.*

// Porcelain faces on a midnight-navy ground, lit from underneath. Every
// face is drawn in true points (one device pixel is `px`); every shadow,
// lip and leak of light falls OUTSIDE the layout box: the quad is grown in
// `vertex`, the templates that throw light or shadow stop clipping, and no
// padding is spent on either.

// ---------------------------------------------------------------- helpers

// One device pixel in points.
let lu_px = fn(dpi: float) -> float {
    return 1.0 / max(dpi, 0.5)
}

// An edge rounded to a whole device pixel in window space, handed back in
// box space: a hairline on it lands on one pixel row.
let lu_snap = fn(v: float, o: float, px: float) -> float {
    return Finish.snap(o + v, px) - o
}

// Distance from p to the segment a..b, in points.
let lu_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// The ground the controls stand on, for a face that fades toward it.
let lu_ground = fn() -> vec3 {
    return vec3(0.051, 0.086, 0.188)
}

// Which way the outline of a rounded box faces at p: the edge lines follow
// it, so a pill gets arcs where a square cap gets straight lines.
let lu_normal = fn(p: vec2, c: vec2, h: vec2, r: float) -> vec2 {
    let s = vec2(step(0.0, p.x - c.x) * 2.0 - 1.0, step(0.0, p.y - c.y) * 2.0 - 1.0)
    let q = abs(p - c) - (h - vec2(r, r))
    let qc = max(q, vec2(0.0, 0.0))
    var n = vec2(0.0, s.y)
    if q.x > q.y {
        n = vec2(s.x, 0.0)
    }
    if q.x > 0.0 && q.y > 0.0 {
        n = qc / max(length(qc), 0.0001) * s
    }
    return n
}

// Anything drawn in a grown quad fades out over its last 3 points, so a
// soft light never ends on a hard edge where the quad stops.
let lu_fade = fn(pos: vec2, size: vec2, m: float) -> float {
    let q = pos * (size + vec2(2.0 * m, 2.0 * m))
    let e = min(min(q.x, q.y), min(size.x + 2.0 * m - q.x, size.y + 2.0 * m - q.y))
    return smoothstep(0.0, 5.0, e)
}

// The light that leaks out from under a control's lower edge: a warm-white
// core on the edge's middle, amber round it, a deep amber tail that dies
// on the ground. `hh` is the control height it is sized by, `s` its
// strength, `hue` 0 amber, 1 coral (danger only). Premultiplied, nearly
// additive: light is laid on the ground, it does not cover it.
let lu_spot = fn(p: vec2, cx: float, by: float, hh: float, s: float, hue: float) -> vec4 {
    let dx = p.x - cx
    let dy = p.y - by
    let sx = 0.34 * hh
    let sy = 0.09 * hh
    let tx = 0.55 * hh
    let ty = 0.3 * hh
    let core = exp(-(dx * dx) / (2.0 * sx * sx) - (dy * dy) / (2.0 * sy * sy))
    let tail = exp(-(dx * dx) / (2.0 * tx * tx) - (dy * dy) / (2.0 * ty * ty))
    let g = clamp((0.9 * core + 0.75 * tail) * s, 0.0, 1.0)
    // The tail #f1ac69, the half-way ring #ffc271, the core #fffce4: warm
    // all the way in, never a white. Toward the core the light covers what
    // is under it, so the navy does not push the core past its colour.
    let deep = mix(vec3(0.945, 0.675, 0.412), vec3(0.847, 0.333, 0.227), hue)
    let mid = mix(vec3(1.0, 0.761, 0.443), vec3(0.988, 0.478, 0.298), hue)
    let hot = mix(vec3(1.0, 0.988, 0.894), vec3(1.0, 0.941, 0.918), hue)
    var col = mix(deep, mid, smoothstep(0.1, 0.5, g))
    col = mix(col, hot, smoothstep(0.65, 1.0, g))
    return vec4(col * g, g * mix(0.25, 1.0, smoothstep(0.6, 1.0, g)))
}

// What a raised control throws on the ground: a navy-black ambient shadow
// that falls down with a negative spread, and a tight contact shadow one
// device pixel under the edge. Sized by the control's height up to a 26
// point row and no further. Returns the coverage.
let lu_shadow = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, sh_h: float, lift: float, hover: float, down: float, dis: float) -> float {
    let amb = Finish.drop(p, c, h - vec2(0.07 * sh_h, 0.05 * sh_h), r, vec2(0.0, (0.12 + 0.03 * hover) * sh_h), 0.13 * sh_h) * (0.55 + 0.12 * hover) * lift * (1.0 - down) * (1.0 - 0.6 * dis)
    let con = Finish.drop(p, c, h, r, vec2(0.0, px), px) * 0.8 * (1.0 - 0.5 * dis)
    return 1.0 - (1.0 - amb) * (1.0 - con)
}

// The amber leak from BEHIND a focused control, all round it, heavier
// below, and the reach 0.4H. Premultiplied, laid under the face.
let lu_leak = fn(d: float, n: vec2, sh_h: float, a: float) -> vec4 {
    let s = 0.16 * sh_h
    let g = exp(-(max(d, 0.0) * max(d, 0.0)) / (2.0 * s * s)) * (1.0 - a) * (0.55 + 0.45 * clamp(n.y, 0.0, 1.0))
    // The body #f5c48a, a paler warm close to the rim, the tail #f1ac69.
    var col = mix(vec3(0.945, 0.675, 0.412), vec3(0.961, 0.769, 0.541), smoothstep(0.15, 0.5, g))
    col = mix(col, vec3(1.0, 0.925, 0.78), smoothstep(0.75, 1.0, g))
    return vec4(col * g * 0.9, g * 0.7)
}

// A porcelain cap: its shadows, the light from under it, the glazed face
// with its quiet fall, one light device pixel on top and the dark contact
// line under the bottom. `lift` 1 casts the ambient shadow, 0 seats the cap
// with the contact shadow only; `tone` 0 the cool porcelain, 1 the violet;
// `spot` the strength of the light from under it; `hue` its colour.
let lu_cap = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float, down: float, dis: float, focus: float, lift: float, tone: float, spot: float, hue: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let sh_h = min(hh, 26.0)
    let d = Material.sd_box(p, c, h, r)
    let live = 1.0 - dis
    let up = (1.0 - down) * live
    let a = Finish.cover(d, px)
    let n = lu_normal(p, c, h, r)
    var res = vec4(0.004, 0.008, 0.035, 1.0) * lu_shadow(p, c, h, r, px, sh_h, lift, hover, down, dis)
    let lit = spot * live
    if lit > 0.001 {
        res = Finish.over(res, lu_spot(p, c.x, hi.y + 0.02 * sh_h, sh_h, lit, hue))
    }
    let fo = focus * live
    if fo > 0.001 {
        res = Finish.over(res, lu_leak(d, n, sh_h, a) * fo)
    }
    // The glaze: a fall of about 0.06 from top to foot (#e3ecfb to #d0dbef);
    // the depth is told by the shadows, not by the face.
    let t = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    let top = mix(vec3(0.890, 0.925, 0.984), vec3(0.871, 0.867, 0.937), tone)
    let bot = mix(vec3(0.816, 0.859, 0.937), vec3(0.796, 0.788, 0.886), tone)
    var face = mix(top, bot, smoothstep(0.0, 1.0, t))
    // The gloss is in the edges: the glaze brightens just inside the top
    // and darkens a little where the pill turns under at its foot.
    let inside = -d
    let upper0 = smoothstep(-0.35, 0.35, -n.y)
    face = face + vec3(0.014, 0.012, 0.008) * (1.0 - smoothstep(0.0, 0.15 * hh, inside)) * upper0
    face = face - vec3(0.018, 0.016, 0.012) * (1.0 - smoothstep(0.0, 0.12 * hh, inside)) * smoothstep(0.1, 0.9, n.y)
    face = face + vec3(0.03, 0.03, 0.03) * hover * up
    // Held: a shade lower and a shade falling from the top edge.
    let shade = 0.08 * (1.0 - smoothstep(0.0, 0.3 * hh, p.y - lo.y))
    face = mix(face, face - vec3(0.06 + shade, 0.06 + shade, 0.05 + shade), down * live)
    // A light kept 0.04 up the right side, where a rim catches the key.
    face = face + vec3(0.03, 0.03, 0.03) * smoothstep(0.4, 1.0, n.x) * Finish.band(d, 0.0, px * 3.0, px) * up
    // Chosen (the light from under at full): the first part of the light
    // is inside the pill, so a row that clips its foot still says chosen.
    // A 2 dp hot line along the inner foot over the middle 0.6W, and the
    // glaze warmed amber over its lowest quarter.
    let inl = smoothstep(0.85, 1.0, spot) * live
    if inl > 0.001 {
        let wx = abs(p.x - c.x) / max(h.x, 1.0)
        let low = 1.0 - smoothstep(0.0, 0.25 * hh, hi.y - p.y)
        let warm = low * (1.0 - smoothstep(0.35, 0.95, wx)) * inl
        face = mix(face, vec3(1.0, 0.761, 0.443), 0.25 * warm) + vec3(0.06, 0.05, 0.02) * warm
        let hot = Finish.band(d, px, px * 3.0, px) * smoothstep(0.3, 0.9, n.y) * (1.0 - smoothstep(0.5, 0.7, wx)) * inl
        face = mix(min(face, vec3(1.0, 1.0, 1.0)), vec3(1.0, 0.988, 0.894), hot)
    }
    face = mix(face, lu_ground(), 0.5 * dis)
    // The edge: light on top, the contact line below; held, the light
    // line goes out; focused, the whole rim burns hot.
    let ring = Finish.band(d, 0.0, px, px)
    let upper = smoothstep(-0.35, 0.35, -n.y)
    let hl = mix(vec3(0.961, 0.980, 1.0), vec3(1.0, 1.0, 1.0), hover)
    let cl = mix(vec3(0.498, 0.549, 0.671), vec3(0.459, 0.447, 0.576), tone)
    var edge = mix(cl, mix(hl, face - vec3(0.06, 0.06, 0.05), down), upper)
    edge = mix(edge, face, 0.6 * dis)
    edge = mix(edge, vec3(1.0, 0.988, 0.863), fo)
    face = mix(face, edge, ring)
    return Finish.over(res, vec4(face * a, a))
}

// Navy enamel inlaid in porcelain: the porcelain body shows as a light lip
// under the enamel's foot, a dark line above the lip, the navy face falling
// to its foot, a top rim half way between the light and the navy.
let lu_inlay = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float, down: float, dis: float, focus: float, lift: float, spot: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let sh_h = min(hh, 26.0)
    let live = 1.0 - dis
    let lipw = mix(px * 2.0, px, down)
    let body = Material.sd_box(p, c + vec2(0.0, lipw * 0.5), h + vec2(0.0, lipw * 0.5), r)
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let ab = Finish.cover(body, px)
    let n = lu_normal(p, c, h, r)
    var res = vec4(0.004, 0.008, 0.035, 1.0) * lu_shadow(p, c + vec2(0.0, lipw * 0.5), h + vec2(0.0, lipw * 0.5), r, px, sh_h, lift, hover, down, dis)
    let lit = spot * live
    if lit > 0.001 {
        res = Finish.over(res, lu_spot(p, c.x, hi.y + lipw + 0.05 * sh_h, sh_h, lit, 0.0))
    }
    let fo = focus * live
    if fo > 0.001 {
        res = Finish.over(res, lu_leak(body, n, sh_h, ab) * fo)
    }
    // The porcelain lip, brightest under the middle of the foot.
    let lip_col = mix(vec3(0.824, 0.886, 0.988), lu_ground(), 0.55 * dis)
    let lipa = ab * (1.0 - a) * smoothstep(c.y, hi.y, p.y)
    res = Finish.over(res, vec4(lip_col * lipa, lipa))
    // The enamel.
    let t = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    var face = mix(vec3(0.051, 0.110, 0.231), vec3(0.016, 0.090, 0.208), smoothstep(0.0, 0.45, t))
    face = mix(face, vec3(0.016, 0.075, 0.196), smoothstep(0.45, 1.0, t))
    face = face + vec3(0.04, 0.045, 0.10) * hover * (1.0 - down) * live
    face = face - vec3(0.012, 0.02, 0.03) * down * live
    face = mix(face, lu_ground(), 0.55 * dis)
    let ring = Finish.band(d, 0.0, px, px)
    let upper = smoothstep(-0.35, 0.35, -n.y)
    var edge = mix(vec3(0.0, 0.039, 0.141), mix(vec3(0.231, 0.294, 0.427), face, down * 0.7), upper)
    edge = mix(edge, face, 0.6 * dis)
    edge = mix(edge, vec3(1.0, 0.965, 0.839), fo)
    face = mix(face, edge, ring)
    return Finish.over(res, vec4(face * a, a))
}

// The track of a switch that is ON: a lifted navy #16275a, clear of any
// ground, a 1 dp porcelain rim #d2e2fc at 0.6 all round, and the amber
// light glowing out from under it at half strength, reaching 6 points,
// heavier below. Under the hand or held the glow grows.
let lu_ontrack = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float, down: float, dis: float, focus: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let sh_h = min(hh, 26.0)
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let n = lu_normal(p, c, h, r)
    let live = 1.0 - dis
    var res = vec4(0.004, 0.008, 0.035, 1.0) * Finish.drop(p, c, h, r, vec2(0.0, px), px) * 0.8 * (1.0 - 0.5 * dis)
    let gs = 2.2
    let g = exp(-(max(d, 0.0) * max(d, 0.0)) / (2.0 * gs * gs)) * (1.0 - a) * (0.3 + 0.7 * smoothstep(-0.2, 0.9, n.y)) * 0.5 * (1.0 + 0.3 * hover + 0.5 * down) * live
    let gc = mix(vec3(0.945, 0.675, 0.412), vec3(1.0, 0.761, 0.443), smoothstep(0.1, 0.4, g))
    res = Finish.over(res, vec4(gc * g, g * 0.6))
    let fo = focus * live
    if fo > 0.001 {
        res = Finish.over(res, lu_leak(d, n, sh_h, a) * fo)
    }
    let t = clamp((p.y - lo.y) / max(hh, 1.0), 0.0, 1.0)
    var face = mix(vec3(0.110, 0.184, 0.408), vec3(0.086, 0.153, 0.353), smoothstep(0.0, 0.5, t))
    face = mix(face, vec3(0.071, 0.129, 0.318), smoothstep(0.5, 1.0, t))
    face = face + vec3(0.03, 0.035, 0.06) * hover * (1.0 - down) * live - vec3(0.02, 0.025, 0.04) * down * live
    face = mix(face, lu_ground(), 0.55 * dis)
    let ring = Finish.band(d, 0.0, px, px)
    var edge = mix(face, vec3(0.824, 0.886, 0.988), 0.6 * (1.0 - 0.6 * dis))
    edge = mix(edge, vec3(1.0, 0.988, 0.863), fo)
    face = mix(face, edge, ring)
    return Finish.over(res, vec4(face * a, a))
}

// A well sunk into the ground: its fill, its top shaded where the rim of
// the ground stands over it, a dark top line, and a light lip on the
// ground under its foot. `lip` 0 drops the lip. `grey` 0 is the navy
// enamel of a field (#122554, dark line #000a24), 1 the dark-variant track
// (#232838, dark line #0b0d14, lip #48494d); either stands at least 0.04
// off the ground round it. `sh` is the strength of the shade under the top.
let lu_well = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, fill: vec3, dis: float, lip: float, grey: float, sh: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let d = Material.sd_box(p, c, h, r)
    let n = lu_normal(p, c, h, r)
    let lipa = Finish.ring_out(d, 0.0, px, px) * smoothstep(0.2, 0.9, n.y) * lip * (1.0 - 0.6 * dis)
    var res = vec4(mix(vec3(0.353, 0.424, 0.588), vec3(0.282, 0.286, 0.302), grey), 1.0) * lipa * 0.9
    let dark = mix(vec3(0.0, 0.039, 0.141), vec3(0.043, 0.051, 0.078), grey)
    let top = p.y - lo.y
    let shade = sh * (1.0 - smoothstep(0.02 * hh + px, 0.2 * hh + px * 2.0, top))
    var col = mix(fill, dark, shade)
    let ring = Finish.band(d, 0.0, px, px)
    col = mix(col, mix(dark, mix(vec3(0.2, 0.25, 0.37), vec3(0.24, 0.25, 0.28), grey), smoothstep(-0.2, 0.9, n.y)), ring)
    col = mix(col, lu_ground(), 0.4 * dis)
    let a = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a, a))
}

// A lit value inside a well: a warm-white core burning in a one device
// pixel amber rim, a deeper amber band inside the rim where the fill is
// tall enough, and a soft bloom round it. `glow` scales the bloom. At rest
// the core is a cream #efe3c6; `hot` (the hand on it, a drag, focus) takes
// it to the white-hot #fffce4, so the thing in use is the brightest.
let lu_fill = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, r: float, px: float, dis: float, glow: float, hot: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = max((hi - lo) * 0.5, vec2(0.01, 0.01))
    let d = Material.sd_box(p, c, h, min(r, min(h.x, h.y)))
    let a = Finish.cover(d, px)
    let live = 1.0 - dis
    let bl = exp(-(max(d, 0.0) * max(d, 0.0)) / (2.0 * 1.6 * 1.6)) * (1.0 - a) * glow * live * step(0.5, h.x)
    var res = Finish.over(dst, vec4(vec3(1.0, 0.761, 0.443) * bl * 0.6, bl * 0.15))
    var col = mix(vec3(0.937, 0.890, 0.776), vec3(1.0, 0.988, 0.894), hot)
    let band = Finish.band(d, px, px + max(0.0, min(1.5, (hi.y - lo.y) * 0.1 - 0.4)), px)
    col = mix(col, vec3(0.804, 0.667, 0.349), band * 0.7)
    col = mix(col, vec3(1.0, 0.843, 0.561), Finish.band(d, 0.0, px, px))
    col = mix(col, vec3(0.33, 0.37, 0.48), dis)
    return Finish.over(res, vec4(col * a, a))
}

// The three-quarter arc a waiting button turns in place of its label.
let lu_spinner = fn(dst: vec4, p: vec2, c: vec2, rad: float, t: float, amt: float, stroke: float, ink: vec3) -> vec4 {
    let sdf = Sdf2d.viewport(p)
    let a0 = t * 2.0 * PI
    sdf.arc_round_caps(c.x, c.y, rad, a0, a0 + 1.5 * PI, stroke)
    sdf.fill(vec4(ink, amt))
    return Finish.over(dst, sdf.result)
}

// ---------------------------------------------------------------- buttons

// Every button is a slim porcelain pill: 26 points on a 12 point line, 12
// points either side. Its shadow and its light fall outside the box.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.min_height = 26.0
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
// The size rungs keep heights of their own.
mod.widgets.ButtonXs.min_height = 18.0
mod.widgets.ButtonSm.min_height = 22.0
mod.widgets.ButtonLg.min_height = 30.0
mod.widgets.ButtonXl.min_height = 34.0
mod.widgets.ButtonFlat.draw_bg.border_radius = 6.5
mod.widgets.ButtonFlat.draw_bg.border_size = 0.34
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 18.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// The lit primary: a peach face burning from inside, a warm-white bloom in
// its middle, an amber band round its rim, and an orange glow on the ground
// under it. The one control lit at rest.
let lu_lit = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float, down: float, dis: float, focus: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let sh_h = min(hh, 26.0)
    let d = Material.sd_box(p, c, h, r)
    let a = Finish.cover(d, px)
    let n = lu_normal(p, c, h, r)
    let live = 1.0 - dis
    var res = vec4(0.004, 0.008, 0.035, 1.0) * lu_shadow(p, c, h, r, px, sh_h, 1.0, hover, down, dis) * (1.0 - 0.5 * live)
    // The glow thrown on the ground: weak at the sides, longer below.
    let dg = Material.sd_box(p, c + vec2(0.0, 0.08 * sh_h), h - vec2(2.0, 1.0), r)
    let gs = 0.17 * sh_h
    let side = 0.3 + 0.7 * smoothstep(-0.2, 0.9, n.y)
    let g = exp(-(max(dg, 0.0) * max(dg, 0.0)) / (2.0 * gs * gs)) * (1.0 - a) * side * (0.75 + 0.2 * hover - 0.3 * down) * live
    let gcol = mix(vec3(0.424, 0.153, 0.031), vec3(1.0, 0.416, 0.11), smoothstep(0.05, 0.6, g))
    res = Finish.over(res, vec4(gcol * g, g * 0.45))
    if focus * live > 0.001 {
        res = Finish.over(res, lu_leak(d, n, sh_h, a) * focus * live)
    }
    // The face: a saturated orange #ff5f0e warming to #ff6a1c in the
    // middle, lit from inside its edge by a band 0.15H wide going from
    // #fca879 at the rim into the face, strongest at the top.
    let upper = smoothstep(-0.35, 0.35, -n.y)
    let q = (p - c) / vec2(max(h.x * 0.8, 1.0), max(h.y * 0.95, 1.0))
    let bloom = exp(-dot(q, q) * 1.2) * (0.8 + 0.2 * hover - 0.4 * down)
    var face = mix(vec3(1.0, 0.373, 0.055), vec3(1.0, 0.416, 0.11), bloom)
    face = face + vec3(0.0, 0.05, 0.04) * hover * live
    let eg = 1.0 - smoothstep(0.0, 0.15 * hh, -d)
    face = mix(face, vec3(0.988, 0.659, 0.475), eg * (0.5 + 0.5 * upper))
    face = face - vec3(0.05, 0.06, 0.03) * down * live
    face = mix(face, mix(vec3(0.42, 0.40, 0.44), lu_ground(), 0.3), dis)
    // The rim: #e9b092 on top, the lighter #ffd9bf two pixels at the foot.
    let ring = Finish.band(d, 0.0, px, px)
    let foot = Finish.band(d, 0.0, px * 2.0, px) * smoothstep(0.3, 0.9, n.y)
    var edge = mix(vec3(1.0, 0.851, 0.749), vec3(0.914, 0.69, 0.573), upper)
    edge = mix(edge, face, dis)
    edge = mix(edge, vec3(1.0, 0.988, 0.863), focus * live)
    face = mix(face, edge, max(ring, foot * (1.0 - dis)))
    return Finish.over(res, vec4(face * a, a))
}

// The button and its variants share one face; `kind` picks it: 0 seated
// porcelain, 1 raised porcelain, 2 lit primary, 3 navy inlay, 4 violet
// porcelain, 5 danger, 6 outline, 7 flatter.
let lu_button = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, dis: float, focus: float, loading: float, anim: float, kind: float, dash: float) -> vec4 {
    let m = 18.0
    let px = lu_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(lu_snap(0.0, o.x, px), lu_snap(0.0, o.y, px))
    let hi = vec2(lu_snap(size.x, o.x, px), lu_snap(size.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    // Pills; an icon alone gets a square cap with a 0.23H corner.
    var r = min(h.x, h.y)
    if size.x < size.y * 1.35 {
        r = 0.23 * hh
    }
    let live = 1.0 - dis
    let spot = (0.4 * hover + 0.35 * down) * (1.0 - step(0.5, dis))
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    var ink = vec3(0.043, 0.082, 0.188)
    if kind > 5.5 {
        let d = Material.sd_box(p, c, h, r)
        let a = Finish.cover(d, px)
        let n = lu_normal(p, c, h, r)
        let sh_h = min(hh, 26.0)
        if spot > 0.001 {
            res = lu_spot(p, c.x, hi.y + 0.05 * sh_h, sh_h, spot, 0.0)
        }
        if focus * live > 0.001 {
            res = Finish.over(res, lu_leak(d, n, sh_h, a) * focus * live)
        }
        // A faint porcelain wash under the hand, deeper when held.
        let wash = (0.08 * hover + 0.05 * down) * live
        res = Finish.over(res, vec4(vec3(0.84, 0.88, 0.95) * wash * a, wash * a))
        if kind < 6.5 {
            // Outline: one device pixel of porcelain grey, lighter on top.
            var ring = Finish.band(d, 0.0, px, px)
            if dash > 0.0 {
                ring = ring * step(0.5, fract((p.x + p.y) / (dash * 2.0)))
            }
            let col = mix(vec3(0.49, 0.545, 0.667), vec3(0.72, 0.77, 0.87), smoothstep(-0.35, 0.35, -n.y))
            let ra = ring * mix(1.0, 0.4, dis)
            res = Finish.over(res, vec4(col * ra, ra))
        }
        let fr = Finish.band(d, 0.0, px, px) * focus * live
        res = Finish.over(res, vec4(vec3(1.0, 0.988, 0.863) * fr, fr))
        ink = vec3(0.89, 0.91, 0.965)
    } else {
        if kind > 1.5 && kind < 2.5 {
            res = lu_lit(p, lo, hi, 0.23 * hh, px, hover, down, dis, focus)
            ink = vec3(0.122, 0.102, 0.09)
        } else {
            if kind > 2.5 && kind < 3.5 {
                res = lu_inlay(p, lo, hi, r, px, hover, down, dis, focus, 1.0, spot)
                ink = vec3(0.96, 0.973, 1.0)
            } else {
                var lift = 1.0
                if kind < 0.5 {
                    lift = 0.0
                }
                var tone = 0.0
                if kind > 3.5 && kind < 4.5 {
                    tone = 1.0
                }
                var hue = 0.0
                if kind > 4.5 {
                    hue = 1.0
                }
                res = lu_cap(p, lo, hi, r, px, hover, down, dis, focus, lift, tone, spot, hue)
            }
        }
    }
    if loading > 0.001 {
        let rad = max(min(h.x, h.y) - 5.5, 2.0)
        res = lu_spinner(res, p, c, rad, anim, loading, 1.5, ink)
    }
    return res * lu_fade(pos, size, m)
}

mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    return lu_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 0.0, 0.0)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    return lu_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 1.0, 0.0)
}
mod.widgets.ButtonPrimary.draw_bg.pixel = fn() {
    return lu_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 2.0, 0.0)
}
mod.widgets.ButtonSecondary.draw_bg.pixel = fn() {
    return lu_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 3.0, 0.0)
}
mod.widgets.ButtonTertiary.draw_bg.pixel = fn() {
    return lu_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 4.0, 0.0)
}
mod.widgets.ButtonDanger.draw_bg.pixel = fn() {
    return lu_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 5.0, 0.0)

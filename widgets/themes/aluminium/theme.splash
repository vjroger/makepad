mod.theme = mod.themes.light

// Turned and brushed aluminium on a pale housing.
// A starter: a sober palette on the light base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #d9dbde
mod.theme.color_fg_app = #d9dbde
mod.theme.color_bg_container = #d9dbde
mod.theme.color_surface_container_lowest = #c9ccd1

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #e6e8ea
mod.theme.color_outset_1 = #e6e8ea
mod.theme.color_outset_2 = #e6e8ea
mod.theme.color_outset_hover = #eceef0
mod.theme.color_outset_1_hover = #eceef0
mod.theme.color_outset_2_hover = #eceef0
mod.theme.color_outset_down = #cfd2d6
mod.theme.color_outset_1_down = #cfd2d6
mod.theme.color_outset_2_down = #cfd2d6
mod.theme.color_outset_disabled = #d9dbde
mod.theme.color_outset_1_disabled = #d9dbde
mod.theme.color_outset_2_disabled = #d9dbde

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #c9ccd1
mod.theme.color_inset_1 = #c9ccd1
mod.theme.color_inset_2 = #c9ccd1
mod.theme.color_inset_hover = #c3c7cc
mod.theme.color_inset_1_hover = #c3c7cc
mod.theme.color_inset_2_hover = #c3c7cc
mod.theme.color_inset_focus = #c3c7cc
mod.theme.color_inset_1_focus = #c3c7cc
mod.theme.color_inset_2_focus = #c3c7cc
mod.theme.color_inset_active = #c3c7cc
mod.theme.color_inset_1_active = #c3c7cc
mod.theme.color_inset_2_active = #c3c7cc
mod.theme.color_inset_down = #c3c7cc
mod.theme.color_inset_1_down = #c3c7cc
mod.theme.color_inset_2_down = #c3c7cc
mod.theme.color_inset_drag = #c9ccd1
mod.theme.color_inset_1_drag = #c9ccd1
mod.theme.color_inset_2_drag = #c9ccd1
mod.theme.color_inset_empty = #c9ccd1
mod.theme.color_inset_1_empty = #c9ccd1
mod.theme.color_inset_2_empty = #c9ccd1
mod.theme.color_inset_disabled = #d9dbde
mod.theme.color_inset_1_disabled = #d9dbde
mod.theme.color_inset_2_disabled = #d9dbde

// One hairline edge on every face and well.
mod.theme.color_bevel = #9da2a9
mod.theme.color_bevel_inset_1 = #9da2a9
mod.theme.color_bevel_inset_2 = #9da2a9
mod.theme.color_bevel_outset_1 = #9da2a9
mod.theme.color_bevel_outset_2 = #9da2a9
mod.theme.beveling = 0.5

mod.theme.color_text = #24272b
mod.theme.color_label = #24272b
mod.theme.color_label_inner = #24272b
mod.theme.color_label_outer = #24272b
mod.theme.color_icon = #24272b
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #2f6fd6
mod.theme.color_focus = #2f6fd6
mod.theme.color_ctrl_active = #2f6fd6
mod.theme.color_val = #2f6fd6

mod.theme.color_terminal_bg = #1b1d20
mod.theme.color_terminal_text = #d9dbde

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 2.0
mod.theme.container_corner_radius = 4.0
true

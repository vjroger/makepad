mod.theme = mod.themes.light

// Clear glass on a light ground.
// A starter: a sober palette on the light base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #eef2f6
mod.theme.color_fg_app = #eef2f6
mod.theme.color_bg_container = #eef2f6
mod.theme.color_surface_container_lowest = #e3e8ee

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #f8fafc
mod.theme.color_outset_1 = #f8fafc
mod.theme.color_outset_2 = #f8fafc
mod.theme.color_outset_hover = #ffffff
mod.theme.color_outset_1_hover = #ffffff
mod.theme.color_outset_2_hover = #ffffff
mod.theme.color_outset_down = #e6ebf0
mod.theme.color_outset_1_down = #e6ebf0
mod.theme.color_outset_2_down = #e6ebf0
mod.theme.color_outset_disabled = #eef2f6
mod.theme.color_outset_1_disabled = #eef2f6
mod.theme.color_outset_2_disabled = #eef2f6

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #e3e8ee
mod.theme.color_inset_1 = #e3e8ee
mod.theme.color_inset_2 = #e3e8ee
mod.theme.color_inset_hover = #dde3ea
mod.theme.color_inset_1_hover = #dde3ea
mod.theme.color_inset_2_hover = #dde3ea
mod.theme.color_inset_focus = #dde3ea
mod.theme.color_inset_1_focus = #dde3ea
mod.theme.color_inset_2_focus = #dde3ea
mod.theme.color_inset_active = #dde3ea
mod.theme.color_inset_1_active = #dde3ea
mod.theme.color_inset_2_active = #dde3ea
mod.theme.color_inset_down = #dde3ea
mod.theme.color_inset_1_down = #dde3ea
mod.theme.color_inset_2_down = #dde3ea
mod.theme.color_inset_drag = #e3e8ee
mod.theme.color_inset_1_drag = #e3e8ee
mod.theme.color_inset_2_drag = #e3e8ee
mod.theme.color_inset_empty = #e3e8ee
mod.theme.color_inset_1_empty = #e3e8ee
mod.theme.color_inset_2_empty = #e3e8ee
mod.theme.color_inset_disabled = #eef2f6
mod.theme.color_inset_1_disabled = #eef2f6
mod.theme.color_inset_2_disabled = #eef2f6

// One hairline edge on every face and well.
mod.theme.color_bevel = #a9b3bf
mod.theme.color_bevel_inset_1 = #a9b3bf
mod.theme.color_bevel_inset_2 = #a9b3bf
mod.theme.color_bevel_outset_1 = #a9b3bf
mod.theme.color_bevel_outset_2 = #a9b3bf
mod.theme.beveling = 0.5

mod.theme.color_text = #1f2630
mod.theme.color_label = #1f2630
mod.theme.color_label_inner = #1f2630
mod.theme.color_label_outer = #1f2630
mod.theme.color_icon = #1f2630
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #2a6fd0
mod.theme.color_focus = #2a6fd0
mod.theme.color_ctrl_active = #2a6fd0
mod.theme.color_val = #2a6fd0

mod.theme.color_terminal_bg = #1f2630
mod.theme.color_terminal_text = #eef2f6

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 3.0
mod.theme.container_corner_radius = 6.0
true

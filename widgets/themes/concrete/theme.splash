mod.theme = mod.themes.light

// Cast concrete: grey, porous, controls stamped into it.
// A starter: a sober palette on the light base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #c2c1bc
mod.theme.color_fg_app = #c2c1bc
mod.theme.color_bg_container = #c2c1bc
mod.theme.color_surface_container_lowest = #b1b0ab

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #cccbc6
mod.theme.color_outset_1 = #cccbc6
mod.theme.color_outset_2 = #cccbc6
mod.theme.color_outset_hover = #d4d3ce
mod.theme.color_outset_1_hover = #d4d3ce
mod.theme.color_outset_2_hover = #d4d3ce
mod.theme.color_outset_down = #b7b6b1
mod.theme.color_outset_1_down = #b7b6b1
mod.theme.color_outset_2_down = #b7b6b1
mod.theme.color_outset_disabled = #c2c1bc
mod.theme.color_outset_1_disabled = #c2c1bc
mod.theme.color_outset_2_disabled = #c2c1bc

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #b1b0ab
mod.theme.color_inset_1 = #b1b0ab
mod.theme.color_inset_2 = #b1b0ab
mod.theme.color_inset_hover = #abaaa5
mod.theme.color_inset_1_hover = #abaaa5
mod.theme.color_inset_2_hover = #abaaa5
mod.theme.color_inset_focus = #abaaa5
mod.theme.color_inset_1_focus = #abaaa5
mod.theme.color_inset_2_focus = #abaaa5
mod.theme.color_inset_active = #abaaa5
mod.theme.color_inset_1_active = #abaaa5
mod.theme.color_inset_2_active = #abaaa5
mod.theme.color_inset_down = #abaaa5
mod.theme.color_inset_1_down = #abaaa5
mod.theme.color_inset_2_down = #abaaa5
mod.theme.color_inset_drag = #b1b0ab
mod.theme.color_inset_1_drag = #b1b0ab
mod.theme.color_inset_2_drag = #b1b0ab
mod.theme.color_inset_empty = #b1b0ab
mod.theme.color_inset_1_empty = #b1b0ab
mod.theme.color_inset_2_empty = #b1b0ab
mod.theme.color_inset_disabled = #c2c1bc
mod.theme.color_inset_1_disabled = #c2c1bc
mod.theme.color_inset_2_disabled = #c2c1bc

// One hairline edge on every face and well.
mod.theme.color_bevel = #7c7b76
mod.theme.color_bevel_inset_1 = #7c7b76
mod.theme.color_bevel_inset_2 = #7c7b76
mod.theme.color_bevel_outset_1 = #7c7b76
mod.theme.color_bevel_outset_2 = #7c7b76
mod.theme.beveling = 0.5

mod.theme.color_text = #1d1d1b
mod.theme.color_label = #1d1d1b
mod.theme.color_label_inner = #1d1d1b
mod.theme.color_label_outer = #1d1d1b
mod.theme.color_icon = #1d1d1b
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #1f4a5e
mod.theme.color_focus = #1f4a5e
mod.theme.color_ctrl_active = #1f4a5e
mod.theme.color_val = #1f4a5e

mod.theme.color_terminal_bg = #1d1d1b
mod.theme.color_terminal_text = #c2c1bc

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 1.0
mod.theme.container_corner_radius = 2.0
true

mod.theme = mod.themes.dark

// Futuristic brushed metal with lit circuit traces cut into it.
// A starter: a sober palette on the dark base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #1a1e22
mod.theme.color_fg_app = #1a1e22
mod.theme.color_bg_container = #1a1e22
mod.theme.color_surface_container_lowest = #121518

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #282e34
mod.theme.color_outset_1 = #282e34
mod.theme.color_outset_2 = #282e34
mod.theme.color_outset_hover = #30373e
mod.theme.color_outset_1_hover = #30373e
mod.theme.color_outset_2_hover = #30373e
mod.theme.color_outset_down = #22272c
mod.theme.color_outset_1_down = #22272c
mod.theme.color_outset_2_down = #22272c
mod.theme.color_outset_disabled = #1a1e22
mod.theme.color_outset_1_disabled = #1a1e22
mod.theme.color_outset_2_disabled = #1a1e22

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #121518
mod.theme.color_inset_1 = #121518
mod.theme.color_inset_2 = #121518
mod.theme.color_inset_hover = #0f1114
mod.theme.color_inset_1_hover = #0f1114
mod.theme.color_inset_2_hover = #0f1114
mod.theme.color_inset_focus = #0f1114
mod.theme.color_inset_1_focus = #0f1114
mod.theme.color_inset_2_focus = #0f1114
mod.theme.color_inset_active = #0f1114
mod.theme.color_inset_1_active = #0f1114
mod.theme.color_inset_2_active = #0f1114
mod.theme.color_inset_down = #0f1114
mod.theme.color_inset_1_down = #0f1114
mod.theme.color_inset_2_down = #0f1114
mod.theme.color_inset_drag = #121518
mod.theme.color_inset_1_drag = #121518
mod.theme.color_inset_2_drag = #121518
mod.theme.color_inset_empty = #121518
mod.theme.color_inset_1_empty = #121518
mod.theme.color_inset_2_empty = #121518
mod.theme.color_inset_disabled = #1a1e22
mod.theme.color_inset_1_disabled = #1a1e22
mod.theme.color_inset_2_disabled = #1a1e22

// One hairline edge on every face and well.
mod.theme.color_bevel = #49535d
mod.theme.color_bevel_inset_1 = #49535d
mod.theme.color_bevel_inset_2 = #49535d
mod.theme.color_bevel_outset_1 = #49535d
mod.theme.color_bevel_outset_2 = #49535d
mod.theme.beveling = 0.5

mod.theme.color_text = #e2e8ec
mod.theme.color_label = #e2e8ec
mod.theme.color_label_inner = #e2e8ec
mod.theme.color_label_outer = #e2e8ec
mod.theme.color_icon = #e2e8ec
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #30c8e2
mod.theme.color_focus = #30c8e2
mod.theme.color_ctrl_active = #30c8e2
mod.theme.color_val = #30c8e2

mod.theme.color_terminal_bg = #121518
mod.theme.color_terminal_text = #e2e8ec

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 2.0
mod.theme.container_corner_radius = 4.0
true

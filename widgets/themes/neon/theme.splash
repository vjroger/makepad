mod.theme = mod.themes.dark

// Tubes of light on a near-black ground.
// A starter: a sober palette on the dark base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #0b0b12
mod.theme.color_fg_app = #0b0b12
mod.theme.color_bg_container = #0b0b12
mod.theme.color_surface_container_lowest = #07070c

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #151522
mod.theme.color_outset_1 = #151522
mod.theme.color_outset_2 = #151522
mod.theme.color_outset_hover = #1b1b2b
mod.theme.color_outset_1_hover = #1b1b2b
mod.theme.color_outset_2_hover = #1b1b2b
mod.theme.color_outset_down = #10101a
mod.theme.color_outset_1_down = #10101a
mod.theme.color_outset_2_down = #10101a
mod.theme.color_outset_disabled = #0b0b12
mod.theme.color_outset_1_disabled = #0b0b12
mod.theme.color_outset_2_disabled = #0b0b12

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #07070c
mod.theme.color_inset_1 = #07070c
mod.theme.color_inset_2 = #07070c
mod.theme.color_inset_hover = #050509
mod.theme.color_inset_1_hover = #050509
mod.theme.color_inset_2_hover = #050509
mod.theme.color_inset_focus = #050509
mod.theme.color_inset_1_focus = #050509
mod.theme.color_inset_2_focus = #050509
mod.theme.color_inset_active = #050509
mod.theme.color_inset_1_active = #050509
mod.theme.color_inset_2_active = #050509
mod.theme.color_inset_down = #050509
mod.theme.color_inset_1_down = #050509
mod.theme.color_inset_2_down = #050509
mod.theme.color_inset_drag = #07070c
mod.theme.color_inset_1_drag = #07070c
mod.theme.color_inset_2_drag = #07070c
mod.theme.color_inset_empty = #07070c
mod.theme.color_inset_1_empty = #07070c
mod.theme.color_inset_2_empty = #07070c
mod.theme.color_inset_disabled = #0b0b12
mod.theme.color_inset_1_disabled = #0b0b12
mod.theme.color_inset_2_disabled = #0b0b12

// One hairline edge on every face and well.
mod.theme.color_bevel = #2c2c44
mod.theme.color_bevel_inset_1 = #2c2c44
mod.theme.color_bevel_inset_2 = #2c2c44
mod.theme.color_bevel_outset_1 = #2c2c44
mod.theme.color_bevel_outset_2 = #2c2c44
mod.theme.beveling = 0.5

mod.theme.color_text = #e8e6ff
mod.theme.color_label = #e8e6ff
mod.theme.color_label_inner = #e8e6ff
mod.theme.color_label_outer = #e8e6ff
mod.theme.color_icon = #e8e6ff
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #ff4fb8
mod.theme.color_focus = #ff4fb8
mod.theme.color_ctrl_active = #ff4fb8
mod.theme.color_val = #ff4fb8

mod.theme.color_terminal_bg = #0b0b12
mod.theme.color_terminal_text = #e8e6ff

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 2.0
mod.theme.container_corner_radius = 4.0
true

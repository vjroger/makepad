use mod.prelude.widgets_internal.*

// White porcelain on a pale plate. Every face is drawn in true points (one
// device pixel is `px`); every shadow, lip and lamp halo falls OUTSIDE the
// layout box: the quad is grown in `vertex`, the templates that throw light
// or shadow stop clipping, and no padding is spent on either. Form comes
// from light: what stands is a slab with a visible side under its face (a
// cap 1 to 2.5 points thick, a panel 3), a white hairline on its upper
// edge, a darker one at its foot and a soft cool shadow under it that is
// gone within half the gap to its neighbour; what is pressed in has an
// inner shade under its upper rim and a pale lower wall; knobs, handles
// and toggle knobs are domes. The one colour is a small warm lamp.

// ---------------------------------------------------------------- helpers

// One device pixel in points.
let po_px = fn(dpi: float) -> float {
    return 1.0 / max(dpi, 0.5)
}

// An edge rounded to a whole device pixel in window space, handed back in
// box space: a hairline on it lands on one pixel row.
let po_snap = fn(v: float, o: float, px: float) -> float {
    return Finish.snap(o + v, px) - o
}

// Distance from p to the segment a..b, in points.
let po_seg = fn(p: vec2, a: vec2, b: vec2) -> float {
    let pa = p - a
    let ba = b - a
    let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0)
    return length(pa - ba * t)
}

// The plate the controls stand on (#e4e6eb), for a face that fades to it.
let po_ground = fn() -> vec3 {
    return vec3(0.894, 0.902, 0.922)
}

// The cool grey every shadow is cast in; laid at a coverage, never black.
let po_shade = fn() -> vec3 {
    return vec3(0.20, 0.22, 0.28)
}

// Which way the outline of a rounded box faces at p: the edge lines follow
// it, so a pill gets arcs where a square cap gets straight lines.
let po_normal = fn(p: vec2, c: vec2, h: vec2, r: float) -> vec2 {
    let s = vec2(step(0.0, p.x - c.x) * 2.0 - 1.0, step(0.0, p.y - c.y) * 2.0 - 1.0)
    let q = abs(p - c) - (h - vec2(r, r))
    let qc = max(q, vec2(0.0, 0.0))
    var n = vec2(0.0, s.y)
    if q.x > q.y {
        n = vec2(s.x, 0.0)
    }
    if q.x > 0.0 && q.y > 0.0 {
        n = qc / max(length(qc), 0.0001) * s
    }
    return n
}

// Anything drawn in a grown quad fades out over its last points, so a soft
// shadow never ends on a hard edge where the quad stops.
let po_fade = fn(pos: vec2, size: vec2, m: float) -> float {
    let q = pos * (size + vec2(2.0 * m, 2.0 * m))
    let e = min(min(q.x, q.y), min(size.x + 2.0 * m - q.x, size.y + 2.0 * m - q.y))
    return smoothstep(0.0, 4.0, e)
}

// The warm light that leaks from under a lit control's lower edge. On a
// white plate light cannot brighten, so it tints: a peach pool, warm white
// where it is strongest. `hh` is the control height it is sized by, `s` its
// strength. Premultiplied.
let po_spot = fn(p: vec2, cx: float, by: float, hh: float, s: float) -> vec4 {
    let dx = p.x - cx
    let dy = p.y - by
    let sx = 0.30 * hh
    let sy = 0.08 * hh
    let tx = 0.48 * hh
    let ty = 0.20 * hh
    let core = exp(-(dx * dx) / (2.0 * sx * sx) - (dy * dy) / (2.0 * sy * sy))
    let tail = exp(-(dx * dx) / (2.0 * tx * tx) - (dy * dy) / (2.0 * ty * ty))
    let g = clamp((0.85 * core + 0.55 * tail) * s, 0.0, 1.0)
    var col = mix(vec3(0.96, 0.58, 0.26), vec3(1.0, 0.76, 0.46), smoothstep(0.15, 0.6, g))
    col = mix(col, vec3(1.0, 0.95, 0.82), smoothstep(0.7, 1.0, g))
    let a = g * 0.5
    return vec4(col * a, a)
}

// What a raised control throws on the plate: a soft shadow falling straight
// down, half gone 4 points under the foot and gone by 8, drawn in 3
// points from the sides so it never reaches a neighbour; and a close dark
// contact shadow right under the foot. Sized by the control's height up to
// a 26 point row and no further. Returns the coverage.
let po_shadow = fn(p: vec2, c: vec2, h: vec2, r: float, px: float, sh_h: float, lift: float, hover: float, down: float, dis: float) -> float {
    let k = sh_h / 26.0
    let hs = vec2(max(h.x - 3.0 * k, 0.5), h.y)
    let rs = min(r, min(hs.x, hs.y))
    let off = (4.0 + 0.7 * hover) * k
    let sg = (1.9 + 0.25 * hover) * k + px * 0.5
    let amb = Finish.drop(p, c, hs, rs, vec2(0.0, off), sg) * (0.32 + 0.07 * hover) * lift * (1.0 - down) * (1.0 - 0.8 * dis)
    let hw = vec2(max(h.x - 5.0 * k, 0.5), h.y)
    let wide = Finish.drop(p, c, hw, min(r, min(hw.x, hw.y)), vec2(0.0, 4.2 * k), 2.5 * k + px) * 0.07 * lift * (1.0 - down) * (1.0 - 0.8 * dis)
    let con = Finish.drop(p, c, h - vec2(0.6 * k, 0.0), r, vec2(0.0, 0.7 * k + px * 0.5), 0.55 * k + px * 0.5) * mix(0.22, 0.10, down) * (1.0 - 0.6 * dis) * min(lift + 0.5, 1.0)
    return 1.0 - (1.0 - amb) * (1.0 - con) * (1.0 - wide)
}

// The little warm light the focus frame spills outward: a tint one device
// pixel out, gone within 2.5 points. Premultiplied, laid under the face.
let po_leak = fn(d: float, a: float) -> vec4 {
    let s = 1.1
    let g = 0.42 * exp(-(max(d, 0.0) * max(d, 0.0)) / (2.0 * s * s)) * (1.0 - a)
    return vec4(vec3(0.97, 0.66, 0.32) * g, g)
}

// The lit frame of what has focus: an amber line just inside the rim with a
// warm-white core, and a warm tint bleeding inward a few points.
let po_frame = fn(face: vec3, d: float, px: float, fo: float, hh: float) -> vec3 {
    if fo < 0.001 {
        return face
    }
    let x = max(-d, 0.0)
    let k = clamp(0.1 * hh, 1.0, 2.2)
    let bleed = exp(-max(x - 1.4, 0.0) / k) * fo
    var f = mix(face, vec3(1.0, 0.86, 0.66), bleed * 0.35)
    let lw = clamp(0.06 * hh, 1.1, 1.6)
    let line = Finish.band(d, 0.0, lw, px) * fo
    f = mix(f, vec3(0.93, 0.58, 0.22), line * 0.9)
    let core = Finish.band(d, lw * 0.35, lw * 0.7, px) * fo
    return mix(f, vec3(1.0, 0.80, 0.52), core * 0.6)
}
// The same frame laid over what is already drawn (premultiplied `res`,
// coverage `a` of the shape): for a well or an outline.
let po_frame_over = fn(res: vec4, d: float, px: float, fo: float, a: float, hh: float) -> vec4 {
    if fo < 0.001 {
        return res
    }
    let x = max(-d, 0.0)
    let fb = exp(-max(x - 1.6, 0.0) / clamp(0.1 * hh, 1.0, 2.2)) * fo * a * 0.3
    var out = Finish.over(res, vec4(vec3(1.0, 0.86, 0.66) * fb, fb))
    let lw = clamp(0.06 * hh, 1.1, 1.6)
    let fl = Finish.band(d, 0.0, lw, px) * fo * 0.9
    out = Finish.over(out, vec4(vec3(0.93, 0.58, 0.22) * fl, fl))
    let fc = Finish.band(d, lw * 0.35, lw * 0.7, px) * fo * 0.6
    return Finish.over(out, vec4(vec3(1.0, 0.80, 0.52) * fc, fc))
}

// A small lamp: off, a pale dimple pressed into the glaze; lit, a warm-white
// core in an amber rim with a peach halo of barely two points. `rl` its
// radius in points.
let po_lamp = fn(dst: vec4, p: vec2, c: vec2, rl: float, px: float, lit: float, dis: float) -> vec4 {
    let q = p - c
    let ql = length(q)
    let d = ql - rl
    let on = lit * (1.0 - dis)
    let hs = 1.2 + 0.25 * rl
    let hg = exp(-(max(d, 0.0) * max(d, 0.0)) / (2.0 * hs * hs)) * (1.0 - Finish.cover(d, px)) * 0.55 * on
    var res = Finish.over(dst, vec4(vec3(0.99, 0.66, 0.30) * hg, hg))
    let k = clamp(ql / max(rl, 0.5), 0.0, 1.0)
    let lit_col = mix(vec3(1.0, 0.98, 0.88), vec3(0.95, 0.60, 0.22), smoothstep(0.3, 1.0, k))
    let off_col = mix(vec3(0.80, 0.815, 0.845), vec3(0.95, 0.955, 0.965), smoothstep(-1.0, 1.0, q.y / max(rl, 0.5)))
    let col = mix(off_col, lit_col, on)
    let a = Finish.cover(d, px)
    return Finish.over(res, vec4(col * a, a))
}

// A white glazed cap: a slab of porcelain standing on the plate, 1 to 2.5
// points thick. Its top face carries a bright band over the upper third
// and the body #f1f2f5; under the face the slab's side shows as a band
// turning from #e8eaee to #d8dbe0 at the foot, closed by a darker device
// pixel; round the sides a hairline of the ground's shade, across the top a
// white one. `lift` 1 casts the full shadow, 0 seats the cap with its
// contact shadow only; `tone` 1 a shade cooler for the small controls;
// `spot` the strength of the light from under it; `room` how far under the
// foot its shadow may reach (a cap standing in a well stops at the well);
// `band` the strength of the bright upper band.
let po_cap_r = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float, down: float, dis: float, focus: float, lift: float, tone: float, spot: float, room: float, band: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let sh_h = min(hh, 26.0)
    let d = Material.sd_box(p, c, h, r)
    let live = 1.0 - dis
    let up = (1.0 - down) * live
    let a = Finish.cover(d, px)
    let n = po_normal(p, c, h, r)
    // With little room under it (a field, the combo box, the chosen list
    // row) the shadow is sized to that room and its tail is gone before
    // the room ends; a cap standing in a well (room under 3.5) stops at
    // the well's edge.
    let tight = step(3.5, room) * (1.0 - step(30.0, room))
    let fit = mix(1.0, clamp(room / 8.0, 0.4, 1.0), tight)
    let reach = 1.0 - smoothstep(mix(room - 1.5, room * 0.35, tight), room, p.y - hi.y)
    let sc = po_shadow(p, c, h, r, px, sh_h * fit, lift, hover, down, dis) * reach
    var res = vec4(po_shade() * sc, sc)
    let lit = spot * live
    if lit > 0.001 {
        res = Finish.over(res, po_spot(p, c.x, hi.y + 0.02 * sh_h, sh_h, lit) * reach)
    }
    let fo = focus * live
    if fo > 0.001 {
        res = Finish.over(res, po_leak(d, a) * fo)
    }
    // The slab: the top face stands `tk` over the plate; held, it sinks and
    // most of the side goes with it.
    let tk = clamp(0.095 * hh, 1.0, 2.5) * (1.0 - 0.6 * down)
    let hf = vec2(h.x, max(h.y - tk * 0.5, 0.5))
    let cf = vec2(c.x, c.y - tk * 0.5)
    let df = Material.sd_box(p, cf, hf, min(r, min(hf.x, hf.y)))
    let af = Finish.cover(df, px)
    // The top face: the bright band over its upper third, the body under it.
    let t = clamp((p.y - lo.y) / max(hf.y * 2.0, 1.0), 0.0, 1.0)
    let body = mix(vec3(0.945, 0.949, 0.961), vec3(0.930, 0.935, 0.948), tone)
    var face = mix(body, vec3(0.993, 0.993, 0.995), (1.0 - smoothstep(0.16, 0.45, t)) * mix(0.92, 0.75, tone) * band * (1.0 - down))
    face = face - vec3(0.018, 0.018, 0.015) * smoothstep(0.55, 1.0, t) * up
    face = face + vec3(0.03, 0.029, 0.025) * hover * up
    // Held: pushed into the plate; the glaze a step lower and the rim of
    // the plate shading it from the top over its upper half.
    let shade = 0.08 * (1.0 - smoothstep(0.0, 0.5 * hh, p.y - lo.y)) + 0.03 * (1.0 - smoothstep(0.0, 2.5, -d))
    face = mix(face, face - vec3(0.03 + shade, 0.029 + shade, 0.026 + shade), down * live)
    // Chosen (the light from under at full): the foot of the cap glows warm
    // from inside over its middle, so a row that clips its foot still says
    // chosen.
    let inl = smoothstep(0.85, 1.0, spot) * live
    var warm = 0.0
    if inl > 0.001 {
        let wx = abs(p.x - c.x) / max(h.x, 1.0)
        let low = 1.0 - smoothstep(0.0, 0.55 * hh, hi.y - p.y)
        warm = low * (1.0 - smoothstep(0.3, 0.95, wx)) * inl
        face = mix(face, vec3(1.0, 0.87, 0.70), 0.45 * warm)
        let hot = Finish.band(df, px, px * 2.5, px) * smoothstep(0.3, 0.9, n.y) * (1.0 - smoothstep(0.35, 0.65, wx)) * inl
        face = mix(face, vec3(1.0, 0.80, 0.55), hot * 0.35)
    }
    // Where the face rolls over into the side, one device pixel catches the
    // light.
    face = mix(face, vec3(0.99, 0.99, 0.993), Finish.band(df, 0.0, px, px) * smoothstep(0.2, 0.8, n.y) * up * 0.85)
    face = min(face, vec3(1.0, 1.0, 1.0))
    // The side of the slab, from the face down to the foot.
    let wk = clamp(df / max(df - d, 0.001), 0.0, 1.0)
    var wall = mix(vec3(0.886, 0.894, 0.910), vec3(0.815, 0.826, 0.848), wk)
    wall = mix(wall, vec3(1.0, 0.84, 0.64), 0.35 * warm)
    var col = mix(wall, face, af)
    col = mix(col, po_ground(), 0.55 * dis)
    // The outline: white across the top, the ground's shade down the sides,
    // a darker device pixel under the foot; held, the top greys where the
    // rim of the plate stands over it.
    let ring = Finish.band(d, 0.0, px, px)
    let upper = smoothstep(0.3, 0.8, -n.y)
    let lower = smoothstep(0.3, 0.85, n.y)
    var edge = mix(vec3(0.835, 0.845, 0.868), mix(vec3(1.0, 1.0, 1.0), vec3(0.74, 0.76, 0.80), down), upper)
    edge = mix(edge, mix(vec3(0.68, 0.695, 0.73), vec3(0.62, 0.64, 0.68), tone), lower * (1.0 - 0.5 * down))
    edge = mix(edge, col, 0.7 * dis)
    col = mix(col, edge, ring)
    col = po_frame(col, d, px, fo, hh)
    return Finish.over(res, vec4(col * a, a))
}
let po_cap = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, hover: float, down: float, dis: float, focus: float, lift: float, tone: float, spot: float) -> vec4 {
    return po_cap_r(p, lo, hi, r, px, hover, down, dis, focus, lift, tone, spot, 40.0, 1.0)
}

// A shape pressed into the plate: its fill; the rim of the plate shading
// it from the top (and a little from the sides) over a few points; its
// lower wall, which faces the light, a paler strip inside the foot; a grey
// device pixel on its upper edge and a white lip on the plate under its
// foot. `fill` its colour, `depth` the strength of the inner shade. Under
// the hand the floor lightens and the shade eases; held, it is pushed in:
// the floor a clear step darker and the shade half again as deep, which
// the hand on it does not take back.
let po_sunk = fn(p: vec2, lo: vec2, hi: vec2, r: float, px: float, fill: vec3, hover: float, down: float, dis: float, depth: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    let sh_h = min(hh, 26.0)
    let d = Material.sd_box(p, c, h, r)
    let n = po_normal(p, c, h, r)
    let a = Finish.cover(d, px)
    let live = 1.0 - 0.6 * dis
    let lipa = Finish.ring_out(d, 0.0, px * 1.5, px) * smoothstep(0.1, 0.9, n.y) * live
    var res = vec4(vec3(1.0, 1.0, 1.0) * lipa, lipa)
    var col = fill + vec3(0.024, 0.024, 0.02) * hover * (1.0 - down) - vec3(0.056, 0.056, 0.05) * down
    let sg = clamp(0.17 * sh_h, 1.1, 3.6)
    let insh = Finish.inset(p, c, h, r, vec2(0.0, sg * 0.8), sg)
    col = mix(col, vec3(0.56, 0.585, 0.64), clamp(insh * depth * 1.2 * (1.0 - 0.3 * hover * (1.0 - down)) * (1.0 + 0.5 * down) * live, 0.0, 0.9))
    let lw = clamp(0.07 * sh_h, 0.6, 1.4)
    let low = Finish.band(d, px, px + lw, px) * smoothstep(0.35, 0.9, n.y)
    col = mix(col, vec3(0.985, 0.987, 0.992), low * 0.55 * live)
    let ring = Finish.band(d, 0.0, px, px)
    let edge = mix(vec3(0.62, 0.645, 0.69), vec3(0.86, 0.87, 0.895), smoothstep(-0.2, 0.9, n.y))
    col = mix(col, mix(edge, col, 0.5 * dis), ring)
    col = mix(col, po_ground(), 0.4 * dis)
    return Finish.over(res, vec4(col * a, a))
}

// A lit value inside a well (`wlo`..`whi`, corner `wr`): a slim amber rod,
// deep #e0852b where the value starts to #ffb85a at its head, a warm-white
// line down its middle, its edge a shade deeper so it reads as a lit rod
// and holds against the white. Its bloom only tints the floor of the
// groove round it. `hot` (the hand on it, a drag, focus) whitens the core.
let po_fill = fn(dst: vec4, p: vec2, lo: vec2, hi: vec2, r: float, px: float, dis: float, glow: float, hot: float, wlo: vec2, whi: vec2, wr: float) -> vec4 {
    let c = (lo + hi) * 0.5
    let h = max((hi - lo) * 0.5, vec2(0.01, 0.01))
    let d = Material.sd_box(p, c, h, min(r, min(h.x, h.y)))
    let a = Finish.cover(d, px)
    let live = 1.0 - dis
    let dw = Material.sd_box(p, (wlo + whi) * 0.5, (whi - wlo) * 0.5, wr)
    let inw = Finish.cover(dw, px)
    let bl = exp(-(max(d, 0.0) * max(d, 0.0)) / (2.0 * 1.6 * 1.6)) * (1.0 - a) * glow * live * step(0.5, h.x) * inw
    var res = Finish.over(dst, vec4(vec3(0.99, 0.70, 0.38) * bl * 0.5, bl * 0.5))
    let across_x = step(hi.y - lo.y, hi.x - lo.x)
    let along = mix(clamp((hi.y - p.y) / max(hi.y - lo.y, 0.5), 0.0, 1.0), clamp((p.x - lo.x) / max(hi.x - lo.x, 0.5), 0.0, 1.0), across_x)
    let hk = max(mix(h.x, h.y, across_x), 0.01)
    let thin = 1.0 - smoothstep(0.9, 1.6, hk)
    let ramp = smoothstep(0.0, 1.0, along)
    var col = mix(vec3(0.88, 0.50, 0.16), vec3(1.0, 0.70, 0.33), ramp)
    col = mix(col, vec3(0.78, 0.42, 0.12), Finish.band(d, 0.0, px, px) * (1.0 - thin) * 0.8)
    let ax = mix(abs(p.x - c.x), abs(p.y - c.y), across_x)
    let q = ax / max(0.40 * hk, px * mix(0.6, 0.85, thin))
    let line = exp(-q * q) * mix(0.55, 0.9, ramp) * (1.0 - 0.4 * thin)
    col = mix(col, mix(vec3(1.0, 0.88, 0.66), vec3(1.0, 0.97, 0.88), hot), line)
    // The rod lies under the rim of the groove: its top a shade deeper.
    col = col * (1.0 - 0.24 * (1.0 - smoothstep(0.0, max(hi.y - lo.y, 0.5) * 0.45, p.y - lo.y)) * across_x)
    col = mix(col, vec3(0.80, 0.81, 0.84), dis)
    return Finish.over(res, vec4(col * a, a))
}

// The three-quarter arc a waiting button turns in place of its label.
let po_spinner = fn(dst: vec4, p: vec2, c: vec2, rad: float, t: float, amt: float, stroke: float, ink: vec3) -> vec4 {
    let sdf = Sdf2d.viewport(p)
    let a0 = t * 2.0 * PI
    sdf.arc_round_caps(c.x, c.y, rad, a0, a0 + 1.5 * PI, stroke)
    sdf.fill(vec4(ink, amt))
    return Finish.over(dst, sdf.result)
}

// A white dome: the glaze bright at its upper left, falling to #d9dce2 at
// its lower right foot; a white device pixel on its upper left rim and a
// grey one on its lower right. `crown` 1 gives it a flat top face 0.78 of
// its radius across, raised a little toward the light, its rim lit at the
// upper left and shaded at the lower right, so the dome reads as a knob
// with a skirt. Focused, the lit frame at its rim.
let po_dome = fn(p: vec2, c: vec2, rad: float, px: float, hover: float, down: float, dis: float, focus: float, crown: float) -> vec4 {
    let q = (p - c) / max(rad, 0.5)
    let ql = length(q)
    let d = length(p - c) - rad
    let a = Finish.cover(d, px)
    let g = dot(q, vec2(0.53, 0.85))
    var col = mix(vec3(0.945, 0.949, 0.960), vec3(0.851, 0.863, 0.886), smoothstep(-0.3, 1.0, g) * smoothstep(0.0, 1.0, ql))
    col = col - vec3(0.03, 0.03, 0.026) * smoothstep(0.72, 1.0, ql) * smoothstep(-0.4, 0.3, g)
    // A knob's skirt turns away from the light toward its foot: a band
    // falling to three quarters of the face at the lower right.
    col = col * (1.0 - 0.17 * crown * smoothstep(0.80, 0.99, ql) * mix(0.3, 1.0, smoothstep(-0.5, 0.7, g)))
    let hq = q + vec2(0.30, 0.42)
    col = mix(col, vec3(0.995, 0.995, 0.997), exp(-dot(hq, hq) * 2.4) * 0.9 * (1.0 - 0.6 * down))
    col = col + vec3(0.03, 0.03, 0.026) * hover - vec3(0.03, 0.03, 0.027) * down
    let ring = Finish.band(d, 0.0, px, px)
    col = mix(col, vec3(1.0, 1.0, 1.0), ring * (1.0 - smoothstep(-0.7, 0.0, g)) * 0.9)
    col = mix(col, vec3(0.70, 0.715, 0.75), ring * smoothstep(0.1, 0.8, g))
    if crown > 0.001 {
        let rt = rad * 0.78
        let ct = c - vec2(0.0, rad * 0.04)
        let dt = length(p - ct) - rt
        let at = Finish.cover(dt, px) * crown
        let gt = dot((p - ct) / max(rt, 0.5), vec2(0.53, 0.85))
        var top = mix(vec3(0.962, 0.965, 0.973), vec3(0.912, 0.918, 0.934), smoothstep(-0.7, 1.0, gt))
        top = top + vec3(0.03, 0.03, 0.026) * hover
        let rim = Finish.band(dt, 0.0, px * 1.5, px)
        top = mix(top, vec3(1.0, 1.0, 1.0), rim * (1.0 - smoothstep(-0.6, 0.1, gt)) * 0.9)
        top = mix(top, vec3(0.80, 0.815, 0.845), rim * smoothstep(0.0, 0.8, gt) * 0.6)
        col = mix(col, top, at)
    }
    col = min(col, vec3(1.0, 1.0, 1.0))
    col = mix(col, po_ground(), 0.55 * dis)
    col = po_frame(col, d, px, focus * (1.0 - dis), 2.0 * rad)
    return vec4(col * a, a)
}
// What a dome throws: down and a little to the right, as soft as it is
// small. Coverage.
let po_dome_shadow = fn(p: vec2, c: vec2, rad: float, px: float) -> float {
    return Finish.drop(p, c, vec2(rad, rad), rad, vec2(0.10 * rad, 0.22 * rad), 0.20 * rad + px)
}

// ---------------------------------------------------------------- buttons

// Every button is a slim white pill: 26 points on a 12 point line, 12
// points either side. Its shadow and its light fall outside the box.
mod.widgets.ButtonFlat.padding = mod.turtle.Inset{left: 12.0 right: 12.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlat.min_height = 26.0
mod.widgets.ButtonFlat.icon_walk.width = 14.0
mod.widgets.ButtonIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
mod.widgets.ButtonFlatterIcon.padding = mod.turtle.Inset{left: 6.0 right: 6.0 top: 4.0 bottom: 4.0}
// The size rungs keep heights of their own.
mod.widgets.ButtonXs.min_height = 18.0
mod.widgets.ButtonSm.min_height = 22.0
mod.widgets.ButtonLg.min_height = 30.0
mod.widgets.ButtonXl.min_height = 34.0
mod.widgets.ButtonFlat.draw_bg.border_radius = 6.5
mod.widgets.ButtonFlat.draw_bg.border_size = 0.34
mod.widgets.ButtonFlat.clip_x = false
mod.widgets.ButtonFlat.clip_y = false
mod.widgets.ButtonFlat.draw_bg.vertex = fn() {
    let m = 14.0
    self.vertex_pos = self.clip_and_transform_vertex(self.rect_pos - vec2(m, m), self.rect_size + vec2(2.0 * m, 2.0 * m))
}

// The button and its variants share one face; `kind` picks it: 0 seated
// cap, 1 raised cap, 2 lit primary (raised, lit from under at rest), 3
// pressed-in pill, 4 seated cool cap, 5 danger (raised, red words),
// 6 outline, 7 flatter.
let po_button = fn(pos: vec2, size: vec2, o: vec2, dpi: float, hover: float, down: float, dis: float, focus: float, loading: float, anim: float, kind: float, dash: float) -> vec4 {
    let m = 14.0
    let px = po_px(dpi)
    let p = pos * (size + vec2(2.0 * m, 2.0 * m)) - vec2(m, m)
    let lo = vec2(po_snap(0.0, o.x, px), po_snap(0.0, o.y, px))
    let hi = vec2(po_snap(size.x, o.x, px), po_snap(size.y, o.y, px))
    let c = (lo + hi) * 0.5
    let h = (hi - lo) * 0.5
    let hh = hi.y - lo.y
    // Pills; an icon alone gets a square cap with a 0.26H corner.
    var r = min(h.x, h.y)
    if size.x < size.y * 1.35 {
        r = 0.26 * hh
    }
    let live = 1.0 - dis
    let spot = (0.35 * hover + 0.3 * down) * (1.0 - step(0.5, dis))
    var res = vec4(0.0, 0.0, 0.0, 0.0)
    var ink = vec3(0.169, 0.180, 0.208)
    if kind > 5.5 {
        let d = Material.sd_box(p, c, h, r)
        let a = Finish.cover(d, px)
        let n = po_normal(p, c, h, r)
        let sh_h = min(hh, 26.0)
        if focus * live > 0.001 {
            res = Finish.over(res, po_leak(d, a) * focus * live)
        }
        // Under the hand a faint white wash, held a faint grey one.
        let wash = (0.5 * hover * (1.0 - down)) * live * a
        res = Finish.over(res, vec4(vec3(1.0, 1.0, 1.0) * wash * 0.6, wash * 0.6))
        let press = 0.06 * down * live * a
        res = Finish.over(res, vec4(po_shade() * press, press))
        if kind < 6.5 {
            // Outline: a device pixel of grey, white under its foot.
            var ring = Finish.band(d, 0.0, px, px)
            if dash > 0.0 {
                ring = ring * step(0.5, fract((p.x + p.y) / (dash * 2.0)))
            }
            let col = mix(vec3(0.62, 0.645, 0.69), vec3(0.72, 0.74, 0.78), smoothstep(-0.35, 0.35, n.y))
            let ra = ring * mix(1.0, 0.45, dis)
            res = Finish.over(res, vec4(col * ra, ra))
            let lip = Finish.ring_out(d, 0.0, px, px) * smoothstep(0.2, 0.9, n.y) * (1.0 - dis)
            res = Finish.over(res, vec4(vec3(1.0, 1.0, 1.0) * lip, lip))
        }
        res = po_frame_over(res, d, px, focus * live, a, hh)
    } else {
        if kind > 2.5 && kind < 3.5 {
            res = po_sunk(p, lo, hi, r, px, vec3(0.955, 0.958, 0.967), hover, down, dis, 0.55)
            let d = Material.sd_box(p, c, h, r)
            res = po_frame_over(res, d, px, focus * live, Finish.cover(d, px), hh)
        } else {
            var lift = 1.0
            if kind < 0.5 || (kind > 3.5 && kind < 4.5) {
                lift = 0.0
            }
            var tone = 0.0
            if kind > 3.5 && kind < 4.5 {
                tone = 1.0
            }
            var sp = spot
            if kind > 1.5 && kind < 2.5 {
                // The primary: lit from under at rest, brighter in the hand.
                sp = mix(0.95 + 0.05 * hover, 0.9, down) * (1.0 - step(0.5, dis))
            }
            res = po_cap(p, lo, hi, r, px, hover, down, dis, focus, lift, tone, sp)
        }
    }
    if loading > 0.001 {
        let rad = max(min(h.x, h.y) - 5.5, 2.0)
        res = po_spinner(res, p, c, rad, anim, loading, 1.5, ink)
    }
    return res * po_fade(pos, size, m)
}

mod.widgets.ButtonFlat.draw_bg.pixel = fn() {
    return po_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 0.0, 0.0)
}
mod.widgets.Button.draw_bg.pixel = fn() {
    return po_button(self.pos, self.rect_size, self.rect_pos, self.draw_pass.dpi_factor, self.hover, self.down, self.disabled, self.focus, self.loading, self.anim_time, 1.0, 0.0)

mod.theme = mod.themes.light

// Minimal instrument hardware: a pale case, hairlines, few colours.
// A starter: a sober palette on the light base, plain faces with one
// hairline edge, so every control reads before the real look is written.
// Every state of a family is spelled out, because the base derived its
// states once, from its own colours.
mod.theme.color_bg_app = #e8e6e1
mod.theme.color_fg_app = #e8e6e1
mod.theme.color_bg_container = #e8e6e1
mod.theme.color_surface_container_lowest = #dcd9d2

// Raised faces: buttons, handles, tabs.
mod.theme.color_outset = #f2f0eb
mod.theme.color_outset_1 = #f2f0eb
mod.theme.color_outset_2 = #f2f0eb
mod.theme.color_outset_hover = #f7f5f1
mod.theme.color_outset_1_hover = #f7f5f1
mod.theme.color_outset_2_hover = #f7f5f1
mod.theme.color_outset_down = #dedbd4
mod.theme.color_outset_1_down = #dedbd4
mod.theme.color_outset_2_down = #dedbd4
mod.theme.color_outset_disabled = #e8e6e1
mod.theme.color_outset_1_disabled = #e8e6e1
mod.theme.color_outset_2_disabled = #e8e6e1

// Wells: fields, tracks, boxes.
mod.theme.color_inset = #dcd9d2
mod.theme.color_inset_1 = #dcd9d2
mod.theme.color_inset_2 = #dcd9d2
mod.theme.color_inset_hover = #d6d3cb
mod.theme.color_inset_1_hover = #d6d3cb
mod.theme.color_inset_2_hover = #d6d3cb
mod.theme.color_inset_focus = #d6d3cb
mod.theme.color_inset_1_focus = #d6d3cb
mod.theme.color_inset_2_focus = #d6d3cb
mod.theme.color_inset_active = #d6d3cb
mod.theme.color_inset_1_active = #d6d3cb
mod.theme.color_inset_2_active = #d6d3cb
mod.theme.color_inset_down = #d6d3cb
mod.theme.color_inset_1_down = #d6d3cb
mod.theme.color_inset_2_down = #d6d3cb
mod.theme.color_inset_drag = #dcd9d2
mod.theme.color_inset_1_drag = #dcd9d2
mod.theme.color_inset_2_drag = #dcd9d2
mod.theme.color_inset_empty = #dcd9d2
mod.theme.color_inset_1_empty = #dcd9d2
mod.theme.color_inset_2_empty = #dcd9d2
mod.theme.color_inset_disabled = #e8e6e1
mod.theme.color_inset_1_disabled = #e8e6e1
mod.theme.color_inset_2_disabled = #e8e6e1

// One hairline edge on every face and well.
mod.theme.color_bevel = #a6a29a
mod.theme.color_bevel_inset_1 = #a6a29a
mod.theme.color_bevel_inset_2 = #a6a29a
mod.theme.color_bevel_outset_1 = #a6a29a
mod.theme.color_bevel_outset_2 = #a6a29a
mod.theme.beveling = 0.5

mod.theme.color_text = #232323
mod.theme.color_label = #232323
mod.theme.color_label_inner = #232323
mod.theme.color_label_outer = #232323
mod.theme.color_icon = #232323
// The accent seed: the primary, secondary and tertiary families are grown
// from `color_ctrl_selected`.
mod.theme.color_ctrl_selected = #c2410c
mod.theme.color_focus = #c2410c
mod.theme.color_ctrl_active = #c2410c
mod.theme.color_val = #c2410c

mod.theme.color_terminal_bg = #232323
mod.theme.color_terminal_text = #e8e6e1

mod.theme.space_factor = 6.0
mod.theme.space_1 = 3.0
mod.theme.space_2 = 6.0
mod.theme.space_3 = 9.0
mod.theme.mspace_1 = mod.turtle.Inset{top: 3.0 right: 3.0 bottom: 3.0 left: 3.0}
mod.theme.corner_radius = 1.5
mod.theme.container_corner_radius = 3.0
true
